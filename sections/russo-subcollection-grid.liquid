<div class="subcollection-tiles" id="subcollection-tiles-{{ section.id }}" style="--subcollection-tiles-gap: {{ section.settings.gap | default: 24 }}px">
  {% if section.settings.menu != blank %}
    {% assign nav = linklists[section.settings.menu] | default: nil %}
    {% if nav and nav.links_count > 0 %}
      <div class="subcollection-tiles__grid" aria-label="{{ 'collections.subcollections.aria_label' | t }}">
        {% for link in nav.links %}
          {% if link.type == 'collection_link' and link.object != blank %}
            {% assign sub_collection = link.object %}
            <article class="subcollection-tile">
              <a href="{{ sub_collection.url }}" class="subcollection-tile__link">
                <div class="subcollection-tile__image-wrapper">
                  {% if sub_collection.featured_image %}
                    {{ sub_collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', class: 'subcollection-tile__image' }}
                  {% else %}
                    {{ 'collection-1' | placeholder_svg_tag: 'subcollection-tile__placeholder' }}
                  {% endif %}
                </div>
                <div class="subcollection-tile__content">
                  <h3 class="subcollection-tile__title">{{ sub_collection.title }}</h3>
                  {% if section.settings.show_product_count %}
                    <p class="subcollection-tile__count">
                      {{ 'collections.subcollections.product_count' | t: count: sub_collection.products_count }}
                    </p>
                  {% endif %}
                </div>
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p class="subcollection-tiles__empty">{{ 'collections.subcollections.empty_menu' | t }}</p>
    {% endif %}
  {% else %}
    <p class="subcollection-tiles__empty">{{ 'collections.subcollections.no_menu' | t }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .subcollection-tiles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--subcollection-tiles-gap);
  }

  .subcollection-tile {
    border-radius: 0.75rem;
    overflow: hidden;
    background: rgb(255 255 255 / 0.9);
  }

  .subcollection-tile__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .subcollection-tile__image-wrapper {
    position: relative;
    padding-top: 70%;
    overflow: hidden;
  }

  .subcollection-tile__image,
  .subcollection-tile__placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .subcollection-tile__content {
    padding: 1rem 1.25rem 1.25rem;
  }

  .subcollection-tile__title {
    font-size: 1rem;
    margin: 0 0 0.25rem;
  }

  .subcollection-tile__count {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:collections.subcollections.section_name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:collections.subcollections.menu_label",
      "info": "t:collections.subcollections.menu_info"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "t:collections.subcollections.gap_label",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "t:collections.subcollections.show_product_count_label",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:Subcollection tiles",
      "category": "t:sections.categories.collection"
    }
  ]
}
{% endschema %}