h: 1024px) 1280px, (min-width: 640px) 768px, calc(100vw/3)" loading="lazy" data-pf-type="Image3" class="sc-jdUdnB koGfBt rid-fa7e8e00 pf-image-1"/><h3 data-pf-type="Heading" class="sc-iLsJvT kCxqdT rid-7e8e0023 pf-heading-1-h3"><span data-pf-type="Text" class="sc-iQbOXA hQbCed rid-00235b57">Parts &amp; Service</span></h3><p class="sc-jlGhtx jCFvsE rid-235b5713 pf-text-1" data-pf-type="Paragraph"><span data-pf-type="Text" class="sc-iQbOXA hQbCed rid-57131a6b">Every piece of equipment needs attention eventually. Whether it's a simple spark plug or a full engine repair, we've got the parts and the people to handle it. With thousands of OEM and aftermarket parts in stock and a service department that knows what they're doing, we treat every job like it matters because to you, it does. Stop in and talk with our team; we'll get you what you need and get you back to work.</span></p></div></div></div></div></div></div></div></div></div></div></div><div data-section-id="pf-7a09" data-pf-type="Section" class="sc-jwZJYP bRHccV pf-135_ pf-color-scheme-1"><div style="--cw:1170px" class="sc-boZfnm jvQCDP"><div class="sc-jaXxZZ iGFmwC pf-136_ pf-r pf-r-eh" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:6;--c-md:6;--c-lg:4"><div data-pf-type="Column" class="sc-dUYKzm kWVCJl pf-137_"><h3 data-pf-type="Heading2" class="sc-lbJdeI eAgijX pf-138_ pf-heading-1-h3">Our Footprint</h3><p class="sc-cuHiig kGTzfw pf-140_ pf-text-1" data-pf-type="Paragraph3">Russo Dealerships</p><ul style="--pf-line-spacing-xs:10px;--pf-line-spacing-sm:10px;--pf-line-spacing-md:10px;--pf-line-spacing-lg:10px;--pf-text-indent-xs:0px;--pf-text-indent-sm:0px;--pf-text-indent-md:0px;--pf-text-indent-lg:0px" data-pf-type="List2" class="sc-izQAGL hEywwZ pf-142_"><li data-pf-type="List2.Item2" class="sc-jBeCGk eqIIjI pf-143_">Schiller Park, IL<br></li><li data-pf-type="List2.Item2" class="sc-jBeCGk eqIIjI pf-145_">Naperville, IL<br></li><li data-pf-type="List2.Item2