{%- assign subcollections = collection.metafields.custom.subcollection.value -%}

{%- if subcollections != blank -%}
  <div class="collection-subcollections page-width">
    <div class="collection-subcollections__grid">
      {%- for subcollection in subcollections -%}
        <a href="{{ subcollection.url }}" class="collection-subcollections__item">
          {%- if subcollection.image != blank -%}
            <div class="collection-subcollections__image">
              {{
                subcollection.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  widths: '200, 300, 400, 600',
                  sizes: '(min-width: 990px) 250px, (min-width: 750px) 30vw, 45vw',
                  alt: subcollection.title
              }}
            </div>
          {%- endif -%}

          <div class="collection-subcollections__title">
            {{ subcollection.title | escape }}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection Subcollections",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "This section automatically displays subcollections pulled from the 'custom.subcollection' metafield on the current collection page."
    }
  ],
  "presets": [
    {
      "name": "Collection Subcollections"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .collection-subcollections {
    margin-top: 3rem;
    margin-bottom: 3rem;
  }

  .collection-subcollections__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 3rem;
  }

  .collection-subcollections__item {
    display: block;
    width: 22rem;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }

  .collection-subcollections__image {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
  }

  .collection-subcollections__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-subcollections__title {
    margin-top: 1.5rem;
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .collection-subcollections__item:hover .collection-subcollections__title {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  @media screen and (max-width: 749px) {
    .collection-subcollections__grid {
      justify-content: center;
      gap: 1.5rem;
    }
    .collection-subcollections__item {
      width: calc(50% - 1rem);
    }
  }
{% endstylesheet %}
