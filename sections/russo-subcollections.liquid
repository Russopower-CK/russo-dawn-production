{% comment %}
  Russo Subcollections
  Custom collection carousel for Dawn 16.0.0
{% endcomment %}

{%- style -%}
  #RussoSubcollections-{{ section.id }} {
    --russo-title-color: {{ section.settings.title_color }};
    --russo-arrow-color: {{ section.settings.arrow_color }};
    --russo-arrow-background: {{ section.settings.arrow_background }};
    --russo-image-background: {{ section.settings.image_background }};
    --russo-image-size: {{ section.settings.image_size }}px;
    --russo-gap: {{ section.settings.gap }}px;

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__heading {
    margin-top: 0;
    margin-bottom: 2rem;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__wrapper {
    position: relative;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__viewport {
    overflow: hidden;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__track {
    display: flex;
    align-items: flex-start;
    gap: var(--russo-gap);

    width: 100%;
    margin: 0;
    padding: 0;

    overflow-x: auto;
    overflow-y: hidden;

    list-style: none;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__track::-webkit-scrollbar {
    display: none;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__item {
    flex: 0 0 var(--russo-image-size);
    width: var(--russo-image-size);
    min-width: 0;
    scroll-snap-align: start;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__image-wrapper {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    width: var(--russo-image-size);
    height: var(--russo-image-size);
    margin: 0 auto;

    overflow: hidden;
    border-radius: 50%;
    background: var(--russo-image-background);
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
    transition: transform 0.25s ease;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100%;

    background: var(--russo-image-background);
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__placeholder .placeholder-svg {
    width: 100%;
    height: 100%;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__title {
    display: block;
    margin-top: 1.1rem;

    color: var(--russo-title-color);
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    line-height: 1.25;
    text-align: center;
    overflow-wrap: break-word;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__count {
    display: block;
    margin-top: 0.4rem;

    color: rgba(var(--color-foreground), 0.65);
    font-size: 1.2rem;
    line-height: 1.3;
    text-align: center;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__link:hover .russo-subcollections__title {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__link:hover .russo-subcollections__image {
    transform: scale(1.03);
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__link:focus-visible {
    outline: 0.2rem solid rgba(var(--color-foreground), 0.75);
    outline-offset: 0.4rem;
    border-radius: 0.4rem;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__arrow {
    position: absolute;
    top: calc(var(--russo-image-size) / 2);
    z-index: 3;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 4.6rem;
    height: 4.6rem;
    margin: 0;
    padding: 0;

    border: 0.1rem solid rgba(0, 0, 0, 0.08);
    border-radius: 50%;

    background: var(--russo-arrow-background);
    color: var(--russo-arrow-color);

    box-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.12);

    cursor: pointer;
    transform: translateY(-50%);

    transition:
      opacity 0.2s ease,
      visibility 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__arrow:hover {
    box-shadow: 0 0.3rem 1rem rgba(0, 0, 0, 0.18);
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__arrow:focus-visible {
    outline: 0.2rem solid currentColor;
    outline-offset: 0.3rem;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__arrow--previous {
    left: -2.3rem;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__arrow--next {
    right: -2.3rem;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__arrow[disabled] {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__arrow svg {
    display: block;
    width: 1.8rem;
    height: 1.8rem;
  }

  #RussoSubcollections-{{ section.id }} .russo-subcollections__empty {
    width: 100%;
    margin: 0;
    padding: 2rem;

    color: rgba(var(--color-foreground), 0.7);
    text-align: center;

    border: 0.1rem dashed rgba(var(--color-foreground), 0.25);
    border-radius: 0.6rem;
  }

  @media screen and (max-width: 1100px) {
    #RussoSubcollections-{{ section.id }} .russo-subcollections__arrow--previous {
      left: 0.8rem;
    }

    #RussoSubcollections-{{ section.id }} .russo-subcollections__arrow--next {
      right: 0.8rem;
    }
  }

  @media screen and (max-width: 989px) {
    #RussoSubcollections-{{ section.id }} {
      --russo-image-size: {{ section.settings.image_size_mobile }}px;
      --russo-gap: {{ section.settings.gap_mobile }}px;
    }

    #RussoSubcollections-{{ section.id }} .russo-subcollections__viewport {
      overflow: visible;
    }

    #RussoSubcollections-{{ section.id }} .russo-subcollections__track {
      margin-right: -1.5rem;
      padding-right: 1.5rem;
      scroll-padding-left: 0;
      -webkit-overflow-scrolling: touch;
    }

    #RussoSubcollections-{{ section.id }} .russo-subcollections__arrow {
      display: none;
    }

    #RussoSubcollections-{{ section.id }} .russo-subcollections__title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    #RussoSubcollections-{{ section.id }} .russo-subcollections__track {
      scroll-behavior: auto;
    }

    #RussoSubcollections-{{ section.id }} .russo-subcollections__image {
      transition: none;
    }
  }
{%- endstyle -%}

<div
  id="RussoSubcollections-{{ section.id }}"
  class="russo-subcollections"
  data-russo-subcollections
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="russo-subcollections__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="russo-subcollections__wrapper">
      {%- assign nav_links = nil -%}

      {%- if section.settings.menu != blank -%}
        {%- assign nav = linklists[section.settings.menu] -%}
        {%- assign nav_links = nav.links -%}

        {%- if nav_links.size > 0 and collection != blank -%}
          {%- for parent_link in nav_links -%}
            {%- if parent_link.type == 'collection_link'
              and parent_link.object
              and parent_link.object.handle == collection.handle
            -%}
              {%- if parent_link.links.size > 0 -%}
                {%- assign nav_links = parent_link.links -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- elsif collection != blank -%}
        {%- assign auto_nav = linklists[collection.handle] -%}
        {%- if auto_nav and auto_nav.links.size > 0 -%}
          {%- assign nav_links = auto_nav.links -%}
        {%- endif -%}
      {%- endif -%}

      {%- if nav_links and nav_links.size > 0 -%}
        <div class="russo-subcollections__viewport">
          <ul
            id="RussoSubcollectionsTrack-{{ section.id }}"
            class="russo-subcollections__track"
            data-russo-track
            role="list"
          >
            {%- for link in nav_links -%}
              {%- liquid
                assign subcollection = blank
                assign item_image = blank

                assign item_title = link.title
                assign item_url = link.url

                if link.type == 'collection_link' and link.object != blank
                  assign subcollection = link.object

                  if subcollection.image != blank
                    assign item_image = subcollection.image
                  elsif subcollection.all_products_count > 0
                    assign first_product = subcollection.products | first
                    if first_product != nil and first_product.featured_image != blank
                      assign item_image = first_product.featured_image
                    endif
                  endif
                endif
              -%}

              <li class="russo-subcollections__item">
                <a
                  href="{{ item_url }}"
                  class="russo-subcollections__link"
                >
                  <div class="russo-subcollections__image-wrapper">
                    {%- if item_image != blank -%}
                      {{
                        item_image
                        | image_url: width: 600
                        | image_tag:
                          class: 'russo-subcollections__image',
                          loading: 'lazy',
                          widths: '120, 160, 200, 240, 320, 400, 500, 600',
                          sizes: '(max-width: 989px) 120px, 165px',
                          alt: item_title
                      }}
                    {%- else -%}
                      <div class="russo-subcollections__placeholder">
                        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>

                  <span class="russo-subcollections__title">
                    {{ item_title | escape }}
                  </span>

                  {%- if section.settings.show_product_count and subcollection != blank -%}
                    <span class="russo-subcollections__count">
                      {{ subcollection.all_products_count }}
                      {%- if subcollection.all_products_count == 1 -%}
                        &nbsp;product
                      {%- else -%}
                        &nbsp;products
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- if section.settings.show_arrows -%}
          <button
            class="russo-subcollections__arrow russo-subcollections__arrow--previous"
            type="button"
            aria-label="View previous subcollections"
            aria-controls="RussoSubcollectionsTrack-{{ section.id }}"
            data-russo-previous
            disabled
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M15 5L8 12L15 19"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </button>

          <button
            class="russo-subcollections__arrow russo-subcollections__arrow--next"
            type="button"
            aria-label="View next subcollections"
            aria-controls="RussoSubcollectionsTrack-{{ section.id }}"
            data-russo-next
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M9 5L16 12L9 19"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </button>
        {%- endif -%}

      {%- elsif section.blocks.size > 0 -%}
        {%- if section.settings.show_arrows -%}
          <button
            class="russo-subcollections__arrow russo-subcollections__arrow--previous"
            type="button"
            aria-label="View previous subcollections"
            aria-controls="RussoSubcollectionsTrack-{{ section.id }}"
            data-russo-previous
            disabled
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M15 5L8 12L15 19"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </button>
        {%- endif -%}

        <div class="russo-subcollections__viewport">
          <ul
            id="RussoSubcollectionsTrack-{{ section.id }}"
            class="russo-subcollections__track"
            data-russo-track
            role="list"
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign subcollection = block.settings.collection
                assign custom_image = block.settings.image

                if block.settings.title != blank
                  assign item_title = block.settings.title
                elsif subcollection != blank
                  assign item_title = subcollection.title
                else
                  assign item_title = 'Collection'
                endif

                if custom_image != blank
                  assign item_image = custom_image
                elsif subcollection != blank and subcollection.image != blank
                  assign item_image = subcollection.image
                elsif subcollection != blank and subcollection.all_products_count > 0
                  assign first_product = subcollection.products | first
                  if first_product != nil and first_product.featured_image != blank
                    assign item_image = first_product.featured_image
                  endif
                else
                  assign item_image = blank
                endif

                if subcollection != blank
                  assign item_url = subcollection.url
                else
                  assign item_url = '#'
                endif
              -%}

              <li
                class="russo-subcollections__item"
                {{ block.shopify_attributes }}
              >
                <a
                  href="{{ item_url }}"
                  class="russo-subcollections__link"
                >
                  <div class="russo-subcollections__image-wrapper">
                    {%- if item_image != blank -%}
                      {{
                        item_image
                        | image_url: width: 600
                        | image_tag:
                          class: 'russo-subcollections__image',
                          loading: 'lazy',
                          widths: '120, 160, 200, 240, 320, 400, 500, 600',
                          sizes: '(max-width: 989px) 120px, 165px',
                          alt: item_title
                      }}
                    {%- else -%}
                      <div class="russo-subcollections__placeholder">
                        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>

                  <span class="russo-subcollections__title">
                    {{ item_title | escape }}
                  </span>

                  {%- if section.settings.show_product_count and subcollection != blank -%}
                    <span class="russo-subcollections__count">
                      {{ subcollection.all_products_count }}
                      {%- if subcollection.all_products_count == 1 -%}
                        &nbsp;product
                      {%- else -%}
                        &nbsp;products
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- if section.settings.show_arrows -%}
          <button
            class="russo-subcollections__arrow russo-subcollections__arrow--next"
            type="button"
            aria-label="View next subcollections"
            aria-controls="RussoSubcollectionsTrack-{{ section.id }}"
            data-russo-next
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M9 5L16 12L9 19"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </button>
        {%- endif -%}
      {%- else -%}
        <p class="russo-subcollections__empty">
          Add a menu or subcollection blocks to display collection links.
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (() => {
    const sectionId = 'RussoSubcollections-{{ section.id }}';
    const section = document.getElementById(sectionId);

    if (!section || section.dataset.russoInitialized === 'true') {
      return;
    }

    section.dataset.russoInitialized = 'true';

    const track = section.querySelector('[data-russo-track]');
    const previousButton = section.querySelector('[data-russo-previous]');
    const nextButton = section.querySelector('[data-russo-next]');

    if (!track) {
      return;
    }

    const getScrollAmount = () => {
      const firstItem = track.querySelector('.russo-subcollections__item');

      if (!firstItem) {
        return track.clientWidth * 0.8;
      }

      const trackStyles = window.getComputedStyle(track);
      const gap = parseFloat(trackStyles.columnGap || trackStyles.gap) || 0;
      const itemWidth = firstItem.getBoundingClientRect().width;

      return (itemWidth + gap) * 3;
    };

    const updateArrowState = () => {
      if (!previousButton || !nextButton) {
        return;
      }

      const maximumScroll = Math.max(
        0,
        track.scrollWidth - track.clientWidth
      );

      const tolerance = 4;

      if (maximumScroll <= tolerance) {
        previousButton.disabled = true;
        nextButton.disabled = true;
        return;
      }

      previousButton.disabled = track.scrollLeft <= tolerance;
      nextButton.disabled =
        track.scrollLeft >= maximumScroll - tolerance;
    };

    const scrollTrack = (direction) => {
      track.scrollBy({
        left: getScrollAmount() * direction,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ? 'auto'
          : 'smooth'
      });
    };

    if (previousButton) {
      previousButton.addEventListener('click', () => {
        scrollTrack(-1);
      });
    }

    if (nextButton) {
      nextButton.addEventListener('click', () => {
        scrollTrack(1);
      });
    }

    track.addEventListener('scroll', updateArrowState, {
      passive: true
    });

    window.addEventListener('resize', updateArrowState);

    if ('ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => {
        updateArrowState();
      });

      resizeObserver.observe(track);
    }

    requestAnimationFrame(updateArrowState);
  })();
</script>

{% schema %}
{
  "name": "Russo subcollections",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h2"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Subcollections menu",
      "info": "Optional. If set, this menu is used. If left blank, a menu with handle matching the collection handle will be used when available."
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product counts",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show desktop arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Crop to circle"
        },
        {
          "value": "contain",
          "label": "Fit inside circle"
        }
      ],
      "default": "contain"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 100,
      "max": 240,
      "step": 5,
      "unit": "px",
      "label": "Desktop image size",
      "default": 165
    },
    {
      "type": "range",
      "id": "image_size_mobile",
      "min": 80,
      "max": 180,
      "step": 5,
      "unit": "px",
      "label": "Mobile image size",
      "default": 120
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Desktop gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile gap",
      "default": 18
    },
    {
      "type": "header",
      "content": "Titles"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#e21b23"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Desktop title size",
      "default": 15
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Mobile title size",
      "default": 14
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Arrows"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "arrow_background",
      "label": "Arrow background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Subcollection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
