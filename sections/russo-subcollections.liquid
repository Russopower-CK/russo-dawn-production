{%- for block in section.blocks -%}
  {%- liquid
    assign subcollection = block.settings.collection
    assign custom_image = block.settings.image

    if block.settings.title != blank
      assign item_title = block.settings.title
    elsif subcollection != blank
      assign item_title = subcollection.title
    else
      assign item_title = 'Collection'
    endif

    if custom_image != blank
      assign item_image = custom_image
    elsif subcollection != blank and subcollection.image != blank
      assign item_image = subcollection.image
    else
      assign item_image = blank
    endif

    if subcollection != blank
      assign item_url = subcollection.url
    else
      assign item_url = '#'
    endif
  -%}

  <li
    class="russo-subcollections__item"
    {{ block.shopify_attributes }}
  >
    <a
      href="{{ item_url }}"
      class="russo-subcollections__link"
    >
      <div class="russo-subcollections__image-wrapper">
        {%- if item_image != blank -%}
          {{
            item_image
            | image_url: width: 600
            | image_tag:
              class: 'russo-subcollections__image',
              loading: 'lazy',
              widths: '120, 160, 200, 240, 320, 400, 500, 600',
              sizes: '(max-width: 989px) 120px, 165px',
              alt: item_title
          }}
        {%- else -%}
          <div class="russo-subcollections__placeholder">
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <span class="russo-subcollections__title">
        {{ item_title | escape }}
      </span>

      {%- if section.settings.show_product_count and subcollection != blank -%}
        <span class="russo-subcollections__count">
          {{ subcollection.all_products_count }}
          {%- if subcollection.all_products_count == 1 -%}
            &nbsp;product
          {%- else -%}
            &nbsp;products
          {%- endif -%}
        </span>
      {%- endif -%}
    </a>
  </li>
{%- endfor -%}