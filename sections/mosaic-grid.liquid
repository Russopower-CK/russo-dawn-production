{%- liquid
  assign collapse = section.settings.collapse_on_mobile
-%}

<style>
  #Mosaic--{{ section.id }} {
    --mosaic-cols: {{ section.settings.columns }};
    --mosaic-row: {{ section.settings.row_height }}px;
    --mosaic-gap: {{ section.settings.gap }}px;
    --mosaic-radius: {{ section.settings.corner_radius }}px;
    --mosaic-padding: {{ section.settings.content_padding }}px;
    --mosaic-panel-color: {{ section.settings.mobile_panel_color }};
    --mosaic-mobile-height: {{ section.settings.mobile_min_height }}px;
    --mosaic-heading-size: {{ section.settings.heading_size }}px;
    --mosaic-body-size: {{ section.settings.body_size }}px;
  }

  #Mosaic--{{ section.id }} .mosaic {
    display: grid;
    grid-template-columns: repeat(var(--mosaic-cols), 1fr);
    grid-auto-rows: minmax(var(--mosaic-row), auto);
    gap: var(--mosaic-gap);
  }

  #Mosaic--{{ section.id }} .mosaic-section__title { margin: 0 0 1.5rem; }

  #Mosaic--{{ section.id }} .mosaic__item {
    position: relative;
    overflow: hidden;
    grid-column: span var(--span-x, 1);
    grid-row: span var(--span-y, 1);
    border-radius: var(--mosaic-radius);
    display: flex;
    flex-direction: column;
    justify-content: {{ section.settings.content_position }};
    min-width: 0;
  }

  #Mosaic--{{ section.id }} .mosaic__details {
    display: flex;
    flex-direction: column;
    justify-content: inherit;
    flex: 1 1 auto;
    min-height: 0;
  }

  #Mosaic--{{ section.id }} .mosaic__media,
  #Mosaic--{{ section.id }} .mosaic__media img,
  #Mosaic--{{ section.id }} .mosaic__placeholder svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Overlay: flat wash or a gradient scrim, driven per tile. */
  #Mosaic--{{ section.id }} .mosaic__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tile-overlay, none);
    opacity: var(--tile-overlay-opacity, 0);
  }

  #Mosaic--{{ section.id }} .mosaic__content {
    position: relative;
    z-index: 1;
    padding: var(--mosaic-padding);
    max-width: {{ section.settings.text_max_width }}ch;
    min-width: 0;
    overflow-wrap: anywhere;
    text-shadow: var(--tile-shadow, none);
  }

  #Mosaic--{{ section.id }} .mosaic__content,
  #Mosaic--{{ section.id }} .mosaic__summary { color: var(--tile-text, {{ section.settings.text_color }}); }

  #Mosaic--{{ section.id }} .mosaic__heading,
  #Mosaic--{{ section.id }} .mosaic__text,
  #Mosaic--{{ section.id }} .mosaic__text p,
  #Mosaic--{{ section.id }} .mosaic__text li,
  #Mosaic--{{ section.id }} .mosaic__text strong,
  #Mosaic--{{ section.id }} .mosaic__text em,
  #Mosaic--{{ section.id }} .mosaic__text a { color: inherit; }

  #Mosaic--{{ section.id }} .mosaic__heading {
    margin: 0 0 0.6rem;
    text-transform: uppercase;
    line-height: 1.15;
    font-size: clamp(16px, calc(var(--mosaic-heading-size) * 0.6), var(--mosaic-heading-size));
  }

  #Mosaic--{{ section.id }} .mosaic__text {
    margin: 0 0 1.2rem;
    font-size: clamp(13px, calc(var(--mosaic-body-size) * 0.85), var(--mosaic-body-size));
    font-weight: {{ section.settings.body_weight }};
    line-height: 1.45;
  }
  #Mosaic--{{ section.id }} .mosaic__text > *:last-child { margin-bottom: 0; }

  #Mosaic--{{ section.id }} .mosaic__button {
    display: inline-block;
    text-decoration: none;
    padding: 0.7em 1.4em;
    font-size: clamp(12px, calc(var(--mosaic-body-size) * 0.85), var(--mosaic-body-size));
    background: var(--tile-btn-bg, {{ section.settings.button_background }});
    color: var(--tile-btn-text, {{ section.settings.button_text_color }});
    border-radius: {{ section.settings.button_radius }}px;
    text-shadow: none;
  }

  #Mosaic--{{ section.id }} .mosaic__summary { display: none; }

  @media screen and (max-width: 749px) {
    #Mosaic--{{ section.id }} .mosaic {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    #Mosaic--{{ section.id }} .mosaic__item {
      grid-column: auto;
      grid-row: auto;
      min-height: var(--mosaic-mobile-height);
    }
    #Mosaic--{{ section.id }} .mosaic__content { max-width: none; }

    {%- if collapse -%}
      #Mosaic--{{ section.id }} .mosaic__item { min-height: 0; }
      #Mosaic--{{ section.id }} .mosaic__media {
        position: relative;
        display: block;
        height: var(--mosaic-mobile-height);
      }
      #Mosaic--{{ section.id }} .mosaic__summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        cursor: pointer;
        list-style: none;
        position: relative;
        z-index: 1;
        padding: 1rem var(--mosaic-padding);
        background: var(--mosaic-panel-color);
      }
      #Mosaic--{{ section.id }} .mosaic__summary::-webkit-details-marker { display: none; }
      #Mosaic--{{ section.id }} .mosaic__summary .mosaic__heading { margin: 0; }
      #Mosaic--{{ section.id }} .mosaic__icon { flex: 0 0 auto; transition: transform .2s ease; }
      #Mosaic--{{ section.id }} details[open] .mosaic__icon { transform: rotate(180deg); }
      #Mosaic--{{ section.id }} .mosaic__content {
        background: var(--mosaic-panel-color);
        padding-top: 0;
        /* panel already gives contrast on mobile */
        text-shadow: none;
      }
      #Mosaic--{{ section.id }} .mosaic__content .mosaic__heading { display: none; }
    {%- endif -%}
  }

  @media (prefers-reduced-motion: reduce) {
    #Mosaic--{{ section.id }} .mosaic__icon { transition: none; }
  }
</style>

<div id="Mosaic--{{ section.id }}" class="mosaic-section">
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="mosaic-section__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="mosaic">
      {%- for block in section.blocks -%}
        {%- liquid
          case block.settings.size
            when 'large'
              assign span_x = 2
              assign span_y = 2
            when 'wide'
              assign span_x = 2
              assign span_y = 1
            when 'tall'
              assign span_x = 1
              assign span_y = 2
            else
              assign span_x = 1
              assign span_y = 1
          endcase

          assign oc = block.settings.overlay_color

          case block.settings.overlay_style
            when 'solid'
              assign overlay_bg = oc
            when 'gradient_bottom'
              assign overlay_bg = 'linear-gradient(to top, ' | append: oc | append: ' 0%, ' | append: oc | append: ' 30%, transparent 85%)'
            when 'gradient_top'
              assign overlay_bg = 'linear-gradient(to bottom, ' | append: oc | append: ' 0%, ' | append: oc | append: ' 30%, transparent 85%)'
            when 'gradient_left'
              assign overlay_bg = 'linear-gradient(to right, ' | append: oc | append: ' 0%, ' | append: oc | append: ' 30%, transparent 85%)'
            else
              assign overlay_bg = 'none'
          endcase

          assign tile_vars = '--span-x: ' | append: span_x | append: '; --span-y: ' | append: span_y | append: ';'
          assign tile_vars = tile_vars | append: ' --tile-overlay: ' | append: overlay_bg | append: ';'
          assign tile_opacity = block.settings.overlay_opacity | divided_by: 100.0
          assign tile_vars = tile_vars | append: ' --tile-overlay-opacity: ' | append: tile_opacity | append: ';'

          if block.settings.text_shadow
            assign tile_vars = tile_vars | append: ' --tile-shadow: 0 1px 3px rgba(0,0,0,.55), 0 2px 12px rgba(0,0,0,.35);'
          endif
          if block.settings.text_color != blank
            assign tile_vars = tile_vars | append: ' --tile-text: ' | append: block.settings.text_color | append: ';'
          endif
          if block.settings.button_background != blank
            assign tile_vars = tile_vars | append: ' --tile-btn-bg: ' | append: block.settings.button_background | append: ';'
          endif
          if block.settings.button_text_color != blank
            assign tile_vars = tile_vars | append: ' --tile-btn-text: ' | append: block.settings.button_text_color | append: ';'
          endif
        -%}

        {%- capture media -%}
          <div class="mosaic__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag:
                 loading: 'lazy',
                 sizes: '(min-width: 750px) 66vw, 100vw',
                 widths: '400,600,800,1200,1600' }}
            {%- else -%}
              <span class="mosaic__placeholder">
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </span>
            {%- endif -%}
          </div>
        {%- endcapture -%}

        {%- capture body -%}
          <div class="mosaic__content">
            {%- if block.settings.heading != blank -%}
              <h3 class="mosaic__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="mosaic__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="mosaic__button" {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
                {{ block.settings.button_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endcapture -%}

        <div class="mosaic__item" style="{{ tile_vars }}" {{ block.shopify_attributes }}>
          {%- if collapse -%}
            <details
              class="mosaic__details"
              {% if block.settings.open_by_default %}
                open data-keep-open="true"
              {% endif %}
            >
              <summary class="mosaic__summary">
                <h3 class="mosaic__heading">{{ block.settings.heading | default: 'Learn more' }}</h3>
                <span class="mosaic__icon" aria-hidden="true">
                  <svg width="16" height="10" viewBox="0 0 16 10" fill="none">
                    <path d="M1 1l7 7 7-7" stroke="currentColor" stroke-width="2"/>
                  </svg>
                </span>
              </summary>
              {{ media }}
              {{ body }}
            </details>
          {%- else -%}
            {{ media }}
            {{ body }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('Mosaic--{{ section.id }}');
    if (!root) return;
    var mq = window.matchMedia('(min-width: 750px)');
    function sync() {
      root.querySelectorAll('details.mosaic__details').forEach(function (d) {
        if (mq.matches) {
          d.setAttribute('open', '');
        } else if (!d.dataset.keepOpen) {
          d.removeAttribute('open');
        }
      });
    }
    sync();
    mq.addEventListener('change', sync);
  })();
</script>

{% schema %}
{
  "name": "Russo Mosaic grid",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Section heading" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "default": 3, "label": "Desktop columns" },
    {
      "type": "range",
      "id": "row_height",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 280,
      "label": "Minimum row height"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8,
      "label": "Gap between blocks"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "Corner radius"
    },
    { "type": "header", "content": "Text" },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28,
      "label": "Content padding"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 26,
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 15,
      "label": "Body text size"
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Body text weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "text_max_width",
      "min": 20,
      "max": 70,
      "step": 2,
      "unit": "ch",
      "default": 42,
      "label": "Text line length"
    },
    { "type": "color", "id": "text_color", "default": "#ffffff", "label": "Text color" },
    { "type": "header", "content": "Buttons" },
    { "type": "color", "id": "button_background", "default": "#c8102e", "label": "Button background" },
    { "type": "color", "id": "button_text_color", "default": "#ffffff", "label": "Button text" },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "Button corner radius"
    },
    { "type": "header", "content": "Mobile" },
    { "type": "checkbox", "id": "collapse_on_mobile", "default": true, "label": "Collapse blocks on mobile" },
    { "type": "color", "id": "mobile_panel_color", "default": "#1a1a1a", "label": "Mobile panel background" },
    {
      "type": "range",
      "id": "mobile_min_height",
      "min": 140,
      "max": 480,
      "step": 20,
      "unit": "px",
      "default": 240,
      "label": "Mobile image height"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Tile size",
          "options": [
            { "value": "large", "label": "Large (2x2)" },
            { "value": "wide", "label": "Wide (2x1)" },
            { "value": "tall", "label": "Tall (1x2)" },
            { "value": "small", "label": "Small (1x1)" }
          ],
          "default": "small"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "header", "content": "Overlay" },
        {
          "type": "select",
          "id": "overlay_style",
          "label": "Overlay style",
          "info": "Gradients darken only the edge your text sits on, so the photo stays sharp.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "solid", "label": "Solid wash" },
            { "value": "gradient_top", "label": "Gradient from top" },
            { "value": "gradient_bottom", "label": "Gradient from bottom" },
            { "value": "gradient_left", "label": "Gradient from left" }
          ],
          "default": "gradient_top"
        },
        { "type": "color", "id": "overlay_color", "default": "#000000", "label": "Overlay color" },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 70,
          "label": "Overlay opacity"
        },
        { "type": "checkbox", "id": "text_shadow", "default": true, "label": "Text shadow" },
        { "type": "header", "content": "Color overrides (optional)" },
        { "type": "color", "id": "text_color", "label": "Text color" },
        { "type": "color", "id": "button_background", "label": "Button background" },
        { "type": "color", "id": "button_text_color", "label": "Button text" },
        { "type": "checkbox", "id": "open_by_default", "default": false, "label": "Open by default on mobile" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Russo Mosaic grid",
      "blocks": [
        { "type": "tile", "settings": { "size": "large", "overlay_style": "gradient_top" } },
        { "type": "tile", "settings": { "size": "small", "overlay_style": "gradient_top" } },
        { "type": "tile", "settings": { "size": "small", "overlay_style": "gradient_top" } }
      ]
    }
  ]
}
{% endschema %}
