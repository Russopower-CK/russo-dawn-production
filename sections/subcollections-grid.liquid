{%- liquid
  assign subcollections_menu = section.settings.menu
  assign has_menu_items = false

  if subcollections_menu == blank
    if section.settings.use_collection_handle_menu and collection != blank
      assign subcollections_menu = linklists[collection.handle]
    endif
  endif

  if subcollections_menu != blank
    if subcollections_menu.links.size > 0
      assign has_menu_items = true
    endif
  endif
-%}

<section
  id="SubcollectionsGrid-{{ section.id }}"
  class="subcollections-grid subcollections-grid--{{ section.settings.image_ratio }}"
  style="
    --subcollections-columns-desktop: {{ section.settings.columns_desktop }};
    --subcollections-columns-mobile: {{ section.settings.columns_mobile }};
    --subcollections-column-gap: {{ section.settings.grid_gap }}px;
    --subcollections-mobile-gap: {{ section.settings.mobile_grid_gap }}px;
    --subcollections-row-gap: {{ section.settings.row_gap }}px;
    --subcollections-padding-top: {{ section.settings.padding_top }}px;
    --subcollections-padding-bottom: {{ section.settings.padding_bottom }}px;
    --subcollections-image-radius: {{ section.settings.image_radius }}px;
    --subcollections-label-size: {{ section.settings.label_size }}px;
    --subcollections-label-color: {{ section.settings.label_color }};
    --subcollections-label-spacing: {{ section.settings.label_spacing }}px;
  "
>
  <div class="subcollections-grid__container page-width">
    {% if section.settings.heading != blank or section.settings.text != blank %}
      <div class="subcollections-grid__header">
        {% if section.settings.heading != blank %}
          <h2 class="subcollections-grid__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="subcollections-grid__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if has_menu_items %}
      <div class="subcollections-grid__items">
        {% for link in subcollections_menu.links %}
          {%- liquid
            assign tile_image = blank
            assign tile_alt = link.title
            assign linked_object = link.object

            if linked_object != blank
              if linked_object.image != blank
                assign tile_image = linked_object.image
              elsif linked_object.featured_image != blank
                assign tile_image = linked_object.featured_image
              endif
            endif

            if tile_image != blank and tile_image.alt != blank
              assign tile_alt = tile_image.alt
            endif

            capture image_sizes
              echo '(max-width: 749px) calc((100vw - 4rem) / '
              echo section.settings.columns_mobile
              echo '), calc((100vw - 10rem) / '
              echo section.settings.columns_desktop
              echo ')'
            endcapture
          -%}

          <a
            href="{{ link.url }}"
            class="subcollections-grid__tile"
          >
            <div class="subcollections-grid__media">
              {% if section.settings.show_images and tile_image != blank %}
                {{
                  tile_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'subcollections-grid__image',
                    widths: '240, 360, 480, 600, 750, 900, 1200',
                    sizes: image_sizes,
                    loading: 'lazy',
                    alt: tile_alt
                }}
              {% else %}
                <div class="subcollections-grid__placeholder">
                  <span>{{ link.title | escape }}</span>
                </div>
              {% endif %}
            </div>

            <div class="subcollections-grid__label subcollections-grid__label--{{ section.settings.label_alignment }}">
              <span>{{ link.title | escape }}</span>
            </div>
          </a>
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <div class="subcollections-grid__empty">
        <strong>No menu items found.</strong>

        <span>
          Select a menu in the section settings or create a menu whose handle
          matches the current collection handle.
        </span>
      </div>
    {% endif %}
  </div>
</section>

{% style %}
  #SubcollectionsGrid-{{ section.id }} {
    padding-top: var(--subcollections-padding-top);
    padding-bottom: var(--subcollections-padding-bottom);
  }

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__container {
    margin-right: auto;
    margin-left: auto;
  }

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__header {
    max-width: 72rem;
    margin-bottom: {{ section.settings.heading_spacing }}px;
  }

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.2;
    letter-spacing: normal;
  }

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__text {
    margin-top: 1rem;
  }

  #SubcollectionsGrid-{{ section.id }}
    .subcollections-grid__text
    > :first-child {
    margin-top: 0;
  }

  #SubcollectionsGrid-{{ section.id }}
    .subcollections-grid__text
    > :last-child {
    margin-bottom: 0;
  }

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__items {
    display: grid;
    grid-template-columns:
      repeat(var(--subcollections-columns-desktop), minmax(0, 1fr));
    column-gap: var(--subcollections-column-gap);
    row-gap: var(--subcollections-row-gap);
  }

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__tile {
    display: block;
    min-width: 0;
    color: inherit;
    text-decoration: none;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f3f3f3;
    border-radius: var(--subcollections-image-radius);
  }

  #SubcollectionsGrid-{{ section.id }}.subcollections-grid--square
    .subcollections-grid__media {
    aspect-ratio: 1 / 1;
  }

  #SubcollectionsGrid-{{ section.id }}.subcollections-grid--portrait
    .subcollections-grid__media {
    aspect-ratio: 4 / 5;
  }

  #SubcollectionsGrid-{{ section.id }}.subcollections-grid--landscape
    .subcollections-grid__media {
    aspect-ratio: 4 / 3;
  }

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
    transition: transform 250ms ease;
  }

  {% if section.settings.enable_image_zoom %}
    #SubcollectionsGrid-{{ section.id }}
      .subcollections-grid__tile:hover
      .subcollections-grid__image {
      transform: scale(1.04);
    }
  {% endif %}

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 18rem;
    padding: 1rem;
    color: rgba(var(--color-foreground), 0.55);
    text-align: center;
  }

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__label {
    display: flex;
    align-items: center;
    width: 100%;
    margin-top: var(--subcollections-label-spacing);
    padding: 0;
    color: var(--subcollections-label-color);
    font-size: var(--subcollections-label-size);
    font-weight: {{ section.settings.label_weight }};
    line-height: 1.3;
  }

  #SubcollectionsGrid-{{ section.id }}
    .subcollections-grid__label--left {
    justify-content: flex-start;
    text-align: left;
  }

  #SubcollectionsGrid-{{ section.id }}
    .subcollections-grid__label--center {
    justify-content: center;
    text-align: center;
  }

  #SubcollectionsGrid-{{ section.id }}
    .subcollections-grid__label--right {
    justify-content: flex-end;
    text-align: right;
  }

  #SubcollectionsGrid-{{ section.id }}
    .subcollections-grid__label
    span {
    display: inline-block;
  }

  {% if section.settings.underline_on_hover %}
    #SubcollectionsGrid-{{ section.id }}
      .subcollections-grid__tile:hover
      .subcollections-grid__label
      span {
      text-decoration: underline;
      text-underline-offset: 0.2rem;
    }
  {% endif %}

  #SubcollectionsGrid-{{ section.id }}
    .subcollections-grid__tile:focus-visible {
    outline: 0.2rem solid currentColor;
    outline-offset: 0.4rem;
  }

  #SubcollectionsGrid-{{ section.id }} .subcollections-grid__empty {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2rem;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.25);
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #SubcollectionsGrid-{{ section.id }} .subcollections-grid__header {
      margin-bottom: calc(
        {{ section.settings.heading_spacing }}px * 0.75
      );
    }

    #SubcollectionsGrid-{{ section.id }} .subcollections-grid__heading {
      font-size: calc(
        {{ section.settings.heading_size }}px * 0.8
      );
    }

    #SubcollectionsGrid-{{ section.id }} .subcollections-grid__items {
      grid-template-columns:
        repeat(var(--subcollections-columns-mobile), minmax(0, 1fr));
      column-gap: var(--subcollections-mobile-gap);
      row-gap: var(--subcollections-row-gap);
    }

    #SubcollectionsGrid-{{ section.id }} .subcollections-grid__label {
      font-size: calc(var(--subcollections-label-size) * 0.9);
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    #SubcollectionsGrid-{{ section.id }} .subcollections-grid__image {
      transition: none;
    }

    #SubcollectionsGrid-{{ section.id }}
      .subcollections-grid__tile:hover
      .subcollections-grid__image {
      transform: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Subcollections grid",
  "tag": "section",
  "class": "section-subcollections-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introductory text"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Subcollection menu",
      "info": "Choose a menu containing direct links to collections."
    },
    {
      "type": "checkbox",
      "id": "use_collection_handle_menu",
      "label": "Use menu matching collection handle",
      "default": true,
      "info": "If no menu is selected, use a menu whose handle matches the current collection handle."
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show collection images",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fitting",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Crop to fill"
        },
        {
          "value": "contain",
          "label": "Show complete image"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "center center",
      "options": [
        {
          "value": "left top",
          "label": "Top left"
        },
        {
          "value": "center top",
          "label": "Top center"
        },
        {
          "value": "right top",
          "label": "Top right"
        },
        {
          "value": "left center",
          "label": "Center left"
        },
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Center right"
        },
        {
          "value": "left bottom",
          "label": "Bottom left"
        },
        {
          "value": "center bottom",
          "label": "Bottom center"
        },
        {
          "value": "right bottom",
          "label": "Bottom right"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Zoom image on hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Grid layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Desktop column spacing",
      "min": 0,
      "max": 48,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "label": "Mobile column spacing",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row spacing",
      "min": 12,
      "max": 60,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Category labels"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#d71920"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label font size",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label font weight",
      "default": "700",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "select",
      "id": "label_alignment",
      "label": "Label alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "label_spacing",
      "label": "Space above label",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "underline_on_hover",
      "label": "Underline label on hover",
      "default": false
    },
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size",
      "min": 20,
      "max": 56,
      "step": 2,
      "default": 34,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "default": "700",
      "options": [
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below heading",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Subcollections grid"
    }
  ]
}
{% endschema %}