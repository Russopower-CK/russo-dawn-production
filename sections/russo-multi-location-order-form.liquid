{%- liquid
  assign source_collection = section.settings.source_collection
  assign locations_count = 0
  assign use_dropdown_input = false
  assign use_location_rows_input = false
  assign first_location = blank
  assign use_location_freight_charge = section.settings.enable_location_freight_charge
  assign location_freight_metafield_path = section.settings.location_freight_metafield | strip
  assign location_freight_metafield_parts = location_freight_metafield_path | split: '.'
  assign location_freight_metafield_namespace = ''
  assign location_freight_metafield_key = ''
  assign first_location_freight_charge = 0
  assign allow_note = section.settings.allow_note
  assign show_pricing = section.settings.show_pricing
  if location_freight_metafield_parts.size >= 2
    assign location_freight_metafield_namespace = location_freight_metafield_parts[0] | strip
    assign location_freight_metafield_key = location_freight_metafield_parts[1] | strip
  endif
  if customer and customer.b2b?
    assign locations_count = customer.company_available_locations_count
    assign first_location = customer.company_available_locations | first
    if use_location_freight_charge and first_location != blank and location_freight_metafield_namespace != blank and location_freight_metafield_key != blank
      assign first_location_metafield = first_location.metafields[location_freight_metafield_namespace][location_freight_metafield_key]
      if first_location_metafield != blank
        assign first_location_freight_charge = first_location_metafield.value | default: first_location_metafield | times: 1.0
      endif
    endif
    if section.settings.location_input_mode == 'dropdown'
      assign use_dropdown_input = true
    elsif section.settings.location_input_mode == 'location_rows'
      assign use_location_rows_input = true
    elsif section.settings.location_input_mode == 'auto' and locations_count > section.settings.location_column_threshold
      assign use_dropdown_input = true
    endif
  endif
-%}

<section class="b2b-russo-order-form section-{{ section.id }}">
  <div class="page-width">
    <header class="b2b-russo-order-form__header">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p>{{ section.settings.description }}</p>
      {%- endif -%}
    </header>

    {%- if customer == blank -%}
      <p>{{ section.settings.login_required_message }}</p>
    {%- elsif customer.b2b? == false -%}
      <p>{{ section.settings.b2b_only_message }}</p>
    {%- elsif source_collection == blank -%}
      <p>{{ section.settings.missing_collection_message }}</p>
    {%- elsif locations_count == 0 -%}
      <p>{{ section.settings.missing_locations_message }}</p>
    {%- else -%}
      <form
        class="b2b-russo-order-form__form"
        data-order-form-root
        data-currency-code="{{ cart.currency.iso_code | default: shop.currency }}"
        data-location-mode="{% if use_dropdown_input %}dropdown{% elsif use_location_rows_input %}location_rows{% else %}columns{% endif %}"
        data-use-freight-charge="{% if use_location_freight_charge %}true{% else %}false{% endif %}"
        data-show-pricing="{% if show_pricing %}true{% else %}false{% endif %}"
        data-summary-empty-message="{{ section.settings.summary_empty_message | escape }}"
        data-storage-key="russo-order-form::{{ shop.permanent_domain }}::{{ customer.id }}::{{ section.id }}"
        data-customer-email="{{ customer.email | escape }}"
        data-submit-endpoint="{{ section.settings.fake_submit_endpoint | escape }}"
        data-submit-confirm-modal-id="OrderSubmitConfirmModal-{{ section.id }}"
        data-submit-start-text="{{ section.settings.submit_in_progress_message | escape }}"
        data-submit-success-text="{{ section.settings.submit_success_message | escape }}"
        data-submit-error-text="{{ section.settings.submit_error_message | escape }}"
      >
        {%- if use_dropdown_input -%}
          <div class="b2b-russo-order-form__location-picker select">
            <label class="location-picker-label caption-large" for="location-picker-{{ section.id }}">
              {{- section.settings.location_selector_label -}}
            </label>
            <select id="location-picker-{{ section.id }}" data-location-select>
              {%- for location in customer.company_available_locations -%}
                {%- liquid
                  assign location_freight_charge = 0
                  if use_location_freight_charge and location_freight_metafield_namespace != blank and location_freight_metafield_key != blank
                    assign location_metafield = location.metafields[location_freight_metafield_namespace][location_freight_metafield_key]
                    if location_metafield != blank
                      assign location_freight_charge = location_metafield.value | default: location_metafield | times: 1.0
                    endif
                  endif
                -%}
                <option
                  value="{{ location.id }}"
                  data-location-id="{{ location.id }}"
                  data-location-name="{{ location.name | escape }}"
                  data-location-freight-charge="{{ location_freight_charge }}"
                  data-location-freight-cents="{{ location_freight_charge | times: 100 | round }}"
                  {% if customer.current_location and customer.current_location.id == location.id %}
                    selected
                  {% endif %}
                >
                  {{ location.name }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

        <div class="b2b-russo-order-form__entry-layout{% if use_dropdown_input %} b2b-russo-order-form__entry-layout--with-summary{% endif %}">
          <div class="b2b-russo-order-form__entry-main">
            <div
              class="b2b-russo-order-form__table-wrap"
              role="region"
              aria-label="{{ section.settings.table_aria_label }}"
            >
              {% paginate source_collection.products by section.settings.products_per_page %}
                <table class="b2b-russo-order-form__table">
                  <thead>
                    <tr>
                      {%- if use_location_rows_input -%}
                        <th scope="col">Location</th>
                        {%- for product in source_collection.products -%}
                          <th scope="col" class="b2b-russo-order-form__location-heading">
                            <span class="b2b-russo-order-form__location-title">{{ product.title }}</span>
                          </th>
                        {%- endfor -%}
                        {%- if show_pricing and use_location_freight_charge -%}
                          <th scope="col" class="b2b-russo-order-form__numeric-heading">Freight</th>
                        {%- endif -%}
                        {%- if show_pricing -%}
                          <th scope="col" class="b2b-russo-order-form__numeric-heading">Total</th>
                        {%- endif -%}
                      {%- else -%}
                        <th scope="col">{{ section.settings.column_product_label }}</th>
                        {%- if section.settings.show_sku -%}
                          <th scope="col">{{ section.settings.column_sku_label }}</th>
                        {%- endif -%}
                        {%- if show_pricing -%}
                          <th scope="col" class="b2b-russo-order-form__numeric-heading">Price E/A</th>
                        {%- endif -%}
                        {%- if use_dropdown_input -%}
                          <th scope="col" class="b2b-russo-order-form__quantity-heading">
                            {{ section.settings.quantity_column_label }}
                          </th>
                        {%- else -%}
                          {%- for location in customer.company_available_locations -%}
                            <th scope="col" class="b2b-russo-order-form__location-heading">
                              <span class="b2b-russo-order-form__location-title">{{ location.name }}</span>
                            </th>
                          {%- endfor -%}
                        {%- endif -%}
                        {%- if show_pricing and use_location_freight_charge -%}
                          <th scope="col" class="b2b-russo-order-form__numeric-heading">Freight</th>
                        {%- endif -%}
                        {%- if show_pricing -%}
                          <th scope="col" class="b2b-russo-order-form__numeric-heading">Total</th>
                        {%- endif -%}
                      {%- endif -%}
                    </tr>
                  </thead>
                  <tbody>
                    {%- if use_location_rows_input -%}
                      {%- for location in customer.company_available_locations -%}
                        {%- liquid
                          assign location_freight_charge = 0
                          if use_location_freight_charge and location_freight_metafield_namespace != blank and location_freight_metafield_key != blank
                            assign location_metafield = location.metafields[location_freight_metafield_namespace][location_freight_metafield_key]
                            if location_metafield != blank
                              assign location_freight_charge = location_metafield.value | default: location_metafield | times: 1.0
                            endif
                          endif
                        -%}
                        <tr
                          data-location-row
                          data-location-id="{{ location.id }}"
                          data-location-name="{{ location.name | escape }}"
                          data-location-freight-cents="{{ location_freight_charge | times: 100 | round }}"
                        >
                          <th scope="row" class="b2b-russo-order-form__location-heading">
                            <span class="b2b-russo-order-form__location-title">{{ location.name }}</span>
                          </th>
                          {%- for product in source_collection.products -%}
                            {%- assign order_variant = product.selected_or_first_available_variant -%}
                            <td class="b2b-russo-order-form__quantity-cell" data-label="{{ product.title | escape }}">
                              <label
                                class="visually-hidden"
                                for="qty-{{ section.id }}-locrow-{{ location.id }}-{{ product.id }}"
                              >
                                {{ location.name }} - {{ product.title }}
                              </label>
                              <input
                                id="qty-{{ section.id }}-locrow-{{ location.id }}-{{ product.id }}"
                                class="b2b-russo-order-form__qty b2b-russo-order-form__qty--location-row"
                                type="number"
                                min="0"
                                step="1"
                                value="0"
                                pattern="[0-9]*"
                                inputmode="numeric"
                                data-product-id="{{ product.id }}"
                                data-product-handle="{{ product.handle }}"
                                data-product-title="{{ product.title | escape }}"
                                data-unit-price-cents="{{ order_variant.price }}"
                                data-location-id="{{ location.id }}"
                                data-location-name="{{ location.name | escape }}"
                                data-location-freight-cents="{{ location_freight_charge | times: 100 | round }}"
                              >
                            </td>
                          {%- endfor -%}
                          {%- if show_pricing and use_location_freight_charge -%}
                            <td class="b2b-russo-order-form__money" data-label="Freight" data-location-row-freight>
                              {{ 0 | money }}
                            </td>
                          {%- endif -%}
                          {%- if show_pricing -%}
                            <td class="b2b-russo-order-form__money" data-label="Total" data-location-row-total>
                              {{ 0 | money }}
                            </td>
                          {%- endif -%}
                        </tr>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for product in source_collection.products -%}
                        {%- assign order_variant = product.selected_or_first_available_variant -%}
                        <tr
                          data-order-form-row
                          data-product-id="{{ product.id }}"
                          data-product-handle="{{ product.handle }}"
                          data-product-title="{{ product.title | escape }}"
                          data-unit-price-cents="{{ order_variant.price }}"
                        >
                          <th scope="row" class="b2b-russo-order-form__product-row-heading">
                            <div class="b2b-russo-order-form__product-cell">
                              {%- if section.settings.show_product_image and product.featured_image != blank -%}
                                {{
                                  product.featured_image
                                  | image_url: width: 80, height: 80
                                  | image_tag: loading: 'lazy', class: 'b2b-russo-order-form__product-image'
                                }}
                              {%- endif -%}
                              <span>{{ product.title }}</span>
                            </div>
                          </th>
                          {%- if section.settings.show_sku -%}
                            <td data-label="{{ section.settings.column_sku_label | escape }}">
                              {{ order_variant.sku | default: '-' }}
                            </td>
                          {%- endif -%}
                          {%- if show_pricing -%}
                            <td class="b2b-russo-order-form__money" data-label="Price E/A">
                              {{ order_variant.price | money }}
                            </td>
                          {%- endif -%}
                          {%- if use_dropdown_input -%}
                            <td
                              class="b2b-russo-order-form__quantity-cell"
                              data-label="{{ section.settings.quantity_column_label | escape }}"
                            >
                              <label class="visually-hidden" for="qty-{{ section.id }}-{{ product.id }}-single">
                                {{ product.title }} - {{ section.settings.quantity_column_label }}
                              </label>
                              <input
                                id="qty-{{ section.id }}-{{ product.id }}-single"
                                class="b2b-russo-order-form__qty b2b-russo-order-form__qty--single-location"
                                type="number"
                                min="0"
                                step="1"
                                value="0"
                                data-product-id="{{ product.id }}"
                                data-product-handle="{{ product.handle }}"
                                data-product-title="{{ product.title | escape }}"
                                data-unit-price-cents="{{ order_variant.price }}"
                                data-location-id="{{ first_location.id }}"
                                data-location-name="{{ first_location.name | escape }}"
                                data-location-freight-cents="{{ first_location_freight_charge | times: 100 | round }}"
                              >
                            </td>
                          {%- else -%}
                            {%- for location in customer.company_available_locations -%}
                              {%- liquid
                                assign location_freight_charge = 0
                                if use_location_freight_charge and location_freight_metafield_namespace != blank and location_freight_metafield_key != blank
                                  assign location_metafield = location.metafields[location_freight_metafield_namespace][location_freight_metafield_key]
                                  if location_metafield != blank
                                    assign location_freight_charge = location_metafield.value | default: location_metafield | times: 1.0
                                  endif
                                endif
                              -%}
                              <td class="b2b-russo-order-form__quantity-cell" data-label="{{ location.name | escape }}">
                                <label
                                  class="visually-hidden"
                                  for="qty-{{ section.id }}-{{ product.id }}-{{ location.id }}"
                                >
                                  {{ product.title }} - {{ location.name }}
                                </label>
                                <input
                                  id="qty-{{ section.id }}-{{ product.id }}-{{ location.id }}"
                                  class="b2b-russo-order-form__qty"
                                  type="number"
                                  min="0"
                                  step="1"
                                  value="0"
                                  pattern="[0-9]*"
                                  inputmode="numeric"
                                  data-product-id="{{ product.id }}"
                                  data-product-handle="{{ product.handle }}"
                                  data-product-title="{{ product.title | escape }}"
                                  data-unit-price-cents="{{ order_variant.price }}"
                                  data-location-id="{{ location.id }}"
                                  data-location-name="{{ location.name | escape }}"
                                  data-location-freight-cents="{{ location_freight_charge | times: 100 | round }}"
                                >
                              </td>
                            {%- endfor -%}
                          {%- endif -%}
                          {%- if show_pricing and use_location_freight_charge -%}
                            <td class="b2b-russo-order-form__money" data-label="Freight" data-row-freight>
                              {{ 0 | money }}
                            </td>
                          {%- endif -%}
                          {%- if show_pricing -%}
                            <td class="b2b-russo-order-form__money" data-label="Total" data-row-total>
                              {{ 0 | money }}
                            </td>
                          {%- endif -%}
                        </tr>
                      {%- endfor -%}
                    {%- endif -%}
                  </tbody>
                </table>
              {% endpaginate %}
            </div>
          </div>

          {%- if use_dropdown_input -%}
            <aside class="b2b-russo-order-form__summary-pane">
              <h3>{{ section.settings.summary_title }}</h3>
              <div class="b2b-russo-order-form__summary-list" data-location-summary-list></div>
            </aside>
          {%- endif -%}
        </div>

        {%- if show_pricing -%}
          <div class="b2b-russo-order-form__grand-total">
            <span>{{ section.settings.order_total_label }}</span>
            <strong data-grand-total>{{ 0 | money }}</strong>
          </div>
        {%- endif -%}

        <div class="b2b-russo-order-form__order-meta">
          {%- if allow_note -%}
            <div class="b2b-russo-order-form__order-meta-field">
              <label for="order-note-{{ section.id }}">{{ section.settings.note_label }}</label>
              <input
                id="order-note-{{ section.id }}"
                type="text"
                data-order-note
              >
            </div>
          {%- endif -%}
          <div class="b2b-russo-order-form__order-meta-field">
            <label for="purchase-order-{{ section.id }}">{{ section.settings.purchase_order_label }}</label>
            <input
              id="purchase-order-{{ section.id }}"
              type="text"
              data-purchase-order-number
            >
          </div>
          <div class="b2b-russo-order-form__order-meta-field">
            <div class="b2b-russo-order-form__field-label-row">
              <label for="requested-delivery-date-{{ section.id }}">Requested Delivery Date</label>
              {%- if section.settings.requested_delivery_date_disclaimer != blank -%}
                <span class="b2b-russo-order-form__field-help">
                  {{- section.settings.requested_delivery_date_disclaimer -}}
                </span>
              {%- endif -%}
            </div>
            <input
              id="requested-delivery-date-{{ section.id }}"
              type="date"
              data-requested-delivery-date
            >
          </div>
        </div>

        <div class="b2b-russo-order-form__top-actions">
          <modal-opener data-modal="#OrderSubmitConfirmModal-{{ section.id }}">
            <button type="button" class="button button--primary" data-submit-order aria-haspopup="dialog">
              {{ section.settings.submit_button_label }}
            </button>
          </modal-opener>
          <p class="b2b-russo-order-form__submit-status" data-submit-status aria-live="polite"></p>
        </div>

        {%- assign submit_confirm_modal_id = 'OrderSubmitConfirmModal-' | append: section.id -%}
        {% render 'russo-confirm-modal',
          modal_id: submit_confirm_modal_id,
          title: section.settings.submit_confirm_title,
          message: section.settings.submit_confirm_message,
          confirm_label: 'Confirm submit',
          cancel_label: 'Cancel',
          confirm_button_attributes: 'data-submit-confirm',
          cancel_button_attributes: 'data-submit-cancel'
        %}

        {%- if section.settings.show_developer_tools -%}
          <div class="b2b-russo-order-form__actions">
            <button type="button" class="button button--secondary" data-build-payload>Generate payload</button>
            <button type="button" class="button button--secondary" data-copy-payload>Copy payload</button>
          </div>

          <label for="payload-{{ section.id }}">Payload preview (JSON)</label>
          <textarea
            id="payload-{{ section.id }}"
            class="b2b-russo-order-form__payload"
            rows="12"
            data-payload-output
            readonly>{}</textarea>
        {%- endif -%}
      </form>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .b2b-russo-order-form__header {
    margin-bottom: 1.5rem;
  }

  .b2b-russo-order-form__entry-layout {
    display: block;
  }

  .b2b-russo-order-form__top-actions {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .b2b-russo-order-form__submit-status {
    margin: 0;
    font-size: 1.25rem;
  }

  .b2b-russo-order-form__entry-layout--with-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30rem;
    gap: 1.2rem;
    align-items: start;
  }

  .b2b-russo-order-form__location-picker {
    margin-bottom: 0.9rem;
    display: grid;
    gap: 0.4rem;
    max-width: 42rem;
  }

  .b2b-russo-order-form__location-picker select {
    padding: 0.8rem;
    width: 100%;
  }
  .location-picker-label {
    width: 30%;
    align-content: center;
  }

  .b2b-russo-order-form__table thead th {
    background-color: rgba(var(--color-foreground), 0.02);
  }

  .b2b-russo-order-form__summary-pane {
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 0.8rem;
    padding: 1rem;
    background: rgba(var(--color-foreground), 0.02);
    position: sticky;
    top: calc(var(--header-height, 0px) + 1rem);
  }

  .b2b-russo-order-form__summary-pane h3 {
    margin: 0 0 0.8rem;
  }

  .b2b-russo-order-form__summary-list {
    display: grid;
    gap: 0.6rem;
  }

  .b2b-russo-order-form__summary-item {
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 0.6rem;
    background: rgb(var(--color-background));
    overflow: hidden;
  }

  .b2b-russo-order-form__summary-header {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 0.8rem;
    align-items: center;
    padding: 0.75rem;
  }

  .b2b-russo-order-form__summary-header::-webkit-details-marker {
    display: none;
  }

  .b2b-russo-order-form__summary-caret {
    font-size: 1.1rem;
    transform: rotate(0deg);
    transition: transform 0.2s ease;
  }

  .b2b-russo-order-form__summary-item[open] .b2b-russo-order-form__summary-caret {
    transform: rotate(90deg);
  }

  .b2b-russo-order-form__summary-item-name {
    font-weight: 600;
  }

  .b2b-russo-order-form__summary-item-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    font-size: 1.3rem;
    white-space: nowrap;
  }

  .b2b-russo-order-form__summary-item-freight {
    margin: 0;
    padding: 0 0.75rem 0.65rem;
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.75);
  }
  .b2b-russo-order-form__location-picker select:focus-visible {
    outline: 0 !important;

    outline-offset: 0;

    box-shadow: none;
  }

  .b2b-russo-order-form__summary-product-list {
    margin: 0;
    padding: 0.1rem 0.75rem 0.75rem;
    list-style: none;
    display: grid;
    gap: 0.25rem;
    font-size: 1.2rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }

  .b2b-russo-order-form__summary-product-list li {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .b2b-russo-order-form__summary-empty {
    color: rgba(var(--color-foreground), 0.7);
  }

  .b2b-russo-order-form__table-wrap {
    overflow-x: auto;
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: 0.8rem;
  }

  .b2b-russo-order-form__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 48rem;
  }

  .b2b-russo-order-form__table th,
  .b2b-russo-order-form__table td {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
    padding: 1rem;
    vertical-align: middle;
  }

  .b2b-russo-order-form__location-heading {
    text-align: left;
    vertical-align: top;
    min-width: 16rem;
  }

  .b2b-russo-order-form__numeric-heading {
    text-align: right;
    white-space: nowrap;
  }

  .b2b-russo-order-form__location-title {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    background: rgba(var(--color-foreground), 0.04);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: normal;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .b2b-russo-order-form__product-cell {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .b2b-russo-order-form__product-image {
    border-radius: 0.4rem;
    width: 4rem;
    height: 4rem;
    object-fit: cover;
  }

