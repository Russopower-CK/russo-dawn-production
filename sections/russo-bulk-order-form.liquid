{{ 'component-table.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign saved_order = cart.attributes.quick_order_lines | default: '' | strip
  assign saved_lines = saved_order | split: '||'
-%}

<div class="page-width quick-order" data-quick-order>
  <h1>Quick Order</h1>

  <div class="quick-order__search">
    <input
      class="field__input"
      type="search"
      placeholder="Search products or SKUs"
      autocomplete="off"
      data-search-input
    >
    <div class="quick-order__results" data-search-results hidden></div>
  </div>

  <div class="russo-table-wrapper">
    <div data-order-content>
      <table class="quick-order__table russo-table">
        <thead class="russo-table-header">
          <tr>
            <th>Product</th>
            <th>Variant</th>
            <th>SKU</th>
            <th>Price</th>
            <th>Quantity</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {%- for saved_line in saved_lines -%}
            {%- if saved_line != blank -%}
              {%- liquid
                assign parts = saved_line | split: '|'
                assign product_handle = parts[0]
                assign variant_id = parts[1] | plus: 0
                assign quantity = parts[2] | plus: 0
                assign product = all_products[product_handle]
                assign variant = product.variants | where: 'id', variant_id | first
                if quantity < 1
                  assign quantity = 1
                endif
              -%}
              {%- if product != blank and variant != blank -%}
                <tr class="russo-table-row" data-order-row data-variant-id="{{ variant.id }}">
                  <td>
                    {%- if product.featured_image != blank -%}
                      {{
                        product.featured_image
                        | image_url: width: 80, height: 80
                        | image_tag: loading: 'lazy', class: 'b2b-russo-order-form__product-image'
                      }}
                    {%- endif -%}
                  </td>
                  <td>{{ product.title }}</td>
                  <td>{{ variant.sku }}</td>
                  <td>{%- render 'price', product: product, use_variant: true -%}</td>
                  <td>
                    <input
                      class="quick-order__quantity"
                      type="number"
                      min="1"
                      step="1"
                      value="{{ quantity }}"
                      data-quantity
                    >
                  </td>
                  <td>
                    <button type="button" class="button button--secondary" data-remove>Remove</button>
                  </td>
                </tr>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
  <div class="quick-order_actions">
    {%- if saved_order != blank -%}
      <button type="button" class="button" data-add-all>Add all to cart</button>
    {%- endif -%}
  </div>
</div>

<script>
  (() => {
    const script = document.currentScript;
    const section = script.closest('[id^="shopify-section-"]');
    const orderForm = section?.querySelector('[data-quick-order]');
    if (!section || !orderForm) return;
    const sectionId = section.id.replace('shopify-section-', '');
    const attributeName = 'quick_order_lines';
    const root = window.Shopify?.routes?.root || '/';
    const searchInput = orderForm.querySelector('[data-search-input]');
    const searchResults = orderForm.querySelector('[data-search-results]');

    let searchTimer;
    let searchRequest;

    function escapeHtml(value) {
      const element = document.createElement('div');
      element.textContent = value == null ? '' : String(value);
      return element.innerHTML;
    }

    function parseLines(value = '') {
      return value
        .split('||')
        .filter(Boolean)
        .map((savedLine) => {
          const [handle, variantId, quantity] = savedLine.split('|');
          return {
            handle,
            variantId,
            quantity: Math.max(parseInt(quantity, 10) || 1, 1),
          };
        });
    }

    function serializeLines(lines) {
      return lines.map((line) => [line.handle, line.variantId, line.quantity].join('|')).join('||');
    }

    async function getCart() {
      const response = await fetch(root + 'cart.js');
      if (!response.ok) throw new Error('Unable to load cart.');
      return response.json();
    }

    async function getLines() {
      const cart = await getCart();
      return parseLines(cart.attributes?.[attributeName] || '');
    }

    async function refreshOrderContent() {
      const url = new URL(window.location.href);
      url.searchParams.set('section_id', sectionId);
      const response = await fetch(url.toString());
      if (!response.ok) throw new Error('Unable to refresh quick order.');

      const html = await response.text();
      const documentFragment = new DOMParser().parseFromString(html, 'text/html');
      const newContent = documentFragment.querySelector('[data-order-content]');
      const currentContent = orderForm.querySelector('[data-order-content]');

      if (!newContent || !currentContent) {
        throw new Error('Quick order section could not be refreshed.');
      }

      currentContent.replaceWith(newContent);
    }

    async function saveLines(lines) {
      const response = await fetch(root + 'cart/update.js', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          attributes: {
            [attributeName]: serializeLines(lines),
          },
        }),
      });

      if (!response.ok) throw new Error('Unable to save quick order.');
      await refreshOrderContent();
    }

    function getProductHandle(product) {
      if (product.handle) return product.handle;

      try {
        return new URL(product.url, window.location.origin).pathname.match(/\/products\/([^/]+)/)?.[1] || '';
      } catch {
        return '';
      }
    }

    async function getProduct(handle) {
      const response = await fetch(root + 'products/' + encodeURIComponent(handle) + '.js');
      if (!response.ok) throw new Error('Unable to load product.');
      return response.json();
    }

    async function searchProducts(query) {
      searchRequest?.abort();
      searchRequest = new AbortController();

      const params = new URLSearchParams({
        q: query,
        'resources[type]': 'product',
        'resources[limit]': '8',
        'resources[options][fields]': 'title,variants.title,variants.sku',
      });

      const response = await fetch(root + 'search/suggest.json?' + params, {
        signal: searchRequest.signal,
      });
      if (!response.ok) throw new Error('Search failed.');

      const data = await response.json();
      const products = data.resources?.results?.products || [];
      return Promise.all(
        products.map((product) => {
          const handle = getProductHandle(product);
          return handle ? getProduct(handle) : null;
        })
      ).then((items) => items.filter(Boolean));
    }

    function renderResults(products) {
      const variants = products.flatMap((product) =>
        product.variants
          .filter((variant) => variant.available)
          .map((variant) => ({
            handle: product.handle,
            productTitle: product.title,
            variantId: variant.id,
            variantTitle: variant.title,
            sku: variant.sku || '',
            image: variant.featured_image?.src || product.featured_image || '',
          }))
      );

      if (!variants.length) {
        searchResults.innerHTML = '<p class="quick-order__empty">No products found.</p>';
        searchResults.hidden = false;
        return;
      }

      searchResults.innerHTML = variants
        .map(
          (variant) => `
 <button
 type="button"
 class="quick-order__result"
 data-add-variant
 data-handle="${escapeHtml(variant.handle)}"
 data-variant-id="${escapeHtml(variant.variantId)}"
 >
 ${variant.image ? `<img src="${escapeHtml(variant.image)}" alt="" width="56" height="56">` : ''}
 <span>
 <strong>${escapeHtml(variant.productTitle)}</strong>
 <small>
 ${escapeHtml(variant.variantTitle)}${variant.sku ? ' - ' + escapeHtml(variant.sku) : ''}
 </small>
 </span>
 </button>
 `
        )
        .join('');
      searchResults.hidden = false;
    }

    async function addVariant(handle, variantId) {
      const lines = await getLines();
      const existingLine = lines.find((line) => line.variantId === variantId);

      if (existingLine) {
        existingLine.quantity += 1;
      } else {
        lines.push({ handle, variantId, quantity: 1 });
      }

      await saveLines(lines);
      searchInput.value = '';
      searchResults.hidden = true;
      searchResults.innerHTML = '';
    }

    async function addAllToCart(button) {
      button.disabled = true;

      try {
        const lines = await getLines();
        if (!lines.length) return;

        const cartDrawer = document.querySelector('cart-drawer');
        if (!cartDrawer) throw new Error('Cart drawer was not found.');

        const formData = new FormData();
        lines.forEach((line, index) => {
          formData.append(`items[${index}][id]`, line.variantId);
          formData.append(`items[${index}][quantity]`, line.quantity);
        });

        formData.append(
          'sections',
          cartDrawer
            .getSectionsToRender()
            .map((section) => section.id)
            .join(',')
        );
        formData.append('sections_url', window.location.pathname);

        const addResponse = await fetch(root + 'cart/add.js', {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
          body: formData,
        });

        const addResult = await addResponse.json();

        if (!addResponse.ok || addResult.status) {
          throw new Error(addResult.description || 'Unable to add quick order to cart.');
        }

        cartDrawer.renderContents(addResult);

        const clearResponse = await fetch(root + 'cart/update.js', {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            attributes: {
              [attributeName]: '',
            },
          }),
        });

        if (!clearResponse.ok) {
          throw new Error('Items were added, but the quick order was not cleared.');
        }

        await refreshOrderContent();
      } catch (error) {
        console.error(error);
        button.disabled = false;
      }
    }

    searchInput.addEventListener('input', () => {
      clearTimeout(searchTimer);
      const query = searchInput.value.trim();

      if (!query) {
        searchRequest?.abort();
        searchResults.hidden = true;
        searchResults.innerHTML = '';
        return;
      }

      searchTimer = setTimeout(async () => {
        try {
          const products = await searchProducts(query);
          if (query === searchInput.value.trim()) renderResults(products);
        } catch (error) {
          if (error.name !== 'AbortError') console.error(error);
        }
      }, 300);
    });

    orderForm.addEventListener('click', async (event) => {
      const variantButton = event.target.closest('[data-add-variant]');
      const removeButton = event.target.closest('[data-remove]');
      const addAllButton = event.target.closest('[data-add-all]');
      try {
        if (variantButton) {
          variantButton.disabled = true;
          await addVariant(variantButton.dataset.handle, variantButton.dataset.variantId);
          return;
        }

        if (removeButton) {
          removeButton.disabled = true;
          const row = removeButton.closest('[data-order-row]');
          const lines = await getLines();
          await saveLines(lines.filter((line) => line.variantId !== row.dataset.variantId));
          return;
        }
        if (addAllButton) {
          await addAllToCart(addAllButton);
        }
      } catch (error) {
        console.error(error);
        if (variantButton) variantButton.disabled = false;
        if (removeButton) removeButton.disabled = false;
      }
    });

    orderForm.addEventListener('input', (event) => {
      const quantityInput = event.target.closest('[data-quantity]');
      if (!quantityInput) return;

      clearTimeout(quantityInput.saveTimer);
      quantityInput.saveTimer = setTimeout(async () => {
        const row = quantityInput.closest('[data-order-row]');
        const quantity = Math.max(parseInt(quantityInput.value, 10) || 1, 1);
        quantityInput.value = quantity;
        try {
          const lines = await getLines();
          const line = lines.find((item) => item.variantId === row.dataset.variantId);
          if (!line) return;

          line.quantity = quantity;
          await saveLines(lines);
        } catch (error) {
          console.error(error);
        }
      }, 500);
    });

    document.addEventListener('click', (event) => {
      if (!orderForm.contains(event.target)) searchResults.hidden = true;
    });
  })();
</script>

{% stylesheet %}
  .b2b-russo-order-form__product-image {
    border-radius: 0.4rem;
    width: 4rem;
    height: 4rem;
    object-fit: cover;
  }
  .quick-order_actions {
    justify-content: end;
    display: flex;
    padding: 1rem;
  }
  .quick-order__search {
    position: relative;
    max-width: 50rem;
    margin-bottom: 2rem;
  }

  .quick-order__results {
    position: absolute;
    z-index: 10;
    width: 100%;
    max-height: 40rem;
    overflow-y: auto;
    padding: 0.8rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    background: rgb(var(--color-background));
    box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.12);
  }

  .quick-order__result {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1rem;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  .quick-order__result:hover {
    background: rgba(var(--color-foreground), 0.05);
  }

  .quick-order__result img {
    object-fit: cover;
  }

  .quick-order__result span {
    display: grid;
  }

  .quick-order__empty {
    margin: 0;
    padding: 1rem;
  }

  .quick-order__table {
    width: 100%;
  }

  .quick-order__table th,
  .quick-order__table td {
    padding: 1rem;
    text-align: left;
  }

  .quick-order__quantity {
    width: 8rem;
  }

  @media screen and (max-width: 749px) {
    .quick-order {
      overflow-x: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quick Order Form",
  "presets": [
    {
      "name": "Quick Order Form"
    }
  ]
}
{% endschema %}
