lank">Learn More &gt;</a></b></p></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-jwZJYP cIFzrt pf-400_"><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-401_ pf-heading-7-h3"><span style="color: rgb(190, 30, 45);">ILCA iLandscape — February 26 - 28, 2025</span></h3><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-403_ pf-heading-1-h3">Renaissance Schaumburg Convention Center Hotel – Schaumburg, IL</h3><p class="sc-fbFjKN fqkBeE pf-405_ pf-text-2" data-pf-type="Paragraph3">Attend the 12th annual iLandscape show &amp; sit in on educational sessions, talk with more than 400 exhibitors, and discover the latest trends in the green industry! Visit Russo at Booth #1729.&nbsp;<a href="https://ilandscapeshow.com/" target="_blank"><b>Learn More &gt;</b></a>&nbsp;</p></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-jwZJYP cIFzrt pf-407_"><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-408_ pf-heading-7-h3"><span style="color: rgb(190, 30, 45);">ILCA Young Professionals Event — February 13, 2025</span></h3><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-410_ pf-heading-1-h3">Mickey Finn's Brewery – Libertyville, IL</h3><p class="sc-fbFjKN fqkBeE pf-412_ pf-text-2" data-pf-type="Paragraph3">Join ILCA’s young professionals committee at Mickey Finn’s Brewery in Libertyville, IL for their February event!

Recharging for Success: Understanding and Managing Burnout.&nbsp;<a href="https://indianagreenexpo.com/" target="_blank"><b></b></a><b><a href="https://ilca.net/ilca-events/young-professionals-event/" target="_self">Learn More &gt;</a></b></p></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-jwZJYP cIFzrt pf-414_"><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-415_ pf-heading-7-h3"><span style="color: rgb(190, 30, 45);">IGE Indiana Green Expo — February 11 - 12, 2025</span></h3><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-417_ pf-heading-1-h3">Indiana Convention Center  –  Indianapolis, IN</h3><p class="sc-fbFjKN fqkBeE pf-419_ pf-text-2" data-pf-type="Paragraph3">Indiana Green Expo two-day Trade Show provides opportunities for turf and landscape professionals to meet with vendors and view the newest products and technology. Plan to be a part of it! Visit Russo at Booth #205 &amp; Haltom at Booth #201.&nbsp;<a href="https://indianagreenexpo.com/" target="_blank"><b><a href="https://indianagreenexpo.com/" target="_blank">Learn More &gt;</a></b></a></p></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-jwZJYP cIFzrt pf-421_"><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-422_ pf-heading-7-h3"><span style="color: rgb(190, 30, 45);">ILCA InVigorateU Conference — January 28 - 29, 2025</span></h3><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-424_ pf-heading-1-h3">DoubleTree by Hilton – Bloomington, IL</h3><p class="sc-fbFjKN fqkBeE pf-426_ pf-text-2" data-pf-type="Paragraph3">InVigorateU is an annual education conference that not only offers great sessions and CEUs, but also offers a chance to reflect on what worked this season and collaborate with peers about what you might want to do differently in the next to get stronger results. <strong><a href="https://ilca.net/ilca-events/invigorateu/" target="_blank">Learn More &gt;</a></strong></p></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-jwZJYP cIFzrt pf-428_"><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-429_ pf-heading-7-h3"><span style="color: rgb(190, 30, 45);">IAPD/IPRA Soaring to New Heights Conference — January&nbsp;23 - 24, 2025</span></h3><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-431_ pf-heading-1-h3">Hyatt Regency – Chicago, IL</h3><p class="sc-fbFjKN fqkBeE pf-433_ pf-text-2" data-pf-type="Paragraph3">The IAPD/IPRA Soaring to New Heights Conference holds the unique distinction of being the largest state park and recreation conference in the nation. The conference brings together thousands of professionals, Commissioners, and elected officials from around the state for three exciting days of quality educational programming, networking, and professional development. Visit Russo at Booth #234.&nbsp;<a href="https://www.ilparksconference.com/" target="_blank"><b><a href="https://www.ilparksconference.com/" target="_blank">Learn More &gt;</a></b></a></p></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-jwZJYP cIFzrt pf-435_"><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-436_ pf-heading-7-h3"><span style="color: rgb(190, 30, 45);">Lawn Care Application Timing — January&nbsp;15, 2025</span></h3><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-438_ pf-heading-1-h3">Russo: New Berlin, WI — 11:00AM Social &amp; Lunch, 1:00PM Seminar Starts</h3><p class="sc-fbFjKN fqkBeE pf-440_ pf-text-2" data-pf-type="Paragraph3"><strong>Have questions about applying plant health care products like fertilizers, chemicals, or seed?&nbsp;</strong>Join us for this engaging seminar with Larry Vogel (Spring Valley), Patrick Bastron (PBI Gordon), and Rob Osier (Russo Plant&nbsp;Health Care Manager). They'll address common concerns and share practical tips to boost your confidence and maximize effectiveness in lawn care applications. Whether you're a seasoned pro or just starting out, this event is the perfect opportunity to gain valuable insights. Plus, enjoy a free lunch!&nbsp;<a href="https://www.eventbrite.com/e/lawn-care-application-timing-tickets-1132721403209?aff=eventcal" target="_self"><strong><a href="https://www.eventbrite.com/e/lawn-care-application-timing-tickets-1132721403209?aff=eventcal" target="_blank">RSVP today &gt;</a></strong></a></p></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-jwZJYP cIFzrt pf-442_"><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-443_ pf-heading-7-h3"><span style="color: rgb(190, 30, 45);">ILA Holiday Party&nbsp; — Dec 12, 2024</span></h3><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-445_ pf-heading-1-h3">Liter House – Indianapolis, IN</h3><p class="sc-fbFjKN fqkBeE pf-447_ pf-text-2" data-pf-type="Paragraph3">Join in for a fun night at the ILA's Annual Meeting / Holiday Party featuring Live Music, Guest Comedian, and Raffle Prizes.&nbsp;&nbsp;<a href="https://ila.wildapricot.org/event-5927885" target="_self"><strong>Learn More &gt;</strong></a></p></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-jwZJYP cIFzrt pf-449_"><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-450_ pf-heading-7-h3"><span style="color: rgb(190, 30, 45);">WNLA Holiday Party&nbsp; — Dec&nbsp;4, 2024</span></h3><h3 data-pf-type="Heading2" class="sc-bOhtQk gAzRSI pf-452_ pf-heading-1-h3">The Wisconsin Club – Milwaukee, WI</h3><p class="sc-fbFjKN fqkBeE pf-454_ pf-text-2" data-pf-type="Paragraph3">Join in&nbsp;for a fun evening of networking, celebrating award winners, dinner and drinks!&nbsp;<a href="https://wnla.net/meetinginfo.php?id=60&amp;ts=1728404774" target="_self"><strong>Learn More &gt;</strong></a></p></div></div><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;