{% comment %}
  Reusable tooltip note markup.

  Accepts:
  - label: {String} Visible trigger text.
  - tooltip_title: {String} Tooltip header text.
  - tooltip_body: {String} Tooltip body text.
  - note_class: {String} Optional classes for note wrapper.
  - label_class: {String} Optional classes for trigger label text.
  - tooltip_class: {String} Optional classes for tooltip wrapper.
  - is_hidden: {Boolean} When true, renders hidden attribute on wrapper.
  - note_data_attribute: {String} Optional raw data attribute for wrapper span.
  - label_data_attribute: {String} Optional raw data attribute for trigger button.
  - title_data_attribute: {String} Optional raw data attribute for title span.
  - body_data_attribute: {String} Optional raw data attribute for body span.
{% endcomment %}

{%- liquid
  assign tooltip_label = label | default: 'Special Order'
  assign tooltip_heading = tooltip_title | default: tooltip_label
  assign tooltip_copy = tooltip_body | default: ''
  assign tooltip_note_class = note_class | default: 'continue-selling-note'
  assign tooltip_label_class = label_class | default: ''
  assign tooltip_popup_class = tooltip_class | default: 'continue-selling-tooltip'
  assign tooltip_uid = 'SpecialOrderTooltip-' | append: section.id | append: '-' | append: product.id | append: '-' | append: product.selected_or_first_available_variant.id
-%}

<span
  class="{{ tooltip_note_class }}"
  data-continue-selling-note
  {% if is_hidden %}
    hidden
  {% endif %}
  {% if note_data_attribute != blank %}
    {{ note_data_attribute }}
  {% endif %}
>
  <button
    type="button"
    class="continue-selling-note__trigger{% if tooltip_label_class != blank %} {{ tooltip_label_class }}{% endif %}"
    aria-expanded="false"
    aria-controls="{{ tooltip_uid }}"
    data-continue-selling-trigger
    {% if label_data_attribute != blank %}
      {{ label_data_attribute }}
    {% endif %}
  >
    {{- tooltip_label | escape -}}
  </button>

  <span
    id="{{ tooltip_uid }}"
    class="{{ tooltip_popup_class }}"
    role="tooltip"
    aria-hidden="true"
    data-continue-selling-tooltip
  >
    <span class="continue-selling-tooltip__header">
      <span
        class="continue-selling-tooltip__title"
        {% if title_data_attribute != blank %}
          {{ title_data_attribute }}
        {% endif %}
      >
        {{- tooltip_heading | escape -}}
      </span>

      <button
        type="button"
        class="continue-selling-tooltip__close"
        aria-label="Close {{ tooltip_heading | escape }} information"
        data-continue-selling-close
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </span>

    <span
      class="continue-selling-tooltip__body"
      {% if body_data_attribute != blank %}
        {{ body_data_attribute }}
      {% endif %}
    >
      {{- tooltip_copy | escape -}}
    </span>
  </span>
</span>

<script>
  (() => {
    if (window.RussoContinueSellingTooltipInitialized) return;
    window.RussoContinueSellingTooltipInitialized = true;

    const noteSelector = '[data-continue-selling-note]';

    const closeNote = (note, returnFocus = false) => {
      if (!note) return;

      const trigger = note.querySelector('[data-continue-selling-trigger]');
      const tooltip = note.querySelector('[data-continue-selling-tooltip]');

      note.classList.remove('is-open');
      trigger?.setAttribute('aria-expanded', 'false');
      tooltip?.setAttribute('aria-hidden', 'true');

      if (returnFocus) trigger?.focus();
    };

    const closeAllNotes = (exceptNote = null) => {
      document.querySelectorAll(`${noteSelector}.is-open`).forEach((note) => {
        if (note !== exceptNote) closeNote(note);
      });
    };

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-continue-selling-trigger]');
      const closeButton = event.target.closest('[data-continue-selling-close]');

      if (trigger) {
        const note = trigger.closest(noteSelector);
        const tooltip = note?.querySelector('[data-continue-selling-tooltip]');
        const willOpen = !note?.classList.contains('is-open');

        closeAllNotes(note);
        note?.classList.toggle('is-open', willOpen);
        trigger.setAttribute('aria-expanded', String(willOpen));
        tooltip?.setAttribute('aria-hidden', String(!willOpen));
        event.preventDefault();
        return;
      }

      if (closeButton) {
        const note = closeButton.closest(noteSelector);
        closeNote(note, true);
        event.preventDefault();
        return;
      }

      if (!event.target.closest(noteSelector)) closeAllNotes();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      const openNote = document.querySelector(`${noteSelector}.is-open`);
      if (openNote) closeNote(openNote, true);
    });
  })();
</script>
