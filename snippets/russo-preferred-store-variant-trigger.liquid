{%- comment -%}
  Usage:
    {% render 'russo-preferred-store-variant-trigger', variant: product.selected_or_first_available_variant %}

  Optional params:
    button_label: override status fallback label when no preferred store is selected
    show_status_display: render the status line (default true)
    show_launcher_button: render the open-selector button/link (default true)
    launcher_button_label: launcher button text (default "Check availability at other stores")
    auto_status_fetch: when false, skip status fetch/update logic in this snippet (default false)

    Responsibility split for this snippet:
  1) Status-only button label:
      - updateButtonLabel() updates the button text from cookie + live getStockLevels data.
      - Does not use legacy metafield/store_availability fallback.
  2) Click/open + stock fetch:
     - Click handler sets window.__PreferredStoreProductContext and opens drawer via
       window.__PreferredStoreOpen(...) or window.__PreferredStoreAPI.open().
     - Main stock truth for per-store quantity/status is fetched in
       assets/russo-preferred-store-main.js (loadProxyStockForVariant -> getStockLevels).
     - This file also includes a direct "probe" fetch for debugging visibility on click.
{%- endcomment -%}
<style>
  .russo-card__shipping-stock .preffered-store-pickup__display {
    flex-wrap: wrap;
    margin-top: 0.5rem;
    container-type: inline-size;
  }

  .russo-card__shipping-stock .preferred-store-pickup__status-default-label {
    white-space: normal;
    width: auto;
  }

  .preffered-store-pickup__display {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .preferred-store-pickup__status-label {
    text-decoration: underline;
  }
  .preferred-store-pickup__status-label:hover {
    text-decoration-thickness: 0.2rem;
  }

  .russo-card__shipping-stock .preffered-store-pickup__display,
  .russo-card__shipping-stock .pickup-availability-preview {
    flex-wrap: nowrap;
    overflow: hidden;
  }

  .russo-card__shipping-stock .preferred-store-pickup__status-default-label,
  .russo-card__shipping-stock .preferred-store-pickup__status-line,
  .russo-card__shipping-stock .caption {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: clamp(0.5rem, 1rem, 1.25rem);
  }
</style>
{%- liquid
  assign preferred_store_variant = variant | default: product.selected_or_first_available_variant
  assign preferred_store_default_label = button_label | default: ' '
  assign preferred_store_show_status_label = show_status_label | default: true
  assign preferred_store_show_status_display = show_status_display | default: true
  assign preferred_store_show_launcher_button = show_launcher_button | default: false
  assign preferred_store_auto_status_fetch = auto_status_fetch | default: false
  assign preferred_store_launcher_button_label = launcher_button_label | default: 'Check availability at other stores'
  assign preferred_store_unavailable_display_mode = unavailable_display_mode | default: 'custom_tooltip'
  assign preferred_store_unavailable_label = unavailable_label | default: 'Special Order'
  assign preferred_store_unavailable_tooltip_title = unavailable_tooltip_title | default: preferred_store_unavailable_label
  assign preferred_store_unavailable_tooltip_body = unavailable_tooltip_body | default: 'Unavailable at {store}. Contact us to place a special order.'
  assign preferred_store_instance_id = 'preferred-store-variant-' | append: section.id | append: '-' | append: preferred_store_variant.id
-%}

<div
  class="pickup-availability-preview"
  data-preferred-store-variant-trigger
  data-instance-id="{{ preferred_store_instance_id }}"
  data-preferred-store-variant-id="{{ preferred_store_variant.id }}"
  data-auto-status-fetch="{{ preferred_store_auto_status_fetch }}"
  data-preferred-store-default-label="{{ preferred_store_default_label | escape }}"
  data-preferred-store-unavailable-display-mode="{{ preferred_store_unavailable_display_mode | escape }}"
  data-preferred-store-unavailable-label="{{ preferred_store_unavailable_label | escape }}"
  data-preferred-store-unavailable-tooltip-title="{{ preferred_store_unavailable_tooltip_title | escape }}"
  data-preferred-store-unavailable-tooltip-body="{{ preferred_store_unavailable_tooltip_body | escape }}"
>
  {%- if preferred_store_show_status_display -%}
    <div class="preffered-store-pickup__display">
      <p class="preferred-store-pickup__status-line caption" style="padding-right: 3px;margin: 0;">Pickup:</p>
      <div class="preffered-store-pickup__status-icon"></div>
      <span class="preferred-store-pickup__status-default-label caption" data-preferred-store-product-label>
        {{- preferred_store_default_label -}}
      </span>
      {% render 'russo-tooltip-note',
        label: preferred_store_unavailable_label,
        label_class: 'preferred-store-pickup__status-default-label caption',
        tooltip_title: preferred_store_unavailable_tooltip_title,
        tooltip_body: preferred_store_unavailable_tooltip_body,
        note_class: 'continue-selling-note preferred-store-special-order-note preferred-store-special-order-note--hidden',
        note_data_attribute: 'data-preferred-store-special-order-note',
        label_data_attribute: 'data-preferred-store-special-order-label',
        title_data_attribute: 'data-preferred-store-special-order-tooltip-title',
        body_data_attribute: 'data-preferred-store-special-order-tooltip-body',
        is_hidden: true
      %}
    </div>
  {%- endif -%}

  {%- if preferred_store_show_launcher_button -%}
    <button
      type="button"
      class="preferred-store-pickup__status-button"
      data-preferred-store-open
      data-preferred-store-direct="true"
      data-preferred-store-variant-id="{{ preferred_store_variant.id }}"
      aria-label="Open preferred store selector"
      style="display:block; width:100%; margin-top:0.25rem; font-size: 1rem !important;"
    >
      <span class="preferred-store-pickup__status-label caption">
        {{- preferred_store_launcher_button_label -}}
      </span>
    </button>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.querySelector('[data-instance-id="{{ preferred_store_instance_id }}"]');
    if (!root) return;
    var autoStatusFetch = {{ preferred_store_auto_status_fetch | json }};

    var locations = [];

    window.__PreferredStoreProductContext = {
      variantId: {{ preferred_store_variant.id | json }},
      locations: locations
    };

    function normalizeKey(s) {
      return String(s || '')
        .toLowerCase()
        .trim()
        .replace(/\s+/g, ' ')
        .replace(/[^\w\s]/g, '');
    }

    function getCookie(name) {
      var value = '; ' + document.cookie;
      var parts = value.split('; ' + name + '=');
      if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
      return null;
    }

    function setButtonLabel(text) {
      var label = root.querySelector('[data-preferred-store-product-label]');
      if (!label) return;
      label.textContent = text;
    }

    function setButtonLabelContent(payload) {
      var label = root.querySelector('[data-preferred-store-product-label]');
      if (!label) return;
      var specialOrder = root.querySelector('[data-preferred-store-special-order-note]');
      var specialOrderLabel = root.querySelector('[data-preferred-store-special-order-label]');
      var specialOrderTitle = root.querySelector('[data-preferred-store-special-order-tooltip-title]');
      var specialOrderBody = root.querySelector('[data-preferred-store-special-order-tooltip-body]');

      var data = payload || {};

      if (data.showSpecialOrder && specialOrder) {
        label.hidden = true;
        specialOrder.hidden = false;
        specialOrder.classList.remove('preferred-store-special-order-note--hidden');

        if (specialOrderLabel) {
          specialOrderLabel.textContent = data.specialOrderLabel || data.text || 'Special Order';
        }
        if (specialOrderTitle) {
          specialOrderTitle.textContent = data.specialOrderTitle || data.specialOrderLabel || data.text || 'Special Order';
        }
        if (specialOrderBody) {
          specialOrderBody.textContent = data.specialOrderBody || '';
        }
        return;
      }

      label.hidden = false;
      if (specialOrder) {
        specialOrder.hidden = true;
        specialOrder.classList.add('preferred-store-special-order-note--hidden');
      }
      label.textContent = data.text || '';
    }

    function setStatusIcon(inStock) {
      var iconRoot = root.querySelector('.preffered-store-pickup__status-icon');
      if (!iconRoot) return;

      if (inStock === true) {
        iconRoot.innerHTML =
          '<svg class="surface-pick-up-embed__in-stock-icon" width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">' +
          '<path d="M4.33346 10.5625L3.80311 11.0928L4.33344 11.6232L4.86379 11.0928L4.33346 10.5625ZM0.191824 7.48134L3.80311 11.0928L4.8638 10.0322L1.25251 6.4207L0.191824 7.48134ZM4.86379 11.0928L12.9888 2.96783L11.9281 1.90717L3.80313 10.0322L4.86379 11.0928Z"></path>' +
          '</svg>';
        return;
      }

      if (inStock === false) {
        iconRoot.innerHTML =
          '<svg class="surface-pick-up-embed__out-of-stock-icon" width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true">' +
          '<path d="M1.46967 2.53033L5.96967 7.03033L7.03033 5.96967L2.53033 1.46967L1.46967 2.53033ZM5.96967 7.03033L10.4697 11.5303L11.5303 10.4697L7.03033 5.96967L5.96967 7.03033ZM7.03033 7.03033L11.5303 2.53033L10.4697 1.46967L5.96967 5.96967L7.03033 7.03033ZM10.4697 1.46967L1.46967 10.4697L2.53033 11.5303L11.5303 2.53033L10.4697 1.46967Z"></path>' +
          '</svg>';
        return;
      }

      iconRoot.innerHTML = '';
    }

    function toUniqueList(items) {
      var out = [];
      (items || []).forEach(function (item) {
        var value = String(item || '').trim();
        if (!value) return;
        if (out.indexOf(value) === -1) out.push(value);
      });
      return out;
    }

    function buildStockEndpointCandidates(primary) {
      var p = String(primary || '').trim();
      var v1 = '/apps/russoAPI/v1/getStockLevels';
      var legacy = '/apps/russoAPI?RequestType=getStockLevels';

      if (p.indexOf('/apps/russoAPI/v1/') !== -1) return toUniqueList([p, legacy]);
      if (p.indexOf('/apps/russoAPI?') !== -1 || p.indexOf('RequestType=') !== -1) return toUniqueList([p, v1]);
      if (p) return toUniqueList([p, v1, legacy]);
      return toUniqueList([v1, legacy]);
    }

    function fetchJsonWithFallback(urls, requestInit) {
      var queue = toUniqueList(urls);
      var failures = [];
      var init = requestInit || { headers: { Accept: 'application/json' } };

      function attempt(index) {
        if (index >= queue.length) {
          throw new Error('Stock request failed: ' + failures.join(' | '));
        }

        var url = queue[index];
        return fetch(url, init)
          .then(function (res) {
            return res.text().then(function (raw) {
              if (!res.ok) {
                throw new Error(url + ' -> HTTP ' + res.status);
              }
              try {
                return { data: raw ? JSON.parse(raw) : null, url: url };
              } catch (e) {
                throw new Error(url + ' -> invalid JSON');
              }
            });
          })
          .catch(function (err) {
            failures.push(err && err.message ? err.message : (url + ' -> request failed'));
            return attempt(index + 1);
          });
      }

      return attempt(0);
    }

    function extractStockItems(data) {
      function inventoryLevelNodes(levels) {
        if (!levels || typeof levels !== 'object') return [];
        if (Array.isArray(levels.nodes)) return levels.nodes;
        if (Array.isArray(levels.edges)) {
          return levels.edges
            .map(function (edge) { return edge && edge.node ? edge.node : null; })
            .filter(Boolean);
        }
        return [];
      }

      function nodesFromVariant(variantNode) {
        if (!variantNode || typeof variantNode !== 'object') return [];
        if (!variantNode.inventoryItem || !variantNode.inventoryItem.inventoryLevels) return [];
        return inventoryLevelNodes(variantNode.inventoryItem.inventoryLevels);
      }

      if (!data) return [];
      if (Array.isArray(data)) return data;
      if (data.data && Array.isArray(data.data.nodes)) {
        return data.data.nodes.reduce(function (all, variantNode) {
          return all.concat(nodesFromVariant(variantNode));
        }, []);
      }
      if (Array.isArray(data.nodes)) {
        return data.nodes.reduce(function (all, variantNode) {
          return all.concat(nodesFromVariant(variantNode));
        }, []);
      }
      if (
        data.data &&
        data.data.productVariant &&
        data.data.productVariant.inventoryItem &&
        data.data.productVariant.inventoryItem.inventoryLevels
      ) {
        return nodesFromVariant(data.data.productVariant);
      }
      if (data.data && data.data.productVariants && Array.isArray(data.data.productVariants.nodes)) {
        return data.data.productVariants.nodes.reduce(function (all, variantNode) {
          return all.concat(nodesFromVariant(variantNode));
        }, []);
      }
      if (data.data && data.data.productVariants && Array.isArray(data.data.productVariants.edges)) {
        return data.data.productVariants.edges.reduce(function (all, edge) {
          return all.concat(nodesFromVariant(edge && edge.node ? edge.node : null));
        }, []);
      }
      if (Array.isArray(data.data)) return data.data;
      if (data.data && Array.isArray(data.data.stockLevels)) return data.data.stockLevels;
      if (data.data && Array.isArray(data.data.getStockLevels)) return data.data.getStockLevels;
      if (Array.isArray(data.stockLevels)) return data.stockLevels;
      if (Array.isArray(data.getStockLevels)) return data.getStockLevels;
      if (Array.isArray(data.locations)) return data.locations;
      return [];
    }

    function toLocationNameFromStockItem(item) {
      if (!item || typeof item !== 'object') return null;
      if (item.location && typeof item.location === 'object' && item.location.name) {
        return item.location.name;
      }
      return item.locationName || item.location_name || item.location || item.name || item.storeName || item.store_name || null;
    }

    function toAvailableQtyFromStockItem(item) {
      if (!item || typeof item !== 'object') return null;

      if (Array.isArray(item.quantities)) {
        var availableNode = item.quantities.find(function (q) {
          return q && String(q.name || '').toLowerCase() === 'available';
        });
        if (availableNode && isFinite(Number(availableNode.quantity))) {
          return Number(availableNode.quantity);
        }
      }

      var value =
        item.inventoryAvailable ??
        item.inventory_available ??
        item.available ??
        item.quantityAvailable ??
        item.quantity_available ??
        item.quantity ??
        item.stock;
      var n = Number(value);
      return isFinite(n) ? n : null;
    }

    function addLocationIdCandidates(target, locationId) {
      var rawId = String(locationId || '').trim();
      if (!rawId) return;
      if (target.indexOf(rawId) === -1) target.push(rawId);

      if (/^\d+$/.test(rawId)) {
        var gid = 'gid://shopify/Location/' + rawId;
        if (target.indexOf(gid) === -1) target.push(gid);
        return;
      }

      var gidMatch = rawId.match(/gid:\/\/shopify\/Location\/(\d+)/i);
      if (gidMatch && gidMatch[1] && target.indexOf(gidMatch[1]) === -1) {
        target.push(gidMatch[1]);
      }
    }

    function getStockLookupCandidates(selectedName, selectedId) {
      var candidates = [];
      var normalizedName = normalizeKey(selectedName);
      if (normalizedName) candidates.push(normalizedName);

      var noRussoPrefix = normalizeKey(String(selectedName || '').replace(/^russo\s+/i, ''));
      if (noRussoPrefix && candidates.indexOf(noRussoPrefix) === -1) {
        candidates.push(noRussoPrefix);
      }

      addLocationIdCandidates(candidates, selectedId);
      return candidates;
    }

    function buildStockMaps(items) {
      var stockMap = {};
      var qtyMap = {};

      (items || []).forEach(function (item) {
        var locationName = toLocationNameFromStockItem(item);
        if (!locationName) return;

        var qty = toAvailableQtyFromStockItem(item);
        if (qty === null) return;

        var normalizedName = normalizeKey(locationName);
        stockMap[normalizedName] = qty > 0;
        qtyMap[normalizedName] = qty;

        var noRussoPrefixName = normalizeKey(String(locationName || '').replace(/^russo\s+/i, ''));
        if (noRussoPrefixName) {
          stockMap[noRussoPrefixName] = qty > 0;
          qtyMap[noRussoPrefixName] = qty;
        }

        if (item.location && item.location.id) {
          var locationId = String(item.location.id);
          stockMap[locationId] = qty > 0;
          qtyMap[locationId] = qty;
        }
      });

      return { stockMap: stockMap, qtyMap: qtyMap };
    }

    function getLiveStockMapsForVariant(variantId) {
      var id = String(variantId || '').trim();
      if (!id) return Promise.resolve(null);

      var cache = window.__PreferredStoreVariantStockCache || {};
      if (cache[id]) return Promise.resolve(cache[id]);

      var cfg = window.__PreferredStoreConfig || {};
      var endpoints = buildStockEndpointCandidates(cfg.stockLevelsEndpoint || '/apps/russoAPI/v1/getStockLevels');
      var requestInit = {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          variantId: id,
          variant_id: id
        })
      };

      return fetchJsonWithFallback(endpoints, requestInit)
        .then(function (result) {
          var items = extractStockItems(result.data);
          var mapped = buildStockMaps(items);
          cache[id] = mapped;
          window.__PreferredStoreVariantStockCache = cache;
          return mapped;
        })
        .catch(function () {
          return null;
        });
    }

    function getLiveStockForSelectedStore(mapped, selectedName, selectedId) {
      if (!mapped || !mapped.stockMap || !mapped.qtyMap) return null;
      var candidates = getStockLookupCandidates(selectedName, selectedId);

      for (var i = 0; i < candidates.length; i += 1) {
        var candidate = candidates[i];
        if (Object.prototype.hasOwnProperty.call(mapped.stockMap, candidate)) {
          return {
            inStock: !!mapped.stockMap[candidate],
            qty: mapped.qtyMap[candidate]
          };
        }
      }

      return null;
    }

    function buildPreferredStoreStatusLabel(options) {
      var shared = window.__PreferredStoreShared;
      if (shared && typeof shared.buildPreferredStoreStatusLabel === 'function') {
        return shared.buildPreferredStoreStatusLabel(options);
      }

      var opts = options || {};
      return {
        text: String(opts.defaultLabel || 'Choose a Store'),
        showSpecialOrder: false,
        specialOrderLabel: '',
        specialOrderTitle: '',
        specialOrderBody: ''
      };
    }

    // Display-only status label for the PDP button.
    // Uses selected store cookie + live proxy stock only.
    function updateButtonLabel() {
      var fallbackLabel = {{ preferred_store_default_label | json }};
      var showStatusLabel = {{ preferred_store_show_status_label | json }};

      if (!showStatusLabel) {
        setButtonLabelContent(buildPreferredStoreStatusLabel({
          status: 'default',
          defaultLabel: fallbackLabel
        }));
        setStatusIcon(null);
        return;
      }

      var selectedName = getCookie('preferred_store_location_name');
      if (!selectedName) {
        setButtonLabelContent(buildPreferredStoreStatusLabel({
          status: 'default',
          defaultLabel: fallbackLabel
        }));
        setStatusIcon(null);
        return;
      }

      var unavailableDisplayMode = root.dataset && root.dataset.preferredStoreUnavailableDisplayMode
        ? String(root.dataset.preferredStoreUnavailableDisplayMode)
        : 'custom_tooltip';
      var unavailableLabel = root.dataset && root.dataset.preferredStoreUnavailableLabel
        ? String(root.dataset.preferredStoreUnavailableLabel)
        : 'Special Order';
      var unavailableTooltipTitle = root.dataset && root.dataset.preferredStoreUnavailableTooltipTitle
        ? String(root.dataset.preferredStoreUnavailableTooltipTitle)
        : unavailableLabel;
      var unavailableTooltipBody = root.dataset && root.dataset.preferredStoreUnavailableTooltipBody
        ? String(root.dataset.preferredStoreUnavailableTooltipBody)
        : 'Unavailable at {store}. Contact us to place a special order.';

      var selectedId = getCookie('preferred_store_location_id');
      var variantId =
        (window.__PreferredStoreProductContext && window.__PreferredStoreProductContext.variantId) ||
        (openBtn && openBtn.dataset ? openBtn.dataset.preferredStoreVariantId : null) ||
        {{ preferred_store_variant.id | json }};

      getLiveStockMapsForVariant(variantId)
        .then(function (mapped) {
          var live = getLiveStockForSelectedStore(mapped, selectedName, selectedId);
          if (live) {
            setStatusIcon(live.inStock);
            setButtonLabelContent(buildPreferredStoreStatusLabel({
              status: live.inStock ? 'available' : 'unavailable',
              selectedName: selectedName,
              defaultLabel: fallbackLabel,
              unavailableDisplayMode: unavailableDisplayMode,
              unavailableLabel: unavailableLabel,
              unavailableTooltipTitle: unavailableTooltipTitle,
              unavailableTooltipBody: unavailableTooltipBody
            }));
            return;
          }

          setStatusIcon(null);
          setButtonLabelContent(buildPreferredStoreStatusLabel({
            status: 'unknown',
            selectedName: selectedName,
            defaultLabel: fallbackLabel
          }));
        })
        .catch(function () {
          setStatusIcon(null);
          setButtonLabelContent(buildPreferredStoreStatusLabel({
            status: 'unknown',
            selectedName: selectedName,
            defaultLabel: fallbackLabel
          }));
        });
    }

    if (autoStatusFetch) {
      updateButtonLabel();
    }

    var openBtn = root.querySelector('[data-preferred-store-open]');
    if (openBtn && !openBtn.__preferredStoreBound) {
      openBtn.__preferredStoreBound = true;
      // Click path: set current variant context, then open the global preferred-store drawer.
      // Drawer code in russo-preferred-store-main.js performs the main getStockLevels request.
      openBtn.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();

        var variantId = openBtn.dataset ? openBtn.dataset.preferredStoreVariantId : null;

        window.__PreferredStoreProductContext = {
          variantId: variantId || {{ preferred_store_variant.id | json }},
          locations: locations
        };

        console.info('Preferred store: PDP direct button clicked', {
          variantId: window.__PreferredStoreProductContext.variantId,
          hasGlobalOpener: typeof window.__PreferredStoreOpen === 'function',
          hasDirectApi: !!(window.__PreferredStoreAPI && typeof window.__PreferredStoreAPI.open === 'function')
        });

        // Deterministic probe: this exact button click attempts stock fetch directly.
        // It removes ambiguity about whether main drawer scripts were reached.
        (function () {
          var cfg = window.__PreferredStoreConfig || {};
          var endpoint = cfg.stockLevelsEndpoint || '/apps/russoAPI/v1/getStockLevels';
          var variant = String(window.__PreferredStoreProductContext.variantId || '');
          if (!variant) {
            console.warn('Preferred store probe: missing variant id, skipping direct fetch');
            return;
          }

          var joiner = endpoint.indexOf('?') === -1 ? '?' : '&';
          var url = endpoint + joiner + 'source=pdp-trigger';
          console.info('Preferred store probe: requesting (POST)', {
            url: url,
            body: { variantId: variant }
          });

          fetch(url, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              variantId: variant,
              variant_id: variant
            })
          })
            .then(function (res) {
              return res.text().then(function (raw) {
                console.info('Preferred store probe: response', {
                  ok: res.ok,
                  status: res.status,
                  sample: String(raw || '').slice(0, 180)
                });
              });
            })
            .catch(function (err) {
              console.error('Preferred store probe: request failed', err);
            });
        })();

        if (typeof window.__PreferredStoreOpen === 'function') {
          window.__PreferredStoreOpen({
            variantId: window.__PreferredStoreProductContext.variantId,
            locations: locations
          });
          return;
        }

        if (window.__PreferredStoreAPI && typeof window.__PreferredStoreAPI.open === 'function') {
          window.__PreferredStoreAPI.open();
          return;
        }

        console.warn('Preferred store: no opener available on PDP button click');
      });
    }

    if (autoStatusFetch) {
      document.addEventListener('preferred-store-drawer:close', updateButtonLabel);
      document.addEventListener('shopify:section:load', updateButtonLabel);
    }
  })();
</script>
