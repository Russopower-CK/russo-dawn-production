{%- assign customer_has_order_form = false -%}
{%- assign product_in_order_form = false -%}
{%- assign is_b2b = customer.b2b? %}

{%- if is_b2b -%}
  {%- assign customer_has_order_form = true -%}
  {%- assign order_form_collection = customer.metafields.custom.order_form_collection.value -%}
  {%- assign order_form_favorites = customer.metafields.custom.order_form_favorites.value -%}

  {%- assign product_in_order_form = false -%}
  {%- for c in product.collections -%}
    {%- if c.handle == order_form_collection.handle -%}
      {%- assign product_in_order_form = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if product_in_order_form == false -%}
    {% for id in order_form_favorites %}
      {%- if id.id == product.id -%}
        {%- assign product_in_order_form = true -%}
      {%- endif -%}
    {% endfor %}
  {%- endif -%}
{%- endif -%}

<div
  id="of-wrap-{{ product.id }}"
  class="orderform-buttons"
  data-product-id="{{ product.id }}"
  data-in-order-form="{{ product_in_order_form }}"
>
  <button
    type="button"
    class="orderform-btn of-add button"
    data-action="add"
    {% if product_in_order_form %}
      disabled aria-disabled="true"
    {% endif %}
  >
    {{ add_label | default: 'Add to Favorites' }}
  </button>

  <button
    type="button"
    class="orderform-btn of-remove button"
    data-action="remove"
    {% unless product_in_order_form %}
      disabled aria-disabled="true"
    {% endunless %}
  >
    {{ remove_label | default: 'Remove from Favorites' }}
  </button>

  <div class="orderform-msg" aria-live="polite" style="display:none;"></div>
</div>

<style>
  /* Russo Power Branding Variables */
  :root {
    --russo-red: #e31e24;
    --russo-red-dark: #b21217; /* Darker shade for hover */
    --russo-green: #0a7d36;
    --russo-green-dark: #08612a; /* Darker shade for hover */
    --russo-black: #231f20;
  }

  .orderform-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 12px;
    margin: 15px 0;
    width: 100%;
    justify-content: space-between;
  }

  /* Add Button: Green to Dark Green */
  .orderform-btn.of-add {
    background-color: var(--russo-green);
    border: 0px;
    width: 100%;
  }

  .orderform-btn.of-add:hover:not(:disabled) {
    background-color: var(--russo-green-dark);
  }

  /* Remove Button: Russo Red to Dark Red */
  .orderform-btn.of-remove {
    background-color: var(--russo-red);
    width: 100%;
  }

  .orderform-btn.of-remove:hover:not(:disabled) {
    background-color: var(--russo-red-dark);
  }

  /* Disabled State */
  .orderform-btn:disabled {
    background-color: #e5e5e5;
    color: #999;
    cursor: not-allowed;
  }

  /* Messages */
  .orderform-msg {
    width: 100%;
    font-size: 13px;
    margin-top: 10px;
    padding: 10px 15px;
    border-radius: 4px;
    font-weight: 500;
  }
  .orderform-msg.success {
    background: #f0fff4;
    color: #1a7a33;
    border: 1px solid #c6f6d5;
  }
  .orderform-msg.error {
    background: #fff5f5;
    color: var(--russo-red);
    border: 1px solid #feb2b2;
  }

  /* Mobile Responsive Adjustments */
  @media (max-width: 768px) {
    .orderform-buttons {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .orderform-btn {
      width: 100%;
    }
  }
</style>

<script>
  (function () {
    // Target the specific wrapper instance generated by this snippet
    const wrapperId = 'of-wrap-{{ product.id }}';
    const wrap = document.getElementById(wrapperId);
    if (!wrap || wrap.dataset.initialized === 'true') return;
    wrap.dataset.initialized = 'true';

    const ENDPOINT = '/apps/russoAPI/v1/' + encodeURIComponent('orderform');

    wrap.addEventListener('click', async (evt) => {
      const btn = evt.target.closest('.orderform-btn');
      if (!btn || btn.disabled) return;

      const productId = wrap.getAttribute('data-product-id');
      const actionType = btn.getAttribute('data-action');
      const msg = wrap.querySelector('.orderform-msg');

      if (!productId || !actionType) return;

      const originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Processing...';
      if (msg) msg.style.display = 'none';

      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ actionType, productId }),
        });

        let data = null;
        try {
          data = await res.json();
        } catch (_e) {}

        if (res.ok && data && (data.success || data.ok)) {
          const addBtn = wrap.querySelector('.orderform-btn.of-add');
          const removeBtn = wrap.querySelector('.orderform-btn.of-remove');

          if (actionType === 'add') {
            if (addBtn) {
              addBtn.disabled = true;
              addBtn.setAttribute('aria-disabled', 'true');
            }
            if (removeBtn) {
              removeBtn.disabled = false;
              removeBtn.removeAttribute('aria-disabled');
            }
          } else {
            if (addBtn) {
              addBtn.disabled = false;
              addBtn.removeAttribute('aria-disabled');
            }
            if (removeBtn) {
              removeBtn.disabled = true;
              removeBtn.setAttribute('aria-disabled', 'true');
            }
          }

          if (msg) {
            msg.textContent = actionType === 'add' ? 'Added to order form.' : 'Removed from order form.';
            msg.className = 'orderform-msg success';
            msg.style.display = 'block';
          }
        } else {
          if (msg) {
            msg.textContent = 'Update failed. Please try again.';
            msg.className = 'orderform-msg error';
            msg.style.display = 'block';
          }
        }
      } catch (err) {
        if (msg) {
          msg.textContent = 'Network error.';
          msg.className = 'orderform-msg error';
          msg.style.display = 'block';
        }
      } finally {
        btn.textContent = originalText;
      }
    });
  })();
</script>
