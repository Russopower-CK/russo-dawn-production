{%- assign product_in_order_form = false -%}
{%- assign is_b2b = customer.b2b? %}

{%- if is_b2b -%}
  {%- assign order_form_collection = customer.metafields.custom.order_form_collection.value -%}
  {%- assign order_form_favorites = customer.metafields.custom.order_form_favorites.value -%}

  {%- assign product_in_order_form = false -%}
  {%- for c in product.collections -%}
    {%- if c.handle == order_form_collection.handle -%}
      {%- assign product_in_order_form = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if product_in_order_form == false -%}
    {% for id in order_form_favorites %}
      {%- if id.id == product.id -%}
        {%- assign product_in_order_form = true -%}
      {%- endif -%}
    {% endfor %}
  {%- endif -%}
{%- endif -%}

{% if settings.use_russo_favorites %}
  <div
    class="orderform-buttons"
    data-orderform-buttons
    data-product-id="{{ product.id }}"
    data-in-order-form="{{ product_in_order_form | json }}"
    data-add-label="{{ add_label | default: 'Add to Favorites' | escape }}"
    data-remove-label="{{ remove_label | default: 'Remove from Favorites' | escape }}"
    data-processing-label="{{ processing_label | default: 'Processing...' | escape }}"
    data-success-add="{{ success_add_message | default: 'Added to order form.' | escape }}"
    data-success-remove="{{ success_remove_message | default: 'Removed from order form.' | escape }}"
    data-error-message="{{ error_message | default: 'Update failed. Please try again.' | escape }}"
    data-network-error-message="{{ network_error_message | default: 'Network error.' | escape }}"
  >
    <button
      type="button"
      class="orderform-btn of-add button"
      data-action="add"
      {% if product_in_order_form %}
        disabled aria-disabled="true"
      {% endif %}
    >
      {{ add_label | default: 'Add to Favorites' }}
    </button>

    <button
      type="button"
      class="orderform-btn of-remove button"
      data-action="remove"
      {% unless product_in_order_form %}
        disabled aria-disabled="true"
      {% endunless %}
    >
      {{ remove_label | default: 'Remove from Favorites' }}
    </button>

    <div class="orderform-msg" aria-live="polite" style="display:none;"></div>
  </div>
{% endif %}
