{{ 'back-to-top.css' | asset_url | stylesheet_tag }}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const container = document.querySelector('[data-back-to-top]');
    const button = container?.querySelector('button');

    if (button) {
      button.addEventListener('click', function () {
        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });
      });

      button.addEventListener('mouseenter', function () {
        if (window.matchMedia('(min-width: 860px)').matches) {
          button.setAttribute('data-top-hover', 'true');
        }
      });

      button.addEventListener('mouseleave', function () {
        button.removeAttribute('data-top-hover');
      });
    }

    if (container) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          container.setAttribute('data-animation-state', 'visible');
        } else {
          container.setAttribute('data-animation-state', 'hidden');
        }
      });
    }
  });
</script>
<div
  class="back-to-top"
  data-back-to-top
>
  <button class="back-to-top__button button">
    <span
      class="
        back-to-top__button-label
        back-to-top__button-label--mobile
      "
    >
      {{- 'general.back_to_top_button.mobile_button_label' | t -}}
    </span>

    <span
      data-back-to-top-hover-label
      aria-hidden="true"
      style="font-family: Roboto, sans-serif; font-size: 12px; font-style: normal; font-weight: 700; line-height: 1;"
    >
      TOP
    </span>

    {% render 'icon-chevron-down-small' %}
  </button>
</div>
