      </tbody>

      {% comment %} ===== TOTALS ROW ===== {% endcomment %}
      <tfoot>
        <tr class="totals-row">
          <td colspan="6"><strong>Annual Totals</strong></td>
          <td id="total-lbs-nitrogen">
            --<br>
            <small>Annual lbs of Nitrogen</small>
          </td>
          <td id="total-bags-needed">
            --<br>
            <small>Annual bags needed</small>
          </td>
