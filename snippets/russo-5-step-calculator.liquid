</div>

{% comment %} ===== CALCULATOR JAVASCRIPT WITH EMBEDDED PRODUCT DATA ===== {% endcomment %}
<script>
  // =============================================
  // PRODUCT DATABASE - From Excel Products Sheet
  // =============================================
  const productDatabase = {
    "Pre-Emergent / Fertilizer Combo's": [
      { sku: '10000324SPR', name: '13-0-0 25% Regain 0.125% Dimension / 50 lb', coverage: 12500, nitrogen: 13 },
      { sku: '10009856AND', name: '18-0-4 20% Fortify-N 0.38% Prodiamine (Barricade)', coverage: 12500, nitrogen: 18 },
      { sku: '19000297SPR', name: '19-0-0 25% Regain 0.37% Prodiamine (Barricade)', coverage: 12500, nitrogen: 19 },
      { sku: '10008159AND', name: '22-0-4 20% PCSCU 0.38% Prodiamine / 50 Lb', coverage: 12500, nitrogen: 22 },
    ],
    'Straight Fertilizer': [
      { sku: '910230BCA', name: "15-0-3 20% PCSCU, 10% AS, Bio-Sold Organic + Micro's", coverage: 10000, nitrogen: 15 },
      { sku: 'RUS187UFEB5AND', name: '18-0-3 40% Fortify-N, Bio-Solid Organic, Iron', coverage: 12000, nitrogen: 18 },
      { sku: '902734TCS', name: '24-0-4 30% XCU, 2% FE / 50 lb', coverage: 12000, nitrogen: 24 },
      { sku: '907080TCS', name: '25-0-5 40% XCU, 2% FE, 10% Bio-Solid Organic / 50 lb', coverage: 12500, nitrogen: 25 },
      { sku: '907083TCS', name: '32-0-8 50% XCU, 2% FE / 50 lb', coverage: 16000, nitrogen: 32 },
      { sku: '901976TCS', name: '33-0-4 20% XCU / 50 Lb', coverage: 16500, nitrogen: 33 },
    ],
    'Starter Fertilizer': [
      { sku: '910048BCA', name: '10-10-10 (50% MinneGrow Organic)', coverage: 10000, nitrogen: 10 },
      { sku: '907082TCS', name: '11-23-10 All Mineral Starter Fertilizer / 50 lb', coverage: 12000, nitrogen: 11 },
      {
        sku: '907081TCS',
        name: '14-14-14 51% XCU, 1% FE, 25% Bio-Solid Organic / 50 lb',
        coverage: 10000,
        nitrogen: 14,
      },
      { sku: 'ASP21WMSFE4AND', name: '21-22-4 35% Mu W/0.08% Mesotrione', coverage: 9300, nitrogen: 21 },
    ],
    'Weed & Feed': [
      { sku: '2078459SPR', name: '20-0-5 25% Slow W/ Trimec Herbicide', coverage: 12000, nitrogen: 20 },
      { sku: '10000437SPR', name: '18-0-2 W/Regain W/ Surge Weed & Feed / 50 Lb', coverage: 12000, nitrogen: 18 },
      { sku: '2078595SPR', name: '19-0-5 W/Regain W/ Viper Weed & Feed / 50 Lb', coverage: 12000, nitrogen: 19 },
    ],
    Organic: [
      { sku: '900276BCA', name: '5-5-0 100% MinneGrow Biosolid 5%FE, 3%Ca,1%Mg 50lb', coverage: 5000, nitrogen: 5 },
      { sku: 'ASP133HU5.40AND', name: '13-0-3 25% SCU 10% AS, Humic Acid, Bio-Solid', coverage: 12000, nitrogen: 13 },
    ],
    Insecticide: [
      { sku: 'ASPK7GB5AND', name: '0-0-7 0.20% Grubout (Imidaclprid)', coverage: 12000, nitrogen: 0 },
      { sku: 'ASP15UGB.40AND', name: '15-0-4 25% Fortify-N W/ 0.20% GrubOut', coverage: 12000, nitrogen: 15 },
      { sku: 'ASP15UAC5.40AND', name: '15-0-5 50% Fortify-N 0.067% Acelepryn / 50 Lb', coverage: 11500, nitrogen: 15 },
      {
        sku: '2021300SPR',
        name: '17-0-4 30% PPSCU / Protego Insecticide / 50 lb (Imidacloprid & Lambda)',
        coverage: 12000,
        nitrogen: 17,
      },
      {
        sku: 'ASP21UGB5.40AND',
        name: '21-0-4 50% Fortify-N 0.20% Grubout (Imidaclprid)',
        coverage: 12000,
        nitrogen: 21,
      },
    ],
  };

  // Flat list for easy lookup by SKU
  const allProducts = {};
  Object.values(productDatabase).forEach((categoryProducts) => {
    categoryProducts.forEach((product) => {
      allProducts[product.sku] = product;
    });
  });

  // =============================================
  // CONSTANTS (from Excel formulas)
  // =============================================
  const SQ_FT_PER_ACRE = 43560;
  const BAG_WEIGHT_LBS = 50;
  const NITROGEN_MULTIPLIER = 10;

  // =============================================
  // ROUND DATA STORAGE
  // =============================================
  let roundData = {
    1: { coverage: 12500 },
    2: { coverage: 12000 },
    3: { coverage: 12000 },
    4: { coverage: 12000 },
    5: { coverage: 16000 },
  };

  // =============================================
  // POPULATE DROPDOWNS ON PAGE LOAD
  // =============================================
  function populateDropdowns() {
    for (let round = 1; round <= 5; round++) {
      const select = document.getElementById(`product-select-${round}`);

      // Add categories with products as optgroups
      Object.keys(productDatabase).forEach((category) => {
        const optgroup = document.createElement('optgroup');
        optgroup.label = category;

        productDatabase[category].forEach((product) => {
          const option = document.createElement('option');
          option.value = product.sku;
          option.textContent = `${product.sku} - ${product.name}`;
          option.dataset.name = product.name;
          option.dataset.coverage = product.coverage;
          option.dataset.nitrogen = product.nitrogen;
          optgroup.appendChild(option);
        });

        select.appendChild(optgroup);
      });
    }
  }

  // =============================================
  // UPDATE PRODUCT WHEN SELECTION CHANGES
  // =============================================
  function updateProduct(round) {
    const select = document.getElementById(`product-select-${round}`);
    const sku = select.value;

    if (sku && allProducts[sku]) {
      const product = allProducts[sku];

      // Update display fields
      document.getElementById(`product-name-${round}`).textContent = product.name;
      document.getElementById(`coverage-${round}`).textContent = product.coverage.toLocaleString();
      document.getElementById(`nitrogen-${round}`).value = product.nitrogen;

      // Store coverage for calculations
      roundData[round].coverage = product.coverage;
    } else {
      // Clear if no selection
      document.getElementById(`product-name-${round}`).textContent = '--';
      document.getElementById(`coverage-${round}`).textContent = '--';
    }

    calculateRow(round);
  }

  // =============================================
  // CALCULATE A SINGLE ROW
  // Excel formulas:
  //   H (LBS Nitrogen per 1,000 sq ft) = ((50 / E) * F) * 10
  //   I (Bags needed) = 43560 / E * acres
  //   J (Cost per acre) = G * I
  // =============================================
  function calculateRow(round) {
    const acres = parseFloat(document.getElementById('acres-input').value) || 0;
    const coverage = roundData[round].coverage || 12000;
    const nitrogen = parseFloat(document.getElementById(`nitrogen-${round}`).value) || 0;
    const price = parseFloat(document.getElementById(`price-${round}`).value) || 0;

    // Formula: =((50/E)*F)*10
    const lbsNitrogen = (BAG_WEIGHT_LBS / coverage) * nitrogen * NITROGEN_MULTIPLIER;

    // Formula: =43560/E*acres
    const bagsNeeded = (SQ_FT_PER_ACRE / coverage) * acres;

    // Formula: =G*I
    const costPerAcre = price * bagsNeeded;

    // Update display
    document.getElementById(`lbs-nitrogen-${round}`).textContent = lbsNitrogen.toFixed(2);
    document.getElementById(`bags-needed-${round}`).textContent = bagsNeeded.toFixed(2);
    document.getElementById(`cost-${round}`).textContent = '$' + costPerAcre.toFixed(2);

    // Recalculate totals
    calculateTotals();
  }

  // =============================================
  // CALCULATE ALL TOTALS (SUM formulas from row 8)
  // =============================================
  function calculateTotals() {
    let totalLbsNitrogen = 0;
    let totalBagsNeeded = 0;
    let totalCost = 0;

    for (let round = 1; round <= 5; round++) {
      const lbsNitrogen = parseFloat(document.getElementById(`lbs-nitrogen-${round}`).textContent) || 0;
      const bagsNeeded = parseFloat(document.getElementById(`bags-needed-${round}`).textContent) || 0;
      const costText = document.getElementById(`cost-${round}`).textContent.replace('$', '').replace(',', '');
      const cost = parseFloat(costText) || 0;

      totalLbsNitrogen += lbsNitrogen;
      totalBagsNeeded += bagsNeeded;
      totalCost += cost;
    }

    document.getElementById('total-lbs-nitrogen').innerHTML = `<strong>${totalLbsNitrogen.toFixed(
      2
    )}</strong><br><small>Annual lbs of Nitrogen</small>`;
    document.getElementById('total-bags-needed').innerHTML = `<strong>${totalBagsNeeded.toFixed(
      2
    )}</strong><br><small>Annual bags needed</small>`;
    document.getElementById('total-cost').innerHTML = `<strong>$${totalCost.toFixed(
      2
    )}</strong><br><small>Annual cost</small>`;
  }

  // =============================================
  // CALCULATE ALL ROWS
  // =============================================
  function calculateAll() {
    for (let round = 1; round <= 5; round++) {
      calculateRow(round);
    }
  }

  // =============================================
  // INITIALIZE ON PAGE LOAD
  // =============================================
  document.addEventListener('DOMContentLoaded', function () {
    populateDropdowns();
    calculateAll();
  });
</script>

