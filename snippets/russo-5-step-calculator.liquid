      {% comment %} ===== ROUND 3: Summer (June - July) ===== {% endcomment %}
      <tr class="round-row" data-round="3">
        <td class="round-label">
          Round - 3<br>
          <small>(June - July)</small>
        </td>
        <td>Summer Fertilizer & Grub Prevention</td>
        <td>
          <select class="product-select" id="product-select-3" onchange="updateProduct(3)">
            <option value="">-- Select Product --</option>
          </select>
        </td>
        <td class="product-name" id="product-name-3">--</td>
        <td class="bag-coverage" id="coverage-3">--</td>
        <td>
          <input
            type="number"
            class="nitrogen-input"
            id="nitrogen-3"
            value="15"
            min="0"
            max="100"
            onchange="calculateRow(3)"
          >
        </td>
        <td>
          <input
