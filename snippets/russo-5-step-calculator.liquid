{% comment %}
  ============================================
  FERTILIZER PROGRAM CALCULATOR - Shopify Liquid
  ============================================
  Product list comes from a passed collection handle
  Price display uses snippet `price.liquid`

  FORMULAS:
  - LBS Nitrogen per 1,000 sq ft = ((50 / bag_coverage) * nitrogen_percent) * 10
  - Bags Needed = (43560 / bag_coverage) * acres
  - Cost per Acre = price_per_bag * bags_needed
{% endcomment %}

{%- liquid
  assign calculator_collection_handle = collection_handle | default: blank
  assign calculator_email_endpoint = email_endpoint | default: '/apps/russoAPI/v1/fertilizer-calculator-email'
  assign calculator_collection = blank
  if calculator_collection_handle != blank
    assign calculator_collection = collections[calculator_collection_handle]
  endif
-%}
<div class="page-width">
  <div
    class="fertilizer-calculator"
    data-email-endpoint="{{ calculator_email_endpoint }}"
    data-collection-handle="{{ calculator_collection_handle | escape }}"
  >
    <h1>Fertilizer Program Calculator</h1>

    {% comment %} ===== USER INPUT SECTION ===== {% endcomment %}
    <div class="calculator-input" style="display: grid; grid-template-columns: auto auto">
      <div class="calculator-input-actions">
        <button type="button" class="button button--primary" data-print-calculator aria-haspopup="dialog">Print</button>
        <button type="button" class="button button--primary" data-email-calculator aria-haspopup="dialog">Email</button>
      </div>

      <div class="calculator-input-acres">
        <label for="acres-input">Acres being applied:</label>
        <input type="number" id="acres-input" name="acres" value="3" min="0.1" step="0.1" onchange="calculateAll()">
      </div>
    </div>

    <div class="calculator-email-panel" data-email-panel hidden style="justify-content: flex-end">
      <label for="calculator-email-input">Send results to email:</label>
      <div class="calculator-email-controls">
        <input
          type="email"
          id="calculator-email-input"
          data-email-input
          placeholder="name@example.com"
          autocomplete="email"
        >
        <button type="button" class="button button--primary" data-email-send>Send</button>
        <button type="button" class="button" data-email-cancel>Cancel</button>
      </div>
      <p class="calculator-email-status" data-email-status aria-live="polite"></p>
    </div>

    <p class="calculator-note">***Prices may vary per location and quantities purchased***</p>

    {% comment %} ===== CALCULATOR TABLE ===== {% endcomment %}
    <table class="program-table">
      <thead>
        <tr>
          <th>Round</th>
          <th>Item #</th>
          <th>Product</th>
          <th>Bag Coverage (sq ft)</th>
          <th>% of Nitrogen</th>
          <th>Price per Bag</th>
          <th>LBS of Nitrogen per 1,000 sq ft</th>
          <th>Bags Needed</th>
          <th>Cost per Acre</th>
        </tr>
      </thead>
      <tbody>
        {% comment %} ===== ROUND 1: Pre-Emergent (March - April) ===== {% endcomment %}
        <tr class="round-row" data-round="1">
          <td class="round-label" onclick="toggleRound(1)" role="button" tabindex="0" aria-expanded="true">
            Round - 1<br>
            <small>(March - April)</small>
          </td>
          <td class="item-cell">
            <div class="select">
              <select class="product-select select__select" id="product-select-1" onchange="updateProduct(1)">
                <option value="">-- Select Product --</option>
                {%- if calculator_collection != blank and calculator_collection.products_count > 0 -%}
                  {%- for product in calculator_collection.products -%}
                    {%- assign selected_variant = product.selected_or_first_available_variant -%}
                    {%- assign product_coverage = selected_variant.metafields.fertilizer.bag_coverage_sq_ft.value -%}
                    {%- assign product_nitrogen = selected_variant.metafields.fertilizer.nitrogen.value -%}
                    {% capture volume_pricing_json %}
                    [
                      {% for price_break in selected_variant.quantity_price_breaks %}
                        {
                          "minimum_quantity": {{ price_break.minimum_quantity }},
                          "price": {{ price_break.price }}
                        }
                        {% unless forloop.last %},{% endunless %}
                      {% endfor %}
                    ]
                  {% endcapture %}
                    <option
                      value="{{ selected_variant.sku | default: selected_variant.id }}"
                      data-name="{{ product.title | escape }}"
                      data-url="{{ product.url }}"
                      data-product-id="{{ product.id }}"
                      data-price="{{ selected_variant.price | times: 0.01 }}"
                      data-coverage="{{ product_coverage | default: '' }}"
                      data-nitrogen="{{ product_nitrogen | default: '' }}"
                      data-volume-pricing="{{ volume_pricing_json | strip_newlines | escape }}"
                    >
                      {{ product.title }}
                    </option>
                  {%- endfor -%}
                {%- endif -%}
              </select>
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </div>
          </td>
          <td class="product-name" id="product-name-1">--</td>
          <td class="bag-coverage" id="coverage-1">--</td>
          <td class="nitrogen-value" id="nitrogen-1">--</td>
          <td>
            <div class="price-display" id="price-display-1">--</div>
          </td>
          <td class="lbs-nitrogen" id="lbs-nitrogen-1">--</td>
          <td class="bags-needed" id="bags-needed-1">--</td>
          <td class="cost-per-acre" id="cost-1">--</td>
        </tr>

        {% comment %} ===== ROUND 2: Late Spring (May - June) ===== {% endcomment %}
