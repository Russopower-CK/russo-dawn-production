                  {%- endfor -%}
                {%- endif -%}
              </select>
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </div>
          </td>
          <td class="product-name" id="product-name-3">--</td>
          <td class="bag-coverage" id="coverage-3">--</td>
          <td class="nitrogen-value" id="nitrogen-3">--</td>
          <td>
            <div class="price-display" id="price-display-3">--</div>
          </td>
          <td class="lbs-nitrogen" id="lbs-nitrogen-3">--</td>
          <td class="bags-needed" id="bags-needed-3">--</td>
          <td class="cost-per-acre" id="cost-3">--</td>
        </tr>

        {% comment %} ===== ROUND 4: Late Summer (August - September) ===== {% endcomment %}
        <tr class="round-row" data-round="4">
          <td class="round-label" onclick="toggleRound(4)" role="button" tabindex="0" aria-expanded="true">
