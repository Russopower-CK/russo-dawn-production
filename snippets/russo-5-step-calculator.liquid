                    </option>
                  {%- endfor -%}
                {%- endif -%}
              </select>
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </div>
          </td>
          <td class="product-name" id="product-name-2">--</td>
          <td class="bag-coverage" id="coverage-2">--</td>
          <td class="nitrogen-value" id="nitrogen-2">--</td>
          <td>
            <div class="price-display" id="price-display-2">--</div>
          </td>
          <td class="lbs-nitrogen" id="lbs-nitrogen-2">--</td>
          <td class="bags-needed" id="bags-needed-2">--</td>
          <td class="cost-per-acre" id="cost-2">--</td>
        </tr>

