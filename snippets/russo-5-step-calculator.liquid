{% comment %}
  ============================================
  FERTILIZER PROGRAM CALCULATOR - Shopify Liquid
  ============================================
  Self-contained calculator with embedded product database
  No Shopify collections or metafields required

  FORMULAS:
  - LBS Nitrogen per 1,000 sq ft = ((50 / bag_coverage) * nitrogen_percent) * 10
  - Bags Needed = (43560 / bag_coverage) * acres
  - Cost per Acre = price_per_bag * bags_needed
{% endcomment %}

<div class="fertilizer-calculator">
  <h1>Fertilizer Program Calculator</h1>

  {% comment %} ===== USER INPUT SECTION ===== {% endcomment %}
  <div class="calculator-input">
    <label for="acres-input">Acres being applied:</label>
    <input type="number" id="acres-input" name="acres" value="3" min="0.1" step="0.1" onchange="calculateAll()">
  </div>

  <p class="calculator-note">***Fill in grey shaded areas first***</p>

  {% comment %} ===== CALCULATOR TABLE ===== {% endcomment %}
  <table class="program-table">
    <thead>
      <tr>
        <th>Round</th>
        <th>Description</th>
        <th>Item #</th>
        <th>Product</th>
        <th>Bag Coverage (sq ft)</th>
        <th>% of Nitrogen</th>
        <th>Price per Bag</th>
        <th>LBS of Nitrogen per 1,000 sq ft</th>
        <th>Bags Needed</th>
        <th>Cost per Acre</th>
      </tr>
    </thead>
    <tbody>
      {% comment %} ===== ROUND 1: Pre-Emergent (March - April) ===== {% endcomment %}
      <tr class="round-row" data-round="1">
        <td class="round-label">
          Round - 1<br>
          <small>(March - April)</small>
        </td>
        <td>Pre-Emergent Crabgrass Prevention</td>
        <td>
          <select class="product-select" id="product-select-1" onchange="updateProduct(1)">
            <option value="">-- Select Product --</option>
          </select>
        </td>
        <td class="product-name" id="product-name-1">--</td>
        <td class="bag-coverage" id="coverage-1">--</td>
        <td>
          <input
            type="number"
            class="nitrogen-input"
            id="nitrogen-1"
            value="18"
            min="0"
            max="100"
            onchange="calculateRow(1)"
          >
        </td>
        <td>
          <input
            type="number"
            class="price-input"
            id="price-1"
            value="22.00"
            min="0"
            step="0.01"
            onchange="calculateRow(1)"
          >
        </td>
        <td class="lbs-nitrogen" id="lbs-nitrogen-1">--</td>
        <td class="bags-needed" id="bags-needed-1">--</td>
        <td class="cost-per-acre" id="cost-1">--</td>
      </tr>

      {% comment %} ===== ROUND 2: Late Spring (May - June) ===== {% endcomment %}
      <tr class="round-row" data-round="2">
        <td class="round-label">
          Round - 2<br>
          <small>(May - June)</small>
        </td>
        <td>Late Spring Feeding</td>
        <td>
          <select class="product-select" id="product-select-2" onchange="updateProduct(2)">
            <option value="">-- Select Product --</option>
          </select>
        </td>
        <td class="product-name" id="product-name-2">--</td>
        <td class="bag-coverage" id="coverage-2">--</td>
        <td>
          <input
            type="number"
            class="nitrogen-input"
            id="nitrogen-2"
            value="18"
            min="0"
