          <td class="product-name" id="product-name-5">--</td>
          <td class="bag-coverage" id="coverage-5">--</td>
          <td class="nitrogen-value" id="nitrogen-5">--</td>
          <td>
            <div class="price-display" id="price-display-5">--</div>
          </td>
          <td class="lbs-nitrogen" id="lbs-nitrogen-5">--</td>
