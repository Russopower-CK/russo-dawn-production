    {%- if calculator_collection == blank or calculator_collection.products_count == 0 -%}
      <p class="calculator-warning">
        Calculator is missing a valid collection. Render with:
        <code>{% raw %}{% render 'russo-5-step-calculator', collection_handle: 'your-handle' %}{% endraw %}</code>
      </p>
    {%- endif -%}

    <div class="calculator-price-templates" aria-hidden="true" hidden>
      {%- if calculator_collection != blank and calculator_collection.products_count > 0 -%}
        {%- for product in calculator_collection.products -%}
          <div id="price-template-{{ product.id }}">
            {% render 'price',
              product: product,
              use_variant: true,
              show_badges: false,
              show_compare_at_price: false,
              show_volume_pricing: true
            %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>
{% comment %} ===== CALCULATOR JAVASCRIPT ===== {% endcomment %}
<script>
  // =============================================
  // CONSTANTS (from Excel formulas)
  // =============================================
  const SQ_FT_PER_ACRE = 43560;
  const BAG_WEIGHT_LBS = 50;
  const NITROGEN_MULTIPLIER = 10;

  // =============================================
  // ROUND DATA STORAGE
  // =============================================
  let roundData = {
    1: { selected: false, coverage: 0, nitrogen: 0, price: 0 },
    2: { selected: false, coverage: 0, nitrogen: 0, price: 0 },
    3: { selected: false, coverage: 0, nitrogen: 0, price: 0 },
    4: { selected: false, coverage: 0, nitrogen: 0, price: 0 },
    5: { selected: false, coverage: 0, nitrogen: 0, price: 0 },
  };

  // =============================================
  // UPDATE PRODUCT WHEN SELECTION CHANGES
  // =============================================
  function updateProduct(round) {
    const select = document.getElementById(`product-select-${round}`);
    const selectedOption = select.options[select.selectedIndex];
    if (selectedOption && selectedOption.value) {
      const coverageValue = parseFloat(selectedOption.dataset.coverage);
      const nitrogenValue = parseFloat(selectedOption.dataset.nitrogen);
      const priceValue = parseFloat(selectedOption.dataset.price) || 0;
      const productId = selectedOption.dataset.productId;
      const productUrl = selectedOption.dataset.url;
      const priceTemplate = document.getElementById(`price-template-${productId}`);

      // Update display fields
      if (productUrl) {
        document.getElementById(`product-name-${round}`).innerHTML = `<a href="${productUrl}">${
          selectedOption.dataset.name || '--'
        }</a>`;
      } else {
        document.getElementById(`product-name-${round}`).textContent = selectedOption.dataset.name || '--';
      }
      document.getElementById(`coverage-${round}`).textContent = Number.isFinite(coverageValue)
        ? coverageValue.toLocaleString()
        : '--';

      document.getElementById(`nitrogen-${round}`).textContent = Number.isFinite(nitrogenValue)
        ? nitrogenValue.toString()
        : '--';

      if (priceTemplate) {
        document.getElementById(`price-display-${round}`).innerHTML = priceTemplate.innerHTML;
      } else {
        document.getElementById(`price-display-${round}`).textContent = '--';
      }

      // Store coverage for calculations
      roundData[round].selected = true;
      roundData[round].coverage = Number.isFinite(coverageValue) && coverageValue > 0 ? coverageValue : 0;
      roundData[round].nitrogen = Number.isFinite(nitrogenValue) ? nitrogenValue : 0;
      roundData[round].price = priceValue;
    } else {
      // Clear if no selection
      document.getElementById(`product-name-${round}`).textContent = '--';
      document.getElementById(`coverage-${round}`).textContent = '--';
      document.getElementById(`nitrogen-${round}`).textContent = '--';
      document.getElementById(`price-display-${round}`).textContent = '--';
      roundData[round].selected = false;
      roundData[round].coverage = 0;
      roundData[round].nitrogen = 0;
      roundData[round].price = 0;
    }

    calculateRow(round);
  }

  // =============================================
  // CALCULATE A SINGLE ROW
  // Excel formulas:
  //   H (LBS Nitrogen per 1,000 sq ft) = ((50 / E) * F) * 10
  //   I (Bags needed) = 43560 / E * acres
  //   J (Cost per acre) = G * I
  // =============================================
  function calculateRow(round) {
    const acres = parseFloat(document.getElementById('acres-input').value) || 0;
    const isSelected = roundData[round].selected;
    const coverage = roundData[round].coverage;
    const nitrogen = roundData[round].nitrogen || 0;
    const price = roundData[round].price || 0;

    if (!isSelected || !coverage) {
      document.getElementById(`lbs-nitrogen-${round}`).textContent = '--';
      document.getElementById(`bags-needed-${round}`).textContent = '--';
      document.getElementById(`cost-${round}`).textContent = '--';
      calculateTotals();
      return;
    }

    // Formula: =((50/E)*F)*10
    const lbsNitrogen = (BAG_WEIGHT_LBS / coverage) * nitrogen * NITROGEN_MULTIPLIER;

    // Formula: =43560/E*acres
    const bagsNeeded = (SQ_FT_PER_ACRE / coverage) * acres;

    // Formula: =G*I
    const costPerAcre = price * bagsNeeded;

    // Update display
    document.getElementById(`lbs-nitrogen-${round}`).textContent = lbsNitrogen.toFixed(2);
    document.getElementById(`bags-needed-${round}`).textContent = bagsNeeded.toFixed(2);
    document.getElementById(`cost-${round}`).textContent = '$' + costPerAcre.toFixed(2);

    // Recalculate totals
    calculateTotals();
  }

  // =============================================
  // CALCULATE ALL TOTALS (SUM formulas from row 8)
  // =============================================
  function calculateTotals() {
    let totalLbsNitrogen = 0;
    let totalBagsNeeded = 0;
    let totalCost = 0;
    let selectedRows = 0;

    for (let round = 1; round <= 5; round++) {
      const lbsNitrogen = parseFloat(document.getElementById(`lbs-nitrogen-${round}`).textContent) || 0;
      const bagsNeeded = parseFloat(document.getElementById(`bags-needed-${round}`).textContent) || 0;
      const costCellText = document.getElementById(`cost-${round}`).textContent;
      const costText = costCellText.replace('$', '').replace(',', '');
      const cost = parseFloat(costText) || 0;

      if (roundData[round].selected) {
        selectedRows += 1;
      }

      totalLbsNitrogen += lbsNitrogen;
      totalBagsNeeded += bagsNeeded;
      totalCost += cost;
    }

    if (!selectedRows) {
      document.getElementById('total-lbs-nitrogen').innerHTML = '--<br><small>Annual lbs of Nitrogen</small>';
      document.getElementById('total-bags-needed').innerHTML = '--<br><small>Annual bags needed</small>';
      document.getElementById('total-cost').innerHTML = '--<br><small>Annual cost</small>';
      return;
    }

    document.getElementById('total-lbs-nitrogen').innerHTML = `<strong>${totalLbsNitrogen.toFixed(
      2
    )}</strong><br><small>Annual lbs of Nitrogen</small>`;
    document.getElementById('total-bags-needed').innerHTML = `<strong>${totalBagsNeeded.toFixed(
      2
    )}</strong><br><small>Annual bags needed</small>`;
    document.getElementById('total-cost').innerHTML = `<strong>$${totalCost.toFixed(
      2
    )}</strong><br><small>Annual cost</small>`;
  }

  // =============================================
  // CALCULATE ALL ROWS
  // =============================================
  function calculateAll() {
    for (let round = 1; round <= 5; round++) {
      calculateRow(round);
    }
  }

  // =============================================
  // TOGGLE ROUND COLLAPSE/EXPAND
  // =============================================
  function isMobileView() {
    return window.matchMedia('(max-width: 768px)').matches;
  }

  function expandAllRoundsForDesktop() {
    const roundRows = document.querySelectorAll('.round-row');
    roundRows.forEach((row) => {
      row.classList.remove('is-collapsed');
      const roundLabelCell = row.querySelector('.round-label');
      if (roundLabelCell) {
        roundLabelCell.removeAttribute('colspan');
        roundLabelCell.setAttribute('aria-expanded', 'true');
      }
    });
  }

  function toggleRound(round) {
    if (!isMobileView()) return;

    const row = document.querySelector(`.round-row[data-round="${round}"]`);
    if (!row) return;

    const isCollapsed = row.classList.toggle('is-collapsed');
    const roundLabelCell = row.querySelector('.round-label');
    const totalColumns = row.cells.length;

    if (roundLabelCell) {
      if (isCollapsed) {
        roundLabelCell.setAttribute('colspan', String(totalColumns));
      } else {
        roundLabelCell.removeAttribute('colspan');
      }

      roundLabelCell.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
    }
  }

  function setRoundCollapsedState(round, collapsed) {
    const row = document.querySelector(`.round-row[data-round="${round}"]`);
    if (!row) return;

    const roundLabelCell = row.querySelector('.round-label');
    const totalColumns = row.cells.length;

    row.classList.toggle('is-collapsed', collapsed);

    if (roundLabelCell) {
      if (collapsed) {
        roundLabelCell.setAttribute('colspan', String(totalColumns));
      } else {
        roundLabelCell.removeAttribute('colspan');
      }

      roundLabelCell.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    }
  }

  function handlePrintCalculator(event) {
    const collapsedRounds = [];
    const printRoot =
      event?.currentTarget?.closest('.fertilizer-calculator') || document.querySelector('.fertilizer-calculator');

    document.querySelectorAll('.round-row.is-collapsed').forEach((row) => {
      collapsedRounds.push(row.dataset.round);
    });

    if (printRoot) {
      document.querySelectorAll('.fertilizer-calculator.is-print-target').forEach((node) => {
        node.classList.remove('is-print-target');
      });
      printRoot.classList.add('is-print-target');
    }

    document.body.classList.add('print-calculator-only');

    expandAllRoundsForDesktop();

    const restoreCollapsedRounds = function () {
      if (isMobileView()) {
        collapsedRounds.forEach((round) => setRoundCollapsedState(round, true));
      }

      document.body.classList.remove('print-calculator-only');
      if (printRoot) {
        printRoot.classList.remove('is-print-target');
      }

      window.removeEventListener('afterprint', restoreCollapsedRounds);
    };

    window.addEventListener('afterprint', restoreCollapsedRounds);
    window.print();
  }

  function isValidEmailAddress(value) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
  }

  function parseCurrencyValue(valueText) {
    if (!valueText || valueText === '--') return 0;
    return parseFloat(valueText.replace(/[^0-9.-]/g, '')) || 0;
  }

  function buildCalculatorEmailPayload(calculatorRoot, recipientEmail) {
    const rows = [];

    for (let round = 1; round <= 5; round++) {
      if (!roundData[round].selected) continue;

      const select = document.getElementById(`product-select-${round}`);
      const option = select ? select.options[select.selectedIndex] : null;

      rows.push({
        round,
        sku: option?.value || null,
        productTitle: option?.dataset?.name || null,
        productUrl: option?.dataset?.url || null,
        coverageSqFt: roundData[round].coverage || 0,
        nitrogenPercent: roundData[round].nitrogen || 0,
        pricePerBag: roundData[round].price || 0,
        lbsNitrogenPer1000SqFt: parseFloat(document.getElementById(`lbs-nitrogen-${round}`).textContent) || 0,
        bagsNeeded: parseFloat(document.getElementById(`bags-needed-${round}`).textContent) || 0,
        costPerAcre: parseCurrencyValue(document.getElementById(`cost-${round}`).textContent),
      });
    }

    return {
      recipientEmail,
      collectionHandle: calculatorRoot?.dataset?.collectionHandle || null,
      acres: parseFloat(document.getElementById('acres-input').value) || 0,
      totals: {
        annualLbsNitrogen: parseFloat(document.getElementById('total-lbs-nitrogen').textContent) || 0,
        annualBagsNeeded: parseFloat(document.getElementById('total-bags-needed').textContent) || 0,
        annualCost: parseCurrencyValue(document.getElementById('total-cost').textContent),
      },
      rows,
      submittedAt: new Date().toISOString(),
      source: {
        pathname: window.location.pathname,
        href: window.location.href,
      },
    };
  }

  function setEmailStatus(statusNode, message, isError) {
    if (!statusNode) return;
    statusNode.textContent = message || '';
    statusNode.classList.remove('is-error', 'is-success');
    if (message) {
      statusNode.classList.add(isError ? 'is-error' : 'is-success');
    }
  }

  async function handleSendCalculatorEmail() {
    const calculatorRoot = document.querySelector('.fertilizer-calculator');
    const emailPanel = calculatorRoot?.querySelector('[data-email-panel]');
    const emailInput = calculatorRoot?.querySelector('[data-email-input]');
    const emailStatus = calculatorRoot?.querySelector('[data-email-status]');
    const sendButton = calculatorRoot?.querySelector('[data-email-send]');
    const endpoint = calculatorRoot?.dataset?.emailEndpoint || '';

    if (!emailInput || !emailPanel || !sendButton) return;

    const email = emailInput.value.trim();
    if (!isValidEmailAddress(email)) {
      setEmailStatus(emailStatus, 'Enter a valid email address.', true);
      emailInput.focus();
      return;
    }

    if (!endpoint) {
      setEmailStatus(emailStatus, 'Email endpoint is not configured.', true);
      return;
    }

    const payload = buildCalculatorEmailPayload(calculatorRoot, email);
    if (!payload.rows.length) {
      setEmailStatus(emailStatus, 'Select at least one product round before sending.', true);
      return;
    }

    sendButton.disabled = true;
    setEmailStatus(emailStatus, 'Sending...', false);

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        const responseText = await response.text();
        throw new Error(responseText || `Request failed (${response.status})`);
      }

      setEmailStatus(emailStatus, 'Email sent successfully.', false);
      emailInput.value = '';
      setTimeout(function () {
        emailPanel.hidden = true;
      }, 900);
    } catch (error) {
      setEmailStatus(emailStatus, error.message || 'Failed to send email.', true);
    } finally {
      sendButton.disabled = false;
    }
  }

  document.addEventListener('keydown', function (event) {
    if (!isMobileView()) return;
    if (!event.target.classList || !event.target.classList.contains('round-label')) return;

    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      const row = event.target.closest('.round-row');
      if (!row) return;
      const round = row.dataset.round;
      toggleRound(round);
    }
  });

  // =============================================
  // INITIALIZE ON PAGE LOAD
  // =============================================
  document.addEventListener('DOMContentLoaded', function () {
    const calculatorRoot = document.querySelector('.fertilizer-calculator');
    const printButton = document.querySelector('[data-print-calculator]');
    const emailButton = calculatorRoot?.querySelector('[data-email-calculator]');
    const emailPanel = calculatorRoot?.querySelector('[data-email-panel]');
    const emailInput = calculatorRoot?.querySelector('[data-email-input]');
    const emailSendButton = calculatorRoot?.querySelector('[data-email-send]');
    const emailCancelButton = calculatorRoot?.querySelector('[data-email-cancel]');
    const emailStatus = calculatorRoot?.querySelector('[data-email-status]');

    if (printButton) {
      printButton.addEventListener('click', handlePrintCalculator);
    }

    if (emailButton && emailPanel && emailInput) {
      emailButton.addEventListener('click', function () {
        const isHidden = emailPanel.hidden;
        emailPanel.hidden = !isHidden;
        setEmailStatus(emailStatus, '', false);
        if (isHidden) {
          emailInput.focus();
        }
      });
    }

    if (emailSendButton) {
      emailSendButton.addEventListener('click', handleSendCalculatorEmail);
    }

    if (emailCancelButton && emailPanel) {
      emailCancelButton.addEventListener('click', function () {
        emailPanel.hidden = true;
        setEmailStatus(emailStatus, '', false);
      });
    }

    if (emailInput) {
      emailInput.addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          handleSendCalculatorEmail();
        }
      });
    }

    expandAllRoundsForDesktop();

    window.addEventListener('resize', function () {
      if (!isMobileView()) {
        expandAllRoundsForDesktop();
      }
    });
    document.addEventListener('click', (e) => {
      const button = e.target.closest('.volume-pricing-button');

      if (button) {
        e.stopPropagation();

        const popup = button.closest('.volume-pricing-wrapper').querySelector('.volume-pricing-popup');

        popup.hidden = !popup.hidden;

        return;
      }

      document.querySelectorAll('.volume-pricing-popup').forEach((popup) => {
        popup.hidden = true;
      });
    });
    calculateAll();
  });
</script>

