          <td class="round-label" onclick="toggleRound(2)" role="button" tabindex="0" aria-expanded="true">
            Round - 2<br>
            <small>(May - June)</small>
          </td>
          <td class="item-cell">
            <div class="select">
              <select class="product-select select__select" id="product-select-2" onchange="updateProduct(2)">
                <option value="">-- Select Product --</option>
