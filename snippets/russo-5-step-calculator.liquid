                  {%- for product in calculator_collection.products -%}
                    {%- assign selected_variant = product.selected_or_first_available_variant -%}
                    {%- assign product_coverage = selected_variant.metafields.fertilizer.bag_coverage_sq_ft.value -%}
                    {%- assign product_nitrogen = selected_variant.metafields.fertilizer.nitrogen.value -%}
                    <option
                      value="{{ selected_variant.sku | default: selected_variant.id }}"
