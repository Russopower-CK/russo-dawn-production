{% comment %}
  Renders a product card.

  Accepts:
  - card_product: {Object} Product Liquid object.
  - media_aspect_ratio: {String} Product image ratio.
  - image_shape: {String} Image mask applied to the product image.
  - show_secondary_image: {Boolean} Show the secondary image on hover.
  - show_vendor: {Boolean} Show the product vendor.
  - show_rating: {Boolean} Show the product rating.
  - extend_height: {Boolean} Extend the card to available container height.
  - lazy_load: {Boolean} Lazy-load product images.
  - skip_styles: {Boolean} Skip component styles when rendering multiple cards.
  - quick_add: {String} Quick-add behavior.
  - section_id: {String} ID of the section containing the card.
  - horizontal_class: {Boolean} Add the card--horizontal class.
  - horizontal_quick_add: {Boolean} Use horizontal quick-add styling.
  - placeholder_image: {String} Placeholder image when no product exists.
  - show_sku: {Boolean} Show the selected variant SKU.
  - show_stock: {Boolean} Show the Russo shipping-stock snippet.
  - pickup_availability_components: {String} Pickup component mode.
  - use_russo_pickup: {Boolean} Use Russo pickup logic.
  - enable_hover_actions: {Boolean} Enable desktop hover actions.
  - auto_status_fetch: {Boolean} Automatically retrieve inventory status.
  - show_mobile_add_to_cart: {Boolean} Show mobile product-card action.

  Usage:
  {% render 'card-product', show_vendor: section.settings.show_vendor %}
{% endcomment %}

{%- unless skip_styles -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'quick-order-list.css' | asset_url | stylesheet_tag }}
  {{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

  <style>
    .quick-add__request_quote {
      background: var(--russo-black);
    }

    .card__heading {
      display: flex;
      font-size: 1.2rem;
      align-content: center;
    }

    .card__actions {
      padding: 1rem;
      border-top: 0;
      background-color: var(--color-foreground);
    }

    .card__inner.ratio::before {
      padding-bottom: 75% !important;
    }

    .hover-actions-enabled .card__actions {
      display: none;
    }

    .hover-actions-enabled {
      position: relative;
      z-index: 1;
    }

    .hover-actions-enabled.is-hover-active {
      z-index: 1;
    }

    .hover-actions-enabled.is-hover-active .card {
      border-bottom: 0;
    }

    #product-hover-panel {
      position: absolute;
      display: none;
      z-index: 2;
      box-sizing: border-box;
      width: 100%;
      overflow: hidden;
      transform-origin: top center;
      background-color: inherit !important;
      border: 1px solid #e5e5e5;
      border-top: 0;
    }

    #product-hover-panel.is-revealing {
      animation: product-hover-panel-reveal 100ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    @keyframes product-hover-panel-reveal {
      from {
        opacity: 0;
        clip-path: inset(0 0 100% 0);
      }

      to {
        opacity: 1;
        clip-path: inset(0 0 0 0);
      }
    }

    #product-hover-panel .card__actions {
      display: block !important;
      margin: 0;
      padding: 1rem;
    }

    #product-hover-panel .quick-add,
    #product-hover-panel .product-form,
    #product-hover-panel form {
      margin: 0;
    }

    .single-variant-action-wrapper {
      display: flex;
      gap: 5px;
    }

    .single-variant-action-wrapper > modal-opener,
    .single-variant-action-wrapper > product-form {
      flex: 1;
    }

    .single-variant-action-wrapper > modal-opener .button,
    .single-variant-action-wrapper > product-form .button {
      width: 100%;
    }

    .single-variant-action-wrapper > product-form .button {
      background-color: var(--russo-red-dark);
    }

    .card-mobile-action {
      display: none;
    }

    @media screen and (max-width: 749px) {
      .card-mobile-action {
        display: block;
        width: 100%;
        padding: 0 1rem 1rem;
      }

      .card-mobile-action product-form,
      .card-mobile-action .product-form {
        display: block;
        width: 100%;
      }

      .card-mobile-action .button {
        width: 100%;
        min-width: 0;
        min-height: 4.4rem;
        margin: 0;
        padding-right: 0.8rem;
        padding-left: 0.8rem;
        font-size: 1.2rem;
        line-height: 1.2;
      }

      .card-mobile-action__button {
        background-color: var(--russo-red-dark);
      }

      .card-mobile-action__link {
        text-decoration: none;
      }

      .card-mobile-action__button[disabled] {
        cursor: not-allowed;
        opacity: 0.6;
      }
    }
  </style>
{%- endunless -%}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign ratio = 1

    if card_product.featured_media and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif card_product.featured_media and media_aspect_ratio == 'adapt'
      assign ratio = card_product.featured_media.aspect_ratio
    endif

    if ratio == 0 or ratio == null
      assign ratio = 1
    endif

    assign card_media = card_product.featured_media | default: settings.default_product_image
    assign card_product_url = card_product.url

    if collection
      assign card_product_url = card_product.url | within: collection
    endif

    assign product_form_id = 'quick-add-' | append: section_id | append: '-' | append: card_product.id
    assign mobile_product_form_id = 'mobile-card-form-' | append: section_id | append: '-' | append: card_product.id

    assign qty_rules = false
    assign selected_variant = card_product.selected_or_first_available_variant

    if selected_variant == null
      assign selected_variant = card_product.variants.first
    endif

    if selected_variant.quantity_rule.min > 1 or selected_variant.quantity_rule.max != null or selected_variant.quantity_rule.increment > 1
      assign qty_rules = true
    endif
  -%}

  <div
    class="
      card-wrapper
      product-card-wrapper
      underline-links-hover
      {% if enable_hover_actions %}hover-actions-enabled{% endif %}
    "
  >
    {% if settings.use_russo_favorites %}
      {% render 'russo-order-form-icon-toggle',
        product: card_product,
        absolute: true
      %}
    {% endif %}

    <div
      class="
        card card--{{ settings.card_style }}
        {% if card_media %}card--media{% else %}card--text{% endif %}
        {% if settings.card_style == 'card' %}color-{{ settings.card_color_scheme }} gradient{% endif %}
        {% if image_shape and image_shape != 'default' %}card--shape{% endif %}
        {% if extend_height %}card--extend-height{% endif %}
        {% if card_media == nil and settings.card_style == 'card' %}ratio{% endif %}
        {% if horizontal_class %}card--horizontal{% endif %}
      "
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      <div
        class="card__inner{% if settings.card_style == 'standard' %} color-{{ settings.card_color_scheme }} gradient{% endif %}{% if card_media or settings.card_style == 'standard' %} ratio{% endif %}"
        style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
      >
        {%- if card_media -%}
          <div class="card__media{% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ settings.card_color_scheme }} gradient{% endif %}">
            <div class="media media--transparent media--hover-effect">
              {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
              <img
                srcset="
                  {%- if card_media.width >= 165 -%}{{ card_media | image_url: width: 165 }} 165w,{%- endif -%}
                  {%- if card_media.width >= 360 -%}{{ card_media | image_url: width: 360 }} 360w,{%- endif -%}
                  {%- if card_media.width >= 533 -%}{{ card_media | image_url: width: 533 }} 533w,{%- endif -%}
                  {%- if card_media.width >= 720 -%}{{ card_media | image_url: width: 720 }} 720w,{%- endif -%}
                  {%- if card_media.width >= 940 -%}{{ card_media | image_url: width: 940 }} 940w,{%- endif -%}
                  {%- if card_media.width >= 1066 -%}{{ card_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                  {{ card_media | image_url }} {{ card_media.width }}w
                "
                src="{{ card_media | image_url: width: 533 }}"
                sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                alt="{{ card_media.alt | default: card_product.title | escape }}"
                class="motion-reduce"
                {% unless lazy_load == false %}
                  loading="lazy"
                {% endunless %}
                width="{{ card_media.width }}"
                height="{{ card_media.height }}"
              >
              {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}

              {%- if card_product.media[1] != null and show_secondary_image -%}
                {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
                <img
                  srcset="
                    {%- if card_product.media[1].width >= 165 -%}{{ card_product.media[1] | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if card_product.media[1].width >= 360 -%}{{ card_product.media[1] | image_url: width: 360 }} 360w,{%- endif -%}
                    {%- if card_product.media[1].width >= 533 -%}{{ card_product.media[1] | image_url: width: 533 }} 533w,{%- endif -%}
                    {%- if card_product.media[1].width >= 720 -%}{{ card_product.media[1] | image_url: width: 720 }} 720w,{%- endif -%}
                    {%- if card_product.media[1].width >= 940 -%}{{ card_product.media[1] | image_url: width: 940 }} 940w,{%- endif -%}
                    {%- if card_product.media[1].width >= 1066 -%}{{ card_product.media[1] | image_url: width: 1066 }} 1066w,{%- endif -%}
                    {{ card_product.media[1] | image_url }} {{ card_product.media[1].width }}w
                  "
                  src="{{ card_product.media[1] | image_url: width: 533 }}"
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                  alt="{{ card_product.media[1].alt | default: card_product.title | escape }}"
                  class="motion-reduce"
                  loading="lazy"
                  width="{{ card_product.media[1].width }}"
                  height="{{ card_product.media[1].height }}"
                >
                {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="card__content">
          <div class="card__information">
            <h3
              class="card__heading"
              {% if card_product.featured_media == null and settings.card_style == 'standard' %}
                id="title-{{ section_id }}-{{ card_product.id }}"
              {% endif %}
            >
              <a
                href="{{ card_product_url }}"
                class="full-unstyled-link"
              >
                {{ card_product.title | escape }}
              </a>
            </h3>
          </div>

          <div class="card__badge {{ settings.badge_position }}">
            {%- if card_product.available == false -%}
              <span
                id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}"
                class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}"
              >
                {{- 'products.product.sold_out' | t -}}
              </span>
            {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
              <span
                id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}"
                class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
              >
                {{- 'products.product.on_sale' | t -}}
              </span>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="card__content">
        <div class="card__information">
          {% render 'price',
            product: card_product,
            price_class: '',
            show_compare_at_price: true
          %}

          <h3
            class="card__heading h5"
            {% if card_product.featured_media or settings.card_style == 'card' %}
              id="title-{{ section_id }}-{{ card_product.id }}"
            {% endif %}
          >
            <a
              href="{{ card_product_url }}"
              class="full-unstyled-link"
            >
              {{ card_product.title | escape }}
            </a>
          </h3>

          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">
                {{ 'accessibility.vendor' | t }}
              </span>

              <div class="caption-with-letter-spacing light">
                {{ card_product.vendor | escape }}
              </div>
            {%- endif -%}

            {%- if show_sku and selected_variant.sku != blank -%}
              <span class="visually-hidden">SKU</span>

              <div class="caption-with-letter-spacing">
                SKU# {{ selected_variant.sku | escape }}
              </div>
            {%- endif -%}

            {%- if show_rating and card_product.metafields.reviews.rating.value != blank -%}
              {% liquid
                assign rating_decimal = 0
                assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1

                if decimal >= 0.3 and decimal <= 0.7
                  assign rating_decimal = 0.5
                elsif decimal > 0.7
                  assign rating_decimal = 1
                endif
              %}

              <div
                class="rating"
                role="img"
                aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}"
              >
                <span
                  aria-hidden="true"
                  class="rating-star"
                  style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                ></span>
              </div>

              <p class="rating-text caption">
                <span aria-hidden="true">
                  {{- card_product.metafields.reviews.rating.value }} /
                  {{ card_product.metafields.reviews.rating.value.scale_max -}}
                </span>
              </p>

              <p class="rating-count caption">
                <span aria-hidden="true">
                  ({{ card_product.metafields.reviews.rating_count }})
                </span>

                <span class="visually-hidden">
                  {{- card_product.metafields.reviews.rating_count }}
                  {{ 'accessibility.total_reviews' | t -}}
                </span>
              </p>
            {%- endif -%}

            {%- if show_stock -%}
              {%- render 'shipping-stock',
                product: card_product,
                include_pickup: true,
                pickup_availability_components: pickup_availability_components,
                show_pickup_availability: true,
                use_russo_pickup: use_russo_pickup,
                show_launcher_button: false,
                auto_status_fetch: auto_status_fetch
              -%}
            {%- endif -%}

            {%- if card_product.quantity_price_breaks_configured? -%}
              {%- if card_product.variants_count == 1 and quick_add == 'bulk' -%}
                {%- liquid
                  assign quantity_rule = selected_variant.quantity_rule
                  assign has_qty_rules = false

                  if quantity_rule.increment > 1 or quantity_rule.min > 1 or quantity_rule.max != null
                    assign has_qty_rules = true
                  endif
                -%}

                <quantity-popover>
                  <button
                    class="card__information-volume-pricing-note card__information-volume-pricing-note--button card__information-volume-pricing-note--button-{{ settings.card_text_alignment }} quantity-popover__info-button--icon-only button button--tertiary medium-hide small-hide"
                    type="button"
                  >
                    <span class="caption">
                      {{ 'products.product.volume_pricing.note' | t }}
                    </span>
                  </button>

                  <button
                    class="card__information-volume-pricing-note card__information-volume-pricing-note--button card__information-volume-pricing-note--button-{{ settings.card_text_alignment }} quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                    type="button"
                  >
                    <span class="caption">
                      {{ 'products.product.volume_pricing.note' | t }}
                    </span>
                  </button>

                  <div
                    class="global-settings-popup quantity-popover__info"
                    tabindex="-1"
                    hidden
                    id="quantity-popover-info-{{ selected_variant.id }}"
                  >
                    {%- if has_qty_rules -%}
                      <div class="quantity__rules caption no-js-hidden">
                        {%- if quantity_rule.increment > 1 -%}
                          <span class="divider">
                            {{- 'products.product.quantity.multiples_of' | t: quantity: quantity_rule.increment -}}
                          </span>
                        {%- endif -%}

                        {%- if quantity_rule.min > 1 -%}
                          <span class="divider">
                            {{- 'products.product.quantity.min_of' | t: quantity: quantity_rule.min -}}
                          </span>
                        {%- endif -%}

                        {%- if quantity_rule.max != null -%}
                          <span class="divider">
                            {{- 'products.product.quantity.max_of' | t: quantity: quantity_rule.max -}}
                          </span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                    <button
                      class="button-close button button--tertiary large-up-hide"
                      type="button"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {{- 'icon-close.svg' | inline_asset_content -}}
                    </button>

                    {%- if selected_variant.quantity_price_breaks.size > 0 -%}
                      <volume-pricing class="parent-display">
                        <ul class="list-unstyled">
                          <li>
                            <span>{{ selected_variant.quantity_rule.min }}+</span>
                            {%- assign price = selected_variant.price | money_with_currency -%}
                            <span>
                              {{ 'sections.quick_order_list.each' | t: money: price }}
                            </span>
                          </li>

                          {%- for price_break in selected_variant.quantity_price_breaks -%}
                            <li>
                              <span>
                                {{- price_break.minimum_quantity -}}
                                <span aria-hidden="true">+</span>
                              </span>

                              {%- assign price = price_break.price | money_with_currency -%}
                              <span>
                                {{ 'sections.quick_order_list.each' | t: money: price }}
                              </span>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </volume-pricing>
                    {%- endif -%}
                  </div>
                </quantity-popover>
              {%- else -%}
                <div class="card__information-volume-pricing-note">
                  <span class="caption">
                    {{ 'products.product.volume_pricing.note' | t }}
                  </span>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>

        <div class="card__badge {{ settings.badge_position }}">
          {%- if card_product.available == false -%}
            <span
              id="Badge-{{ section_id }}-{{ card_product.id }}"
              class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}"
            >
              {{- 'products.product.sold_out' | t -}}
            </span>
          {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
            <span
              id="Badge-{{ section_id }}-{{ card_product.id }}"
              class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
            >
              {{- 'products.product.on_sale' | t -}}
            </span>
          {%- endif -%}
        </div>
      </div>

      {%- if show_mobile_add_to_cart -%}
        <div class="card-mobile-action">
          {%- if card_product.price <= 0 -%}
            <a
              href="{{ card_product_url }}"
              class="button button--full-width button--primary card-mobile-action__button card-mobile-action__link"
            >
              Request Quote
            </a>

          {%- elsif card_product.variants_count > 1 or qty_rules -%}
            <a
              href="{{ card_product_url }}"
              class="button button--full-width button--primary card-mobile-action__button card-mobile-action__link"
            >
              {{ 'products.product.choose_options' | t }}
            </a>

          {%- elsif selected_variant != null -%}
            <product-form data-section-id="{{ section_id }}">
              {%- form 'product',
                card_product,
                id: mobile_product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ selected_variant.id }}"
                  class="product-variant-id"
                  {% unless selected_variant.available %}
                    disabled
                  {% endunless %}
                >

                <button
                  id="{{ mobile_product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="button button--full-width button--primary card-mobile-action__button"
                  aria-live="polite"
                  data-sold-out-message="true"
                  {% unless selected_variant.available %}
                    disabled
                  {% endunless %}
                >
                  <span>
                    {%- if selected_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>

                  <span class="sold-out-message hidden">
                    {{ 'products.product.sold_out' | t }}
                  </span>

                  {%- render 'loading-spinner' -%}
                </button>
              {%- endform -%}
            </product-form>
          {%- else -%}
            <button
              type="button"
              class="button button--full-width button--primary card-mobile-action__button"
              disabled
            >
              {{ 'products.product.sold_out' | t }}
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="card__actions">
        {% if card_product.price > 0 %}
          {% if quick_add == 'standard' %}
            <div class="quick-add no-js-hidden">
              {%- if card_product.variants_count > 1 or qty_rules -%}
                <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
                  <button
                    id="{{ product_form_id }}-submit"
                    type="button"
                    name="add"
                    class="quick-add__submit button button--full-width button--primary{% if horizontal_quick_add %} card--horizontal__quick-add animate-arrow{% endif %}"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    data-product-url="{{ card_product.url }}"
                  >
                    {{ 'products.product.choose_options' | t }}

                    {%- if horizontal_quick_add -%}
                      <span class="icon-wrap">
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}

                    {%- render 'loading-spinner' -%}
                  </button>
                </modal-opener>

                <quick-add-modal
                  id="QuickAdd-{{ card_product.id }}"
                  class="quick-add-modal"
                >
                  <div
                    role="dialog"
                    aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                    aria-modal="true"
                    class="quick-add-modal__content global-settings-popup"
                    tabindex="-1"
                  >
                    <button
                      id="ModalClose-{{ card_product.id }}"
                      type="button"
                      class="quick-add-modal__toggle"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {{- 'icon-close.svg' | inline_asset_content -}}
                    </button>

                    <div
                      id="QuickAddInfo-{{ card_product.id }}"
                      class="quick-add-modal__content-info"
                    ></div>
                  </div>
                </quick-add-modal>
              {%- else -%}
                <div class="single-variant-action-wrapper">
                  <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
                    <button
                      id="{{ product_form_id }}-quick-shop"
                      type="button"
                      class="quick-add__submit button button--full-width button--primary{% if horizontal_quick_add %} card--horizontal__quick-add animate-arrow{% endif %}"
                      aria-haspopup="dialog"
                      aria-labelledby="{{ product_form_id }}-quick-shop title-{{ section_id }}-{{ card_product.id }}"
                      data-product-url="{{ card_product.url }}"
                    >
                      Quick Shop

                      {%- if horizontal_quick_add -%}
                        <span class="icon-wrap">
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                      {%- endif -%}

                      {%- render 'loading-spinner' -%}
                    </button>
                  </modal-opener>

                  <quick-add-modal
                    id="QuickAdd-{{ card_product.id }}"
                    class="quick-add-modal"
                  >
                    <div
                      role="dialog"
                      aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                      aria-modal="true"
                      class="quick-add-modal__content global-settings-popup"
                      tabindex="-1"
                    >
                      <button
                        id="ModalClose-{{ card_product.id }}"
                        type="button"
                        class="quick-add-modal__toggle"
                        aria-label="{{ 'accessibility.close' | t }}"
                      >
                        {{- 'icon-close.svg' | inline_asset_content -}}
                      </button>

                      <div
                        id="QuickAddInfo-{{ card_product.id }}"
                        class="quick-add-modal__content-info"
                      ></div>
                    </div>
                  </quick-add-modal>

                  <product-form data-section-id="{{ section_id }}">
                    {%- form 'product',
                      card_product,
                      id: product_form_id,
                      class: 'form',
                      novalidate: 'novalidate',
                      data-type: 'add-to-cart-form'
                    -%}
                      <input
                        type="hidden"
                        name="id"
                        value="{{ selected_variant.id }}"
                        class="product-variant-id"
                        {% unless selected_variant.available %}
                          disabled
                        {% endunless %}
                      >

                      <button
                        id="{{ product_form_id }}-submit"
                        type="submit"
                        name="add"
                        class="quick-add__submit button button--full-width button--primary{% if horizontal_quick_add %} card--horizontal__quick-add{% endif %}"
                        aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                        aria-live="polite"
                        data-sold-out-message="true"
                        {% unless selected_variant.available %}
                          disabled
                        {% endunless %}
                      >
                        <span>
                          {%- if selected_variant.available -%}
                            {{ 'products.product.add_to_cart' | t }}
                          {%- else -%}
                            {{ 'products.product.sold_out' | t }}
                          {%- endif -%}
                        </span>

                        <span class="sold-out-message hidden">
                          {{ 'products.product.sold_out' | t }}
                        </span>

                        {%- if horizontal_quick_add -%}
                          <span class="icon-wrap">
                            {{- 'icon-plus.svg' | inline_asset_content -}}
                          </span>
                        {%- endif -%}

                        {%- render 'loading-spinner' -%}
                      </button>
                    {%- endform -%}
                  </product-form>
                </div>
              {%- endif -%}
            </div>

          {% elsif quick_add == 'bulk' %}
            {% if card_product.variants_count == 1 %}
              <quick-add-bulk
                data-min="{{ selected_variant.quantity_rule.min }}"
                id="quick-add-bulk-{{ selected_variant.id }}-{{ section_id }}"
                class="quick-add-bulk"
                data-index="{{ selected_variant.id }}"
              >
                {% if selected_variant.available == false %}
                  <button
                    id="{{ product_form_id }}-submit"
                    type="button"
                    name="add"
                    class="quick-add__submit button button--full-width button--primary"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    data-sold-out-message="true"
                    disabled
                  >
                    <span>{{ 'products.product.sold_out' | t }}</span>

                    <span class="sold-out-message hidden">
                      {{ 'products.product.sold_out' | t }}
                    </span>
                  </button>
                {% else %}
                  {% render 'quantity-input',
                    variant: selected_variant,
                    min: 0
                  %}
                {% endif %}
              </quick-add-bulk>
            {% else %}
              <div class="quick-add no-js-hidden">
                <modal-opener
                  id="QuickBulk-{{ card_product.id }}-{{ section_id }}"
                  data-modal="#QuickAddBulk-{{ card_product.id }}-{{ section_id }}"
                >
                  <button
                    id="{{ product_form_id }}-submit"
                    type="button"
                    name="add"
                    class="quick-add__submit button button--full-width button--primary"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    data-product-url="{{ card_product.url }}"
                  >
                    {{ 'products.product.choose_options' | t }}
                    {%- render 'loading-spinner' -%}
                  </button>
                </modal-opener>

                <modal-dialog
                  id="QuickAddBulk-{{ card_product.id }}-{{ section_id }}"
                  class="quick-add-modal"
                >
                  <div
                    role="dialog"
                    aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                    aria-modal="true"
                    class="quick-add-modal__content quick-add-modal__content--bulk global-settings-popup"
                    tabindex="-1"
                  >
                    <button
                      id="ModalCloseBulk-{{ card_product.id }}-{{ section_id }}"
                      type="button"
                      class="quick-add-modal__toggle"
                      aria-label="{{ 'accessibility.close' | t }}"
                    >
                      {{- 'icon-close.svg' | inline_asset_content -}}
                    </button>

                    <div
                      id="QuickAddInfoBulk-{{ card_product.id }}-{{ section_id }}"
                      class="quick-add-modal__content-info quick-add-modal__content-info--bulk"
                    >
                      <div class="quick-add__content-info__media">
                        <div class="quick-add__info">
                          {%- if card_product.featured_media -%}
                            <div class="quick-add__product-media">
                              <div class="quick-add__product-container global-media-settings">
                                {{
                                  card_product.featured_media
                                  | image_url: width: 533
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '165, 360, 533',
                                    sizes: '(min-width: 990px) 533px, 100vw',
                                    alt: card_product.featured_media.alt | default: card_product.title
                                }}
                              </div>
                            </div>
                          {%- endif -%}

                          <a
                            href="{{ card_product_url }}"
                            class="link underlined-link"
                          >
                            {{ 'products.product.view_full_details' | t }}
                            {{- 'icon-arrow.svg' | inline_asset_content -}}
                          </a>
                        </div>

                        <div class="quick-add-modal__content-info--bulk-details large-up-hide">
                          <a
                            href="{{ card_product_url }}"
                            class="full-unstyled-link"
                          >
                            <h3>{{ card_product.title | escape }}</h3>
                          </a>

                          {% render 'price',
                            product: card_product,
                            price_class: '',
                            show_compare_at_price: true
                          %}
                        </div>
                      </div>

                      <div>
                        <div class="quick-add-modal__content-info--bulk-details small-hide medium-hide">
                          <a
                            href="{{ card_product_url }}"
                            class="full-unstyled-link"
                          >
                            <h3 class="h2">
                              {{ card_product.title | escape }}
                            </h3>
                          </a>

                          {% render 'price',
                            product: card_product,
                            price_class: '',
                            show_compare_at_price: true
                          %}
                        </div>

                        <bulk-modal
                          id="QuickBulkModal-{{ card_product.id }}-{{ section_id }}"
                          data-url="{{ card_product.url }}"
                          data-section-id="{{ section_id }}"
                          data-product-id="{{ card_product.id }}"
                        ></bulk-modal>
                      </div>
                    </div>
                  </div>
                </modal-dialog>
              </div>
            {% endif %}

          {% elsif quick_add == 'buy-button' %}
            <div class="card-product-buy-button">
              {% render 'buy-buttons',
                product: card_product,
                product_form_id: product_form_id,
                section_id: section_id,
                hide_view_other_stores: true
              %}
            </div>
          {% endif %}
        {% else %}
          <div class="quick-add no-js-hidden">
            <a
              href="{{ card_product_url }}"
              class="quick-add__submit button button--full-width button--primary quick-add__request_quote"
            >
              Request Quote
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

{%- else -%}
  {%- liquid
    assign ratio = 1
    assign placeholder = true

    if media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    endif
  -%}

  <div class="card-wrapper product-card-wrapper underline-links-hover">
    <div
      class="
        card card--{{ settings.card_style }}
        {% if extend_height %}card--extend-height{% endif %}
        {% if image_shape and image_shape != 'default' %}card--shape{% endif %}
        {% if settings.card_style == 'card' %}color-{{ settings.card_color_scheme }} gradient{% endif %}
      "
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      <div
        class="card__inner{% if settings.card_style == 'standard' %} color-{{ settings.card_color_scheme }} gradient{% endif %} ratio"
        style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
      >
        <div class="card__media{% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ settings.card_color_scheme }} gradient{% endif %}">
          <div class="media media--transparent">
            {%- if placeholder_image -%}
              {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
            {%- else -%}
              {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading card__heading--placeholder{% if settings.card_style == 'standard' %} h5{% endif %}">
            <a
              role="link"
              aria-disabled="true"
              class="full-unstyled-link"
            >
              {{ 'onboarding.product_title' | t }}
            </a>
          </h3>

          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">
                {{ 'accessibility.vendor' | t }}
              </span>

              <div class="caption-with-letter-spacing light">
                {{ 'products.product.vendor' | t }}
              </div>
            {%- endif -%}

            {% render 'price',
              placeholder: placeholder,
              show_compare_at_price: true
            %}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
