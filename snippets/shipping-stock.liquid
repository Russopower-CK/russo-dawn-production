{% comment %}
  Renders stock availability. Splits having shipping versus pickup availability
  Accepts:
  - product: {Object} passes in the block information.
  - share_link: {String} url to be added to the input the user will get/copy.
  - include_pickup: {Boolean} if the pickup should be included in the snippet.
  - show_pickup_availability: {Boolean} for the pickup availability. If true the pickup availability is rendered, false - not rendered (optional).
  - hide_view_other_stores: {Boolean} legacy option to hide the pickup availability button (optional).
  - pickup_availability_components: {String} comma-separated list of pickup availability components to show.
  - use_russo_pickup: {Boolean} specifies if the base pickup-preview or the russo preffered store is rendered.
  -auto_status_fetch: {Boolean} specifies if the russo-preffered-store-variant-trigger will auto fetch stock levels. Set false if rendered from card-product.
  - continue_selling_display_mode: {String} optional. "base" (default) keeps theme translation, "custom_tooltip" shows custom hover tooltip.
  - continue_selling_label: {String} optional custom label shown when continue selling.
  - continue_selling_tooltip_title: {String} optional tooltip title for custom continue selling display.
  - continue_selling_tooltip_body: {String} optional tooltip body for custom continue selling display.
    Supported values: headline, time, button. Aliases: caption-large/title/location, caption/eta, stores/view-other-stores.
    Examples: 'headline' (caption only), 'headline,time', 'all'.
  Usage:
  {% render 'share-button',
    block: block,
    share_link: share_url
  %}
{% endcomment %}
{% assign showpickup = include_pickup %}
{% assign pickup_auto_status_fetch = auto_status_fetch | default: false %}
{% assign continue_selling_display_mode = continue_selling_display_mode
  | default: 'custom_tooltip'
  | downcase
  | strip
%}
{% assign use_continue_selling_tooltip = false %}
{% if continue_selling_display_mode == 'custom_tooltip' or continue_selling_display_mode == 'custom' %}
  {% assign use_continue_selling_tooltip = true %}
{% endif %}
{% assign continue_selling_label = continue_selling_label | default: 'Special Order' %}
{% assign continue_selling_tooltip_title = continue_selling_tooltip_title | default: continue_selling_label %}
{% assign continue_selling_tooltip_body = continue_selling_tooltip_body | default: blank %}
{% if continue_selling_tooltip_body == blank %}
  {% assign continue_selling_tooltip_body = 'products.product.inventory_out_of_stock_continue_selling' | t %}
{% endif %}

<style>
      .shipping-stock {
        margin: 0;
        display: flex;
        align-items: center;
        width: 100%;
      }
      .pickup-wrapper {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        width: 100%;
        margin: 0;
        min-width: 0;
        text-align: left;
      }

      .label {
        flex: 0 0 auto; /* do not shrink */
        margin: 0;
        font-size: 1.3rem;
        white-space: nowrap;
      }

      .product__inventory_status {
        display: grid;
        grid-template-columns: 1fr;
        grid-auto-rows: auto;
        row-gap: 1px;
      }

      .product__inventory_status > * {
        margin: 0;
      }

      .shipping-stock .product__inventory {
        margin: 0;
      }
      .product__inventory .svg-wrapper {
        align-content: center;
        margin-left;
        width: 10px;
        height: 10px;
      }
      .shipping-stock .svg-wrapper{
      width: 10px;
    height: 10px;
  padding: 1px;}

      .continue-selling-note {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-weight: 600;
        cursor: help;
        z-index: 500000;
        padding: 5px;
      }

      .continue-selling-tooltip {
        position: absolute;
        left: 0;
        bottom: calc(100% + 0.8rem);
        width: min(28rem, 80vw);
        background: rgb(74, 74, 74);
        color: rgb(255, 255, 255);
        border-radius: 0.8rem;
        box-shadow: 0 10px 24px rgb(0 0 0 / 24%);
        opacity: 0;
        padding: 5px;
        visibility: hidden;
        transform: translateY(6px);
        transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
        pointer-events: auto;
        z-index: 5000001;
      }

      .continue-selling-note:hover .continue-selling-tooltip,
      .continue-selling-note:focus-visible .continue-selling-tooltip,
      .continue-selling-note:focus-within .continue-selling-tooltip {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      .continue-selling-tooltip__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.8rem;
        padding: 1rem 1.2rem;
        border-bottom: 1px solid rgb(255 255 255 / 16%);
        font-size: 1.5rem;
      }

      .continue-selling-tooltip__close {
        line-height: 1;
        font-size: 2.1rem;
      }

      .continue-selling-tooltip__body {
        margin: 0;
        padding: 1.2rem;
        font-size: 1.2rem;
        line-height: 1.45;
      }

      .continue-selling-tooltip::after {
        content: '';
        position: absolute;
        left: 2rem;
        top: 100%;
        width: 0;
        height: 0;
        border-left: 0.7rem solid transparent;
        border-right: 0.7rem solid transparent;
        border-top: 0.7rem solid rgb(74, 74, 74);
      }

      .grid__item:has(.continue-selling-note:hover),
      .grid__item:has(.continue-selling-note:focus-within) {
        position: relative;
        z-index: 600;
      }

      .card-wrapper:has(.continue-selling-note:hover),
      .card-wrapper:has(.continue-selling-note:focus-within) {
        z-index: 600;
      }
</style>
<div class="product__inventory_status">
  <div class="shipping-stock">
    <p
      class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption{% elsif block.settings.text_style == 'subtitle' %} subtitle {%else%} caption{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
      {{ block.shopify_attributes }}
      id="Inventory-{{ section.id }}"
      role="status"
    >
      {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
        {%- unless product.tags contains 'pickup' %}
          <div class="shipping-stock caption">
            Shipping:
            {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
              {%- if product.selected_or_first_available_variant.inventory_quantity
                  <= block.settings.inventory_threshold
              -%}
                <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                  {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                </span>
                {%- if block.settings.show_inventory_quantity -%}
                  {{-
                    'products.product.inventory_low_stock_show_count'
                    | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                  -}}
                {%- else -%}
                  {{- 'products.product.inventory_low_stock' | t -}}
                {%- endif -%}
              {%- else -%}
                <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                  {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                </span>
                {%- if block.settings.show_inventory_quantity -%}
                  {{-
                    'products.product.inventory_in_stock_show_count'
                    | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                  -}}
                {%- else -%}
                  {{- 'products.product.inventory_in_stock' | t -}}
                {%- endif -%}
              {%- endif -%}
            {%- else -%}
              {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                {%- if use_continue_selling_tooltip -%}
                  <span class="continue-selling-note" tabindex="0">
                    {{- continue_selling_label | escape -}}
                    <span class="continue-selling-tooltip" role="tooltip">
                      <span class="continue-selling-tooltip__header">
                        <span>{{- continue_selling_tooltip_title | escape -}}</span>
                        <span class="continue-selling-tooltip__close" aria-hidden="true">X</span>
                      </span>
                      <span class="continue-selling-tooltip__body">
                        {{- continue_selling_tooltip_body | escape -}}
                      </span>
                    </span>
                  </span>
                {%- else -%}
                  <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                    {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                  </span>
                  {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                {%- endif -%}
              {%- else -%}
                <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                  {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                </span>
                {{- 'products.product.inventory_out_of_stock' | t -}}
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- else -%}
          Shipping:
          <span class="svg-wrapper" style="color: rgb(178, 17, 17)">
            {{- 'icon-inventory-status.svg' | inline_asset_content -}}
          </span>
          Pickup Only
        {%- endunless -%}
      {%- endif -%}
    </p>
  </div>

  {% if showpickup %}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- liquid
      assign show_pickup_headline = true
      assign show_pickup_time = true
      assign show_pickup_button = true

      assign normalized_pickup_components = pickup_availability_components | default: '' | downcase | replace: ' ', ''
      assign pickup_component_tokens = normalized_pickup_components | split: ','

      if normalized_pickup_components != blank
        assign show_pickup_headline = false
        assign show_pickup_time = false
        assign show_pickup_button = false

        for pickup_component_token in pickup_component_tokens
          if pickup_component_token == 'all'
            assign show_pickup_headline = true
            assign show_pickup_time = true
            assign show_pickup_button = true
          endif

          if pickup_component_token == 'headline' or pickup_component_token == 'title' or pickup_component_token == 'caption' or pickup_component_token == 'location'
            assign show_pickup_headline = true
          endif

          if pickup_component_token == 'time' or pickup_component_token == 'caption' or pickup_component_token == 'eta'
            assign show_pickup_time = true
          endif

          if pickup_component_token == 'button' or pickup_component_token == 'stores' or pickup_component_token == 'view-other-stores'
            assign show_pickup_button = true
          endif
        endfor
      endif

      if hide_view_other_stores
        assign show_pickup_button = false
      endif
    -%}
    {% if use_russo_pickup %}
      {% render 'russo-preferred-store-variant-trigger',
        variant: product.selected_or_first_available_variant,
        button_label: 'Select a Store',
        show_launcher_button: show_launcher_button,
        auto_status_fetch: pickup_auto_status_fetch
      %}
    {% else %}
      <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
      {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
        | where: 'pick_up_enabled', true
      -%}
      <div class="pickup-wrapper">
        <pickup-availability
          class="product__pickup-availabilities quick-add-hidden"
          {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
            available
          {% endif %}
          data-root-url="{{ routes.root_url }}"
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          data-has-only-default-variant="{{ product.has_only_default_variant }}"
          data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
          data-show-pickup-headline="{{ show_pickup_headline }}"
          data-show-pickup-time="{{ show_pickup_time }}"
          data-show-pickup-button="{{ show_pickup_button }}"
        >
          <template>
            <pickup-availability-preview class="pickup-availability-preview">
              <div class="pickup-availability-info">
                {%- if show_pickup_headline -%}
                  <p class="pick-up-status caption-with-letter-spacing">
                    {{ 'products.product.pickup_availability.pick_up_unavailable' | t }}
                  </p>
                {%- endif -%}
                {%- if show_pickup_button -%}
                  <button
                    id="ShowPickupAvailabilityDrawer"
                    class="pickup-availability-button link link--text underlined-link"
                    aria-haspopup="dialog"
                  >
                    {{ 'products.product.pickup_availability.refresh' | t }}
                  </button>
                {%- endif -%}
              </div>
              <span class="svg-wrapper">
                {{- 'icon-unavailable.svg' | inline_asset_content -}}
              </span>
            </pickup-availability-preview>
          </template>
        </pickup-availability>
      </div>
    {% endif %}
  {% endif %}
</div>
