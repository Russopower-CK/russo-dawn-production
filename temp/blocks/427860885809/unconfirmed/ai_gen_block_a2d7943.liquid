{% doc %}
  @prompt
    Create a responsive highlights banner for the “Register Business Account” page, inspired by the attached reference image. Use a light gray background and a centered heading: “B2B Login Business Account Benefits”, followed by the subtitle: “Create a B2B profile with Russo to unlock these features.” Below it, show eight benefit highlights in a clean four-column grid on desktop and a stacked, mobile-friendly layout on smaller screens. Each highlight should have a simple teal outline icon, a bold title, and supporting text. Use these items: 1) Business Specific Pricing — “Log in to see your specific price.” 2) Equipment Purchase History / Asset List — “Search your serialized units on file.” 3) Payment Portal — “Pay bills online with Credit/ACH and see posted invoices. Check your sales quotes and open orders.” 4) Vaulting Credit Cards or Net Payment Terms* — “Speed up payment processes by securely storing a card on file or using Net Terms. *Approval granted after evaluation.” 5) Multiple Users — “Separate logins for the foreman, fleet manager, & service lead - all connected to one company account.” 6) Multiple Locations — “Segment purchasing based on your location/purchaser.” 7) Shipping & Delivery Agreements. 8) Dedicated Account Representative. Keep the styling polished, compact, accessible, and consistent with the Russo Power Equipment storefront. Make the heading, subtitle, benefit titles, descriptions, colors, spacing, and icons customizable in the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}.ai-b-{{ai_gen_id}}{display:block;width:100%;background:{{block.settings.bg}};padding:{{block.settings.pad}}px 20px;color:{{block.settings.text}}}.ai-b-{{ai_gen_id}}__in{width:{{block.settings.w}}%;max-width:1400px;margin:auto}.ai-b-{{ai_gen_id}} h2{text-align:center;margin:0;color:{{block.settings.head}}}.ai-b-{{ai_gen_id}}__sub{text-align:center;margin:12px auto 35px;max-width:700px}.ai-b-{{ai_gen_id}}__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.ai-b-{{ai_gen_id}} article{background:#fff;border:1px solid #d6d6d6;padding:24px}.ai-b-{{ai_gen_id}} svg{width:40px;height:40px;stroke:{{block.settings.accent}};fill:none;stroke-width:1.7}.ai-b-{{ai_gen_id}} h3{font-size:18px;margin:12px 0 8px}.ai-b-{{ai_gen_id}} p{margin:0;line-height:1.5}@media(max-width:749px){.ai-b-{{ai_gen_id}}__grid{grid-template-columns:1fr}.ai-b-{{ai_gen_id}}__in{width:100%}}{% endstyle %}<business-benefits-{{ai_gen_id}} class="ai-b-{{ai_gen_id}}" {{block.shopify_attributes}}><div class="ai-b-{{ai_gen_id}}__in"><h2>{{block.settings.heading}}</h2><p class="ai-b-{{ai_gen_id}}__sub">{{block.settings.subtitle}}</p><div class="ai-b-{{ai_gen_id}}__grid">{% for i in (1..8) %}{% assign tk='benefit_' | append: i | append: '_title' %}{% assign dk='benefit_' | append: i | append: '_text' %}<article><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><h3>{{block.settings[tk]}}</h3><p>{{block.settings[dk]}}</p></article>{% endfor %}</div></div></business-benefits-{{ai_gen_id}}>{% schema %}{"name":"Business benefits","settings":[{"type":"text","id":"heading","label":"Heading","default":"B2B Login Business Account Benefits"},{"type":"textarea","id":"subtitle","label":"Subtitle","default":"Create a B2B profile with Russo to unlock these features."},{"type":"range","id":"w","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"pad","label":"Section padding","min":20,"max":100,"step":5,"unit":"px","default":55},{"type":"color","id":"bg","label":"Background","default":"#f3f3f3"},{"type":"color","id":"head","label":"Heading","default":"#121212"},{"type":"color","id":"text","label":"Text","default":"#333333"},{"type":"color","id":"accent","label":"Icons","default":"#007f83"},{"type":"header","content":"Benefits"},{"type":"text","id":"benefit_1_title","label":"1 title","default":"Business Specific Pricing"},{"type":"textarea","id":"benefit_1_text","label":"1 description","default":"Log in to see your specific price."},{"type":"text","id":"benefit_2_title","label":"2 title","default":"Equipment Purchase History / Asset List"},{"type":"textarea","id":"benefit_2_text","label":"2 description","default":"Search your serialized units on file."},{"type":"text","id":"benefit_3_title","label":"3 title","default":"Payment Portal"},{"type":"textarea","id":"benefit_3_text","label":"3 description","default":"Pay bills online with Credit/ACH and see posted invoices. Check your sales quotes and open orders."},{"type":"text","id":"benefit_4_title","label":"4 title","default":"Vaulting Credit Cards or Net Payment Terms*"},{"type":"textarea","id":"benefit_4_text","label":"4 description","default":"Speed up payment processes by securely storing a card on file or using Net Terms. *Approval granted after evaluation."},{"type":"text","id":"benefit_5_title","label":"5 title","default":"Multiple Users"},{"type":"textarea","id":"benefit_5_text","label":"5 description","default":"Separate logins for the foreman, fleet manager, & service lead - all connected to one company account."},{"type":"text","id":"benefit_6_title","label":"6 title","default":"Multiple Locations"},{"type":"textarea","id":"benefit_6_text","label":"6 description","default":"Segment purchasing based on your location/purchaser."},{"type":"text","id":"benefit_7_title","label":"7 title","default":"Shipping & Delivery Agreements"},{"type":"textarea","id":"benefit_7_text","label":"7 description","default":"Coordinate delivery preferences and agreements for your business."},{"type":"text","id":"benefit_8_title","label":"8 title","default":"Dedicated Account Representative"},{"type":"textarea","id":"benefit_8_text","label":"8 description","default":"Get knowledgeable support from a dedicated Russo account representative."}],"presets":[{"name":"Business benefits"}],"tag":null,"class":"business-benefits-block"}{% endschema %}