{% doc %}
  @prompt
    Create a responsive collection tile grid for the Power Equipment collection page that recreates the category tiles from the Empire theme. Each tile should be configurable with an image, heading, and collection or page link. Show the heading clearly on or below the image, use a clean equipment-retailer style, keep tile heights consistent, and support adjustable columns on desktop and mobile. Include controls for section heading, spacing, image shape, and color scheme. Make the tiles easy to add, remove, and reorder in the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-category-grid__inner-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-category-grid__heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-weight: 600;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-category-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-category-grid__tile-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    background: {{ block.settings.tile_background }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    text-decoration: none;
    color: {{ block.settings.tile_text_color }};
  }

  .ai-category-grid__media-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    background: #e9ecef;
  }

  .ai-category-grid__media-{{ ai_gen_id }} img,
  .ai-category-grid__media-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-grid__media-{{ ai_gen_id }} svg { color: #69727d; }

  .ai-category-grid__label-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.label_alignment }};
    flex: 1;
    min-height: 64px;
    padding: 16px;
    text-align: {{ block.settings.label_alignment }};
    font-family: {{ block.settings.body_font.family }};
    font-size: {{ block.settings.label_size }}px;
    font-weight: 600;
    line-height: 1.25;
  }

  @media screen and (max-width: 749px) {
    .ai-category-grid__inner-{{ ai_gen_id }} { width: 100%; padding: 0 16px; }
    .ai-category-grid__grid-{{ ai_gen_id }} { grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr)); }
    .ai-category-grid__heading-{{ ai_gen_id }} { font-size: {{ block.settings.mobile_heading_size }}px; }
  }
{% endstyle %}

<div class="ai-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-grid__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-category-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    <div class="ai-category-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign enabled_key = 'tile_' | append: i | append: '_enabled'
          assign image_key = 'tile_' | append: i | append: '_image'
          assign heading_key = 'tile_' | append: i | append: '_heading'
          assign link_key = 'tile_' | append: i | append: '_link'
          assign enabled = block.settings[enabled_key]
          assign image = block.settings[image_key]
          assign tile_heading = block.settings[heading_key]
          assign tile_link = block.settings[link_key]
        %}
        {% if enabled and tile_heading != blank %}
          <a class="ai-category-grid__tile-{{ ai_gen_id }}" href="{{ tile_link | default: '#' }}">
            <div class="ai-category-grid__media-{{ ai_gen_id }}">
              {% if image %}
                <img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | default: tile_heading | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <div class="ai-category-grid__label-{{ ai_gen_id }}">{{ tile_heading | escape }}</div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Equipment category grid",
  "settings": [
    { "type": "header", "content": "Grid content" },
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Power equipment" },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"}], "default": "left" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "desktop_columns", "label": "Desktop columns", "options": [{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"},{"value":"6","label":"6"}], "default": "4" },
    { "type": "select", "id": "mobile_columns", "label": "Mobile columns", "options": [{"value":"1","label":"1"},{"value":"2","label":"2"}], "default": "2" },
    { "type": "range", "id": "gap", "label": "Tile gap", "min": 4, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "options": [{"value":"1 / 1","label":"Square"},{"value":"4 / 3","label":"Landscape"},{"value":"3 / 4","label":"Portrait"}], "default": "4 / 3" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "heading_spacing", "label": "Heading spacing", "min": 8, "max": 48, "step": 4, "unit": "px", "default": 20 },
    { "type": "header", "content": "Colors and type" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Heading", "default": "#121212" },
    { "type": "color", "id": "tile_background", "label": "Tile background", "default": "#f3f3f3" },
    { "type": "color", "id": "tile_text_color", "label": "Tile text", "default": "#121212" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#d9d9d9" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "roboto_n6" },
    { "type": "font_picker", "id": "body_font", "label": "Tile font", "default": "roboto_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 16, "max": 36, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "label_size", "label": "Tile text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "label_alignment", "label": "Tile text alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"}], "default": "left" },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Tile 1" },
    { "type": "checkbox", "id": "tile_1_enabled", "label": "Show tile 1", "default": true },
    { "type": "image_picker", "id": "tile_1_image", "label": "Image" },
    { "type": "text", "id": "tile_1_heading", "label": "Heading", "default": "Lawn mowers" },
    { "type": "url", "id": "tile_1_link", "label": "Collection or page link" },
    { "type": "header", "content": "Tile 2" },
    { "type": "checkbox", "id": "tile_2_enabled", "label": "Show tile 2", "default": true },
    { "type": "image_picker", "id": "tile_2_image", "label": "Image" },
    { "type": "text", "id": "tile_2_heading", "label": "Heading", "default": "Trimmers" },
    { "type": "url", "id": "tile_2_link", "label": "Collection or page link" },
    { "type": "header", "content": "Tile 3" },
    { "type": "checkbox", "id": "tile_3_enabled", "label": "Show tile 3", "default": true },
    { "type": "image_picker", "id": "tile_3_image", "label": "Image" },
    { "type": "text", "id": "tile_3_heading", "label": "Heading", "default": "Blowers" },
    { "type": "url", "id": "tile_3_link", "label": "Collection or page link" },
    { "type": "header", "content": "Tile 4" },
    { "type": "checkbox", "id": "tile_4_enabled", "label": "Show tile 4", "default": true },
    { "type": "image_picker", "id": "tile_4_image", "label": "Image" },
    { "type": "text", "id": "tile_4_heading", "label": "Heading", "default": "Chainsaws" },
    { "type": "url", "id": "tile_4_link", "label": "Collection or page link" },
    { "type": "header", "content": "Tile 5" },
    { "type": "checkbox", "id": "tile_5_enabled", "label": "Show tile 5", "default": false },
    { "type": "image_picker", "id": "tile_5_image", "label": "Image" },
    { "type": "text", "id": "tile_5_heading", "label": "Heading", "default": "Edgers" },
    { "type": "url", "id": "tile_5_link", "label": "Collection or page link" },
    { "type": "header", "content": "Tile 6" },
    { "type": "checkbox", "id": "tile_6_enabled", "label": "Show tile 6", "default": false },
    { "type": "image_picker", "id": "tile_6_image", "label": "Image" },
    { "type": "text", "id": "tile_6_heading", "label": "Heading", "default": "Snow equipment" },
    { "type": "url", "id": "tile_6_link", "label": "Collection or page link" }
  ],
  "presets": [{ "name": "Equipment category grid" }],
  "tag": null,
  "class": "equipment-category-grid-block"
}
{% endschema %}