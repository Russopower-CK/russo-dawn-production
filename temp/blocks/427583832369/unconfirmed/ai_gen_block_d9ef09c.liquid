{% doc %}
  @prompt
    sub-collection grid like our empire theme
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-subcollection-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
    font-weight: 700;
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__intro {
    margin: 8px 0 0;
    color: {{ block.settings.muted_text_color }};
    font-size: 15px;
    line-height: 1.5;
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.card_background }};
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    text-decoration: none;
    box-shadow: 0 3px 10px rgba(18, 18, 18, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: {{ block.settings.image_background }};
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__media img,
  .ai-subcollection-grid-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 68px;
    padding: 16px;
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__name {
    margin: 0;
    font-size: {{ block.settings.card_title_size }}px;
    line-height: 1.25;
    font-weight: 700;
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__arrow {
    flex: 0 0 auto;
    color: {{ block.settings.accent_color }};
    font-size: 22px;
    line-height: 1;
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__card:hover .ai-subcollection-grid-{{ ai_gen_id }}__arrow,
  .ai-subcollection-grid-{{ ai_gen_id }}__card:focus-visible .ai-subcollection-grid-{{ ai_gen_id }}__arrow {
    transform: translateX(3px);
  }

  .ai-subcollection-grid-{{ ai_gen_id }}__empty {
    padding: 28px;
    color: {{ block.settings.muted_text_color }};
    background: {{ block.settings.image_background }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-subcollection-grid-{{ ai_gen_id }}__header {
      display: block;
    }

    .ai-subcollection-grid-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr));
    }

    .ai-subcollection-grid-{{ ai_gen_id }}__content {
      padding: 12px;
    }

    .ai-subcollection-grid-{{ ai_gen_id }}__name {
      font-size: 15px;
    }
  }
{% endstyle %}

<div class="ai-subcollection-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="ai-subcollection-grid-{{ ai_gen_id }}__header">
      <div>
        {% if block.settings.heading != blank %}
          <h2 class="ai-subcollection-grid-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <p class="ai-subcollection-grid-{{ ai_gen_id }}__intro">{{ block.settings.description | escape }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if block.settings.collections != blank %}
    <div class="ai-subcollection-grid-{{ ai_gen_id }}__grid">
      {% for collection in block.settings.collections %}
        <a class="ai-subcollection-grid-{{ ai_gen_id }}__card" href="{{ collection.url }}">
          <div class="ai-subcollection-grid-{{ ai_gen_id }}__media">
            {% if collection.featured_image %}
              <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="800" height="800">
            {% else %}
              {{ 'collection-apparel-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
          <div class="ai-subcollection-grid-{{ ai_gen_id }}__content">
            <h3 class="ai-subcollection-grid-{{ ai_gen_id }}__name">{{ collection.title | escape }}</h3>
            <span class="ai-subcollection-grid-{{ ai_gen_id }}__arrow" aria-hidden="true">→</span>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-subcollection-grid-{{ ai_gen_id }}__empty">Select sub-collections to display in this grid.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Sub-collection grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Find the equipment, parts, and supplies for the job."
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Sub-collections",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#be1e2d"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#dddddd"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 14,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 30,
      "step": 5,
      "unit": "%",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Sub-collection grid"
    }
  ],
  "tag": null,
  "class": "subcollection-grid-block"
}
{% endschema %}