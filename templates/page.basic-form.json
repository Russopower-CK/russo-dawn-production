      "settings": {
        "custom_liquid": "<script>\n(() => {\n  const PREFIX = '[Forms → Klaviyo]';\n\n  // Prevent duplicate listeners on the same page.\n  if (window.__russoFormsKlaviyoAll) return;\n  window.__russoFormsKlaviyoAll = true;\n\n  const attachedRoots = new WeakSet();\n\n  console.log(PREFIX, 'Listener loaded. Watching for forms.');\n\n  function attach(embed) {\n    const root = embed.shadowRoot;\n    if (!root || attachedRoots.has(root)) return;\n\n    attachedRoots.add(root);\n\n    const container = embed.closest('[data-forms-id]');\n    const label = container?.getAttribute('data-forms-id') || 'Shopify form';\n\n    let email = '';\n    let handled = false;\n    let wasSuccessful = Boolean(\n      root.querySelector('[data-current-step=\"success\"]')\n    );\n\n    function captureEmail() {\n      if (handled || wasSuccessful) return;\n\n      const input = root.querySelector(\n        'input[type=\"email\"], input[name=\"email\"], input#email'\n      );\n\n      if (input) {\n        email = input.value.trim();\n      }\n    }\n\n    function checkSuccess() {\n      const successful = Boolean(\n        root.querySelector('[data-current-step=\"success\"]')\n      );\n\n      // Allow another submission if the form returns to its input state.\n      if (!successful) {\n        if (wasSuccessful) {\n          handled = false;\n          email = '';\n        }\n\n        wasSuccessful = false;\n        captureEmail();\n        return;\n      }\n\n      // Only react to a new success, not an existing success screen.\n      if (wasSuccessful || handled) return;\n\n      wasSuccessful = true;\n      handled = true;\n\n      console.log(PREFIX, label, 'Success detected.');\n\n      const submittedEmail = email;\n      email = '';\n\n      if (!submittedEmail) {\n        console.warn(\n          PREFIX,\n          label,\n          'No email captured. Identification skipped.'\n        );\n        return;\n      }\n\n      if (typeof window.klaviyo?.identify !== 'function') {\n        console.warn(\n          PREFIX,\n          label,\n          'Klaviyo identify is unavailable. Check loading and consent settings.'\n        );\n        return;\n      }\n\n      console.log(PREFIX, label, 'Calling Klaviyo identify.');\n\n      try {\n        const result = window.klaviyo.identify(\n          { email: submittedEmail },\n          () => {\n            console.log(PREFIX, label, 'Identify completed.');\n          }\n        );\n\n        if (result && typeof result.catch === 'function') {\n          result.catch(error => {\n            console.error(PREFIX, label, 'Identify failed:', error);\n          });\n        }\n      } catch (error) {\n        console.error(PREFIX, label, 'Identify failed:', error);\n      }\n    }\n\n    root.addEventListener('input', captureEmail, true);\n    root.addEventListener('change', captureEmail, true);\n    root.addEventListener('submit', captureEmail, true);\n\n    const observer = new MutationObserver(checkSuccess);\n\n    observer.observe(root, {\n      subtree: true,\n      childList: true,\n      attributes: true,\n      attributeFilter: ['data-current-step']\n    });\n\n    captureEmail();\n\n    console.log(PREFIX, 'Attached to', label);\n  }\n\n  function discover() {\n    document.querySelectorAll('shopify-forms-embed').forEach(attach);\n  }\n\n  // Discover forms added to the page later.\n  const discoveryObserver = new MutationObserver(discover);\n\n  discoveryObserver.observe(document.documentElement, {\n    childList: true,\n    subtree: true\n  });\n\n  // Also catches shadow roots attached after their host was inserted.\n  const discoveryTimer = setInterval(discover, 1000);\n\n  window.addEventListener('pagehide', () => {\n    clearInterval(discoveryTimer);\n    discoveryObserver.disconnect();\n  }, { once: true });\n\n  discover();\n})();\n</script>",
