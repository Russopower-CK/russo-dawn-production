        "custom_liquid": "<script>\n(() => {\n  const FORM_ID = '177827';\n  const PREFIX = '[Forms → Klaviyo]';\n  const containerSelector = `[data-forms-id=\"forms-root-${FORM_ID}\"]`;\n  const attachedRoots = new WeakSet();\n\n  // Prevent duplicate listeners if this snippet runs more than once.\n  const guard = `__russoFormsKlaviyo_${FORM_ID}`;\n  if (window[guard]) return;\n  window[guard] = true;\n\n  console.log(PREFIX, 'Listener loaded. Waiting for form.');\n\n  function attach() {\n    const container = document.querySelector(containerSelector);\n    if (!container) return false;\n\n    const embed = container.matches('shopify-forms-embed')\n      ? container\n      : container.querySelector('shopify-forms-embed');\n\n    const root = embed?.shadowRoot;\n    if (!root) return false;\n    if (attachedRoots.has(root)) return true;\n\n    attachedRoots.add(root);\n\n    let email = '';\n    let handled = false;\n\n    function captureEmail() {\n      if (handled) return;\n\n      const input = root.querySelector(\n        'input[type=\"email\"], input[name=\"email\"], input#email'\n      );\n\n      // Keep the captured value when success removes the input.\n      if (input) {\n        email = input.value.trim();\n      }\n    }\n\n    function checkSuccess() {\n      if (handled) return;\n\n      const success = root.querySelector(\n        '[data-current-step=\"success\"]'\n      );\n\n      if (!success) return;\n\n      handled = true;\n      console.log(PREFIX, 'Form success detected.');\n\n      if (!email) {\n        console.warn(\n          PREFIX,\n          'No email captured. Reload and submit a fresh test entry.'\n        );\n        return;\n      }\n\n      if (typeof window.klaviyo?.identify !== 'function') {\n        console.warn(\n          PREFIX,\n          'Klaviyo identify is unavailable. Check Klaviyo loading and consent settings, then reload and test again.'\n        );\n        return;\n      }\n\n      console.log(PREFIX, 'Calling Klaviyo identify.');\n\n      try {\n        const result = window.klaviyo.identify(\n          { email },\n          () => {\n            console.log(PREFIX, 'Identify completed.');\n          }\n        );\n\n        // Catch rejected promises without assuming a promise is returned.\n        if (result && typeof result.catch === 'function') {\n          result.catch(error => {\n            console.error(PREFIX, 'Identify failed:', error);\n          });\n        }\n      } catch (error) {\n        console.error(PREFIX, 'Identify failed:', error);\n      } finally {\n        email = '';\n      }\n    }\n\n    root.addEventListener('input', captureEmail, true);\n    root.addEventListener('change', captureEmail, true);\n    root.addEventListener('submit', captureEmail, true);\n\n    const successObserver = new MutationObserver(() => {\n      captureEmail();\n      checkSuccess();\n    });\n\n    successObserver.observe(root, {\n      subtree: true,\n      childList: true,\n      attributes: true,\n      attributeFilter: ['data-current-step']\n    });\n\n    console.log(PREFIX, `Attached to form ${FORM_ID}.`);\n\n    captureEmail();\n    checkSuccess();\n\n    return true;\n  }\n\n  // Poll briefly because the form and its shadow root load asynchronously.\n  if (!attach()) {\n    const timer = setInterval(() => {\n      if (attach()) {\n        clearInterval(timer);\n      }\n    }, 500);\n\n    setTimeout(() => {\n      clearInterval(timer);\n\n      if (!attach()) {\n        console.warn(\n          PREFIX,\n          `Form ${FORM_ID} was not found within 60 seconds.`\n        );\n      }\n    }, 60000);\n  }\n})();\n</script>",
